---
// /dimensionar/ — landing para el enlace en bio: hero compacto oscuro → <Dimensionador /> (light) → cierre oscuro (Otros servicios + Cta).
// Ritmo de tema: dark → light → dark. Un solo h1. La escena hace todo el trabajo (src/scripts/dimensionar.js).
import Base from '../layouts/Base.astro';
import Dimensionador from '../components/pages/Dimensionador.astro';
import OtrosServicios from '../components/pages/OtrosServicios.astro';
import Cta from '../components/ui/Cta.astro';
import Icon from '../components/ui/Icon.astro';
import { wa } from '../data/site.js';

// el dial decorativo del hero (lo dibuja el [data-draw] del motor): el mismo del Diagnóstico
const pt = (v: number, r: number) => { const a = ((v - 50) * 1.3 * Math.PI) / 180; return [+(300 + r * Math.sin(a)).toFixed(1), +(330 - r * Math.cos(a)).toFixed(1)]; };
const ticks = Array.from({ length: 21 }, (_, i) => { const v = i * 5; const [x1, y1] = pt(v, i % 2 ? 250 : 236); const [x2, y2] = pt(v, 262); return { x1, y1, x2, y2 }; });
const [ax, ay] = pt(0, 276), [bx, by] = pt(100, 276);
---
<Base title="Dimensiona tu respaldo" description="Marca tus equipos y las horas de corte: te mostramos inversor, baterías y un precio referencial, con el mensaje de WhatsApp listo. Sin registro.">
  <!-- corre antes del primer pintado (CLS 0): con ?via=ig, ?c= o el navegador de Instagram el hero queda en título + botón -->
  <script is:inline>
    try { if (/[?&](via=ig|c=)/.test(location.search) || /Instagram|FBAN|FBAV/.test(navigator.userAgent)) document.documentElement.classList.add('dz-compact'); } catch (e) { /* sin acceso a la URL */ }
  </script>
  <section class="dzl-hero section" data-theme="dark" aria-labelledby="dzl-title">
    <div class="dzl-hero__bg" aria-hidden="true">
      <span class="streak streak--thick" style="top: 36%; --angle: -11deg"></span>
      <span class="streak" style="top: 74%; --angle: -11deg; --streak-opacity: .5"></span>
      <svg class="dzl-hero__gauge" viewBox="0 0 600 360" data-draw>
        <path d={`M${ax} ${ay}A276 276 0 0 1 ${bx} ${by}`} class="dzl-g-arc" />
        {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="dzl-g-tick" />)}
        <line x1="300" y1="330" x2="400" y2="118" class="dzl-g-needle" />
        <circle cx="300" cy="330" r="12" class="dzl-g-cap" />
      </svg>
    </div>
    <div class="container dzl-hero__inner">
      <p class="eyebrow dzl-in">Dimensionador · 3 pasos<span class="dzl-ey2"> · unos 2 minutos</span></p>
      <h1 id="dzl-title" class="dzl-in">¿Qué quieres mantener <span class="accent">encendido</span> cuando se va la luz?</h1>
      <p class="lead dzl-in dzl-lead">Marca tus equipos y las horas de corte. Te mostramos inversor, baterías y un precio referencial, sin pedirte datos.</p>
      <div class="btn-row dzl-in dzl-cta">
        <a class="btn btn--primary" href="#dimensionar" data-magnetic="0.25"><Icon name="bolt" size={20} />Empezar</a>
        <a class="btn btn--ghost" href={wa('Hola SSD&S, quiero dimensionar un respaldo con inversor y baterías.')} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />Prefiero escribir directo</a>
      </div>
    </div>
  </section>

  <Dimensionador />

  <OtrosServicios current="respaldo-energetico" as="section" theme="dark" />
  <Cta title="¿Prefieres que lo veamos en tu casa?" text="Si lo tuyo es más grande, o prefieres que midamos la carga en sitio, escríbenos y coordinamos una visita técnica." waText="Hola SSD&S, quiero una visita técnica para dimensionar mi respaldo." label="Pedir visita por WhatsApp" />
</Base>

<style>
  .dzl-hero {
    overflow: hidden; min-height: 30.5rem; padding-top: calc(var(--header-h) + clamp(24px, 4vw, 48px)); padding-bottom: clamp(32px, 4vw, 48px);   /* ≈ su altura final: sin esto el primer pintado era de 168 px y las capas decorativas saltaban (CLS 0,16 con CPU lenta) */
    background: radial-gradient(90% 120% at 100% 0%, rgba(242, 106, 27, 0.28), transparent 55%), linear-gradient(160deg, var(--navy-800), var(--navy-950));
  }
  .dzl-hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .dzl-hero__gauge { position: absolute; right: -6%; bottom: -8%; width: min(52vw, 640px); opacity: 0.22; overflow: visible; }
  .dzl-g-arc, .dzl-g-tick, .dzl-g-needle { fill: none; stroke-linecap: round; }
  .dzl-g-arc { stroke: rgba(255, 215, 154, 0.4); stroke-width: 2; }
  .dzl-g-tick { stroke: rgba(244, 246, 251, 0.35); stroke-width: 2; }
  .dzl-g-needle { stroke: var(--orange-400); stroke-width: 4; filter: drop-shadow(0 0 8px rgba(255, 125, 51, 0.8)); }
  .dzl-g-cap { fill: var(--navy-900); stroke: var(--glow); stroke-width: 2; }
  .dzl-hero__inner { position: relative; }
  .dzl-hero h1 { font-size: clamp(1.9rem, 1rem + 3vw, 3.4rem); max-width: 20ch; line-height: 1.04; }
  .dzl-hero .lead { margin: 16px 0 24px; max-width: 54ch; }
  .dzl-hero h1 .accent { padding-right: 0.12em; }
  @media (max-width: 767px) {
    .dzl-hero__gauge { width: 120vw; right: -40%; bottom: -4%; opacity: 0.14; }
    .dzl-cta > .btn { flex: 1 1 100%; white-space: normal; }
  }

  /* entrada: solo CSS, empieza en el primer pintado (el h1 es el LCP: no espera JS, fuentes ni SplitText) */
  @media (prefers-reduced-motion: no-preference) {
    .dzl-in { animation: dzl-in 0.95s var(--ease-out) backwards; }
    .dzl-hero h1 { animation-delay: 0.1s; animation-duration: 1.1s; }
    .dzl-lead { animation-delay: 0.25s; }
    .dzl-cta { animation-delay: 0.38s; }
  }
  @keyframes dzl-in { from { opacity: 0; transform: translateY(24px); } }

  /* modo compacto (Instagram, enlace con ?c=): título + botón, ≤ 38 vh, para que los chips del paso 1 asomen en la primera pantalla */
  :global(html.dz-compact) .dzl-hero { min-height: 0; padding-top: calc(var(--header-h) + 8px); padding-bottom: 18px; }
  :global(html.dz-compact) .dzl-hero .dzl-lead, :global(html.dz-compact) .dzl-hero__gauge, :global(html.dz-compact) .dzl-cta .btn--ghost { display: none; }
  :global(html.dz-compact) .dzl-hero h1 { font-size: clamp(1.55rem, 0.9rem + 2.6vw, 3rem); }
  :global(html.dz-compact) .dzl-hero .eyebrow { margin-bottom: 8px; }
  :global(html.dz-compact) .dzl-ey2 { display: none; }
  :global(html.dz-compact) .dzl-cta { margin-top: 18px; }
  @media (max-width: 959px) { :global(html.dz-compact .dz) { padding-top: 12px; } }
</style>
