---
/*
  Service detail. Theme rhythm: hero (dark) → alcance (light) → [ATS scene, dark: respaldo only] → Instagram strip →
  proceso (+ otros) → CTA (dark). "Otros servicios" gets its own section only when needed to keep dark/light alternating.
  Hero: the service icon draws itself inside an energised panel (dial ticks light up, ring closes, LED goes live).
*/
import Base from '../../layouts/Base.astro';
import Icon from '../../components/ui/Icon.astro';
import Cta from '../../components/ui/Cta.astro';
import PageHero from '../../components/pages/PageHero.astro';
import Proceso from '../../components/pages/Proceso.astro';
import PostStrip from '../../components/pages/PostStrip.astro';
import OtrosServicios from '../../components/pages/OtrosServicios.astro';
import Transferencia from '../../components/home/Transferencia.astro';
import { services, wa } from '../../data/site.js';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props;
const icons = { 'potencia-electrica': 'transformer', 'respaldo-energetico': 'generator', climatizacion: 'snowflake' } as const;
const accents: Record<string, string> = { 'potencia-electrica': 'media y baja tensión.', 'respaldo-energetico': 'nunca se detenga.', climatizacion: 'estable y continuo.' };
const related: Record<string, string[]> = {
  'potencia-electrica': ['DdmM5JnRQUK', 'DdMYUkREepK', 'DdXQ8czuyU9'],
  'respaldo-energetico': ['DdeXN0Ckbm8', 'DdE0DxZxTWX', 'Ddt6o2VkdoJ', 'DdaPUa2RhWr', 'DdCgdr8vwtx'],
  climatizacion: ['DdwubTgvotH', 'Dc6O1Six9md'],
};
const icon = icons[s.slug as keyof typeof icons];
const ats = s.slug === 'respaldo-energetico';
const ticks = Array.from({ length: 48 }, (_, i) => i * 7.5);
const loops = Math.ceil(14 / s.tags.length); // enough tag copies for one marquee half wider than 2560px
---
<Base title={s.name} description={s.summary}>
  <PageHero id="servicio" kicker={`${s.code} · ${s.kicker}`} title={s.headline} accent={accents[s.slug]} lead={s.intro} crumbs={[{ href: '/servicios/', label: 'Servicios' }, { label: s.short }]}>
    <div slot="actions" class="btn-row phero__actions">
      <a class="btn btn--primary" href={wa(s.waText)} target="_blank" rel="noopener" data-magnetic="0.25"><Icon name="whatsapp" size={20} />{s.cta}</a>
      <a class="btn btn--ghost" href="#detalle">Ver alcance<Icon name="chevron" size={18} /></a>
    </div>

    <div slot="aside" class="sd-panel is-live is-lit" data-sd-panel data-tilt="5">
      <div class="sd-panel__bar mono" aria-hidden="true">
        <span class="sd-panel__led"></span>
        <span>Circuito {s.code}</span>
        <span class="sd-panel__state"><span class="sd-panel__off">Armando</span><span class="sd-panel__on">En línea</span></span>
      </div>
      <div class="sd-panel__core" aria-hidden="true">
        <svg class="sd-panel__dial" viewBox="0 0 200 200" focusable="false">
          <defs><linearGradient id="sd-arc-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffd79a" /><stop offset=".5" stop-color="#ff9c5c" /><stop offset="1" stop-color="#f26a1b" /></linearGradient></defs>
          <g class="sd-panel__ticks">{ticks.map((a, i) => <line x1="100" y1="6" x2="100" y2={i % 6 === 0 ? 19 : 13} transform={`rotate(${a} 100 100)`} />)}</g>
          <circle class="sd-panel__track" cx="100" cy="100" r="80" />
          <circle class="sd-panel__halo" cx="100" cy="100" r="80" />
          <circle class="sd-panel__arc" cx="100" cy="100" r="80" transform="rotate(-90 100 100)" />
        </svg>
        <span class="sd-panel__orbit"><i></i></span>
        <span class="sd-panel__icon"><Icon name={icon} size={92} stroke={1.25} /></span>
      </div>
      <p class="sd-panel__name">{s.name}</p>
      <ul class="sd-panel__tags" aria-label="Especialidades">{s.tags.map((t) => <li>{t}</li>)}</ul>
    </div>

    <div slot="bottom" class="marquee sd-marquee" data-speed="0.5" aria-hidden="true">
      <div class="marquee__track">
        {Array.from({ length: loops }, (_, k) => s.tags.map((t) => <span class="sd-marquee__item" aria-hidden={k > 0 ? 'true' : undefined}>{t}<Icon name="bolt" size={16} /></span>))}
      </div>
    </div>
  </PageHero>

  <section id="detalle" class="section sd-scope" data-theme="light" aria-labelledby="detalle-title">
    <div class="container sd-scope__grid">
      <div class="sd-scope__head">
        <p class="eyebrow" data-reveal="up">Alcance del servicio</p>
        <h2 id="detalle-title" data-split="lines">Qué hacemos en {s.short.toLowerCase()}.</h2>
        <p class="lead" data-reveal="up" data-delay=".1">{s.summary}</p>
        <a class="btn btn--text sd-scope__link" href={wa(s.waText)} target="_blank" rel="noopener" data-reveal="up" data-delay=".2">{s.cta}<Icon name="arrow" size={18} class="arrow" /></a>
      </div>
      <ol class="sd-scope__list">
        {s.items.map((it, i) => (
          <li class="sd-scope__item" data-reveal="up" data-delay={String((i % 2) * 0.08)}>
            <div class="sd-card" data-glow data-tilt="3">
              <span class="sd-card__wire" aria-hidden="true"><i></i></span>
              <span class="sd-card__n num" data-n={`0${i + 1}`} aria-hidden="true">0{i + 1}</span>
              <div class="sd-card__body">
                <h3>{it.t}</h3>
                <p>{it.d}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {ats && <Transferencia mode="static" />}

  <PostStrip id="publicaciones" codes={related[s.slug] ?? []} theme={ats ? 'light' : 'dark'} title={`Lo que contamos sobre ${s.short.toLowerCase()}.`} />

  <section id="proceso" class="section sd-proc" data-theme={ats ? 'dark' : 'light'} aria-labelledby="proceso-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow" data-reveal="up">Proceso</p>
        <h2 id="proceso-title" data-split="lines">Todo el ciclo, con un solo equipo.</h2>
      </div>
      <Proceso />
      {!ats && <OtrosServicios current={s.slug} />}
    </div>
  </section>

  {ats && <OtrosServicios current={s.slug} as="section" theme="light" />}

  <Cta title={s.headline} text={s.intro} waText={s.waText} label={s.cta} />
</Base>

<style>
  .sd-proc .section__head { max-width: none; }
  .sd-proc .section__head h2 { font-size: var(--step-3); max-width: 20ch; }

  /* ---------- hero panel ---------- */
  @media (prefers-reduced-motion: no-preference) { :global(.js) .sd-panel { opacity: 0; } } /* JS powers it up (see script) */
  .sd-panel {
    position: relative; width: min(100%, 440px); justify-self: center; display: grid; gap: 18px; padding: 18px 20px 22px;
    border-radius: var(--radius-lg); border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.015) 60%), rgba(6, 13, 31, 0.88);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  /* four panel screws */
  .sd-panel::before, .sd-panel::after { content: ''; position: absolute; width: 8px; height: 8px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #d7deea, #6b7894); box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.25); }
  .sd-panel::before { left: 12px; bottom: 12px; }
  .sd-panel::after { right: 12px; bottom: 12px; }
  .sd-panel__bar { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px dashed rgba(255, 255, 255, 0.14); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .sd-panel__led { width: 10px; height: 10px; border-radius: 50%; background: #3a2a24; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15); transition: background-color 0.3s, box-shadow 0.5s; }
  .sd-panel__state { position: relative; margin-left: auto; display: grid; }
  .sd-panel__state > span { grid-area: 1 / 1; text-align: right; transition: opacity 0.4s, transform 0.5s var(--ease-out); }
  .sd-panel__off { color: var(--amber-400); }
  .sd-panel__on { color: var(--ok); opacity: 0; transform: translateY(6px); }
  .sd-panel.is-live .sd-panel__led { background: var(--ok); box-shadow: 0 0 0 3px rgba(61, 220, 132, 0.18), 0 0 14px rgba(61, 220, 132, 0.9); animation: sd-hum 2.4s ease-in-out infinite; }
  .sd-panel.is-live .sd-panel__off { opacity: 0; transform: translateY(-6px); }
  .sd-panel.is-live .sd-panel__on { opacity: 1; transform: none; }
  @keyframes sd-hum { 50% { opacity: 0.55; } }

  .sd-panel__core { position: relative; width: min(100%, 300px); aspect-ratio: 1; margin-inline: auto; display: grid; place-items: center; }
  .sd-panel__dial { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .sd-panel__ticks line { stroke: rgba(255, 255, 255, 0.35); stroke-width: 1.5; stroke-linecap: round; }
  .sd-panel__ticks line:nth-child(6n + 1) { stroke: var(--orange-400); stroke-width: 2; }
  .sd-panel__track { fill: none; stroke: rgba(255, 255, 255, 0.08); stroke-width: 6; }
  /* the drawn arc is never filtered (DrawSVG would re-rasterise the glow every frame); a static filtered copy under it
     lights up once the circuit is live */
  .sd-panel__arc, .sd-panel__halo { fill: none; stroke: url(#sd-arc-g); stroke-width: 6; stroke-linecap: round; }
  .sd-panel__halo { opacity: 0; filter: drop-shadow(0 0 6px rgba(255, 140, 60, 0.7)); transition: opacity 0.5s; }
  .sd-panel.is-live .sd-panel__halo { opacity: 1; }
  :global(html.is-desktop-fx) .sd-panel__dial { will-change: transform; } /* turned by the pointer: composited */
  .sd-panel__orbit { position: absolute; inset: 10%; border-radius: 50%; opacity: 0; transition: opacity 0.8s; }
  .sd-panel__orbit i { position: absolute; left: 50%; top: 0; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px #ffd79a, 0 0 22px rgba(255, 125, 51, 0.95); }
  .sd-panel.is-live .sd-panel__orbit { opacity: 1; animation: sd-orbit 7s linear infinite; }
  @keyframes sd-orbit { to { transform: rotate(360deg); } }
  .sd-panel__icon { position: relative; display: grid; place-items: center; width: 48%; aspect-ratio: 1; border-radius: 50%; color: var(--glow); background: radial-gradient(circle, rgba(242, 106, 27, 0.28), rgba(242, 106, 27, 0) 70%); }
  .sd-panel__icon :global(svg) { width: 72%; height: auto; }
  .sd-panel.is-lit .sd-panel__icon :global(svg) { filter: drop-shadow(0 0 10px rgba(255, 150, 70, 0.5)); } /* once the icon has drawn */
  .sd-panel__name { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); line-height: 1.15; letter-spacing: -0.02em; text-align: center; }
  .sd-panel__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .sd-panel__tags li { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.14); color: var(--muted); }
  @media (max-width: 959px) {
    .sd-panel { grid-template-columns: 132px minmax(0, 1fr); align-items: center; width: 100%; max-width: 560px; justify-self: start; gap: 14px 18px; }
    .sd-panel__bar { grid-column: 1 / -1; }
    .sd-panel__core { grid-row: 2 / span 2; width: 132px; }
    .sd-panel__name, .sd-panel__tags { text-align: left; justify-content: flex-start; }
    .sd-panel__name { align-self: end; }
    .sd-panel__tags { align-self: start; }
    .sd-panel__track, .sd-panel__arc, .sd-panel__halo { stroke-width: 8; }
  }
  @media (max-width: 380px) {
    .sd-panel { grid-template-columns: 104px minmax(0, 1fr); padding: 16px; }
    .sd-panel__core { width: 104px; }
    .sd-panel__tags li:nth-child(n + 4) { display: none; }
  }

  /* tag marquee at the foot of the hero */
  .sd-marquee { margin-top: clamp(48px, 7vh, 88px); border-block: 1px solid rgba(255, 255, 255, 0.08); background: rgba(6, 13, 31, 0.5); padding-block: 14px; }
  .sd-marquee__item { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--font-display); font-weight: 600; font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem); letter-spacing: -0.01em; white-space: nowrap; color: rgba(255, 255, 255, 0.72); }
  .sd-marquee__item :global(svg) { color: var(--orange-400); }
  .sd-marquee__item:nth-child(3n + 2) { color: transparent; -webkit-text-stroke: 1px rgba(255, 255, 255, 0.5); }

  /* ---------- alcance ---------- */
  .sd-scope__grid { display: grid; gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (min-width: 1024px) {
    .sd-scope__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .sd-scope__head { position: sticky; top: calc(var(--header-h) + 32px); }
  }
  .sd-scope__head h2 { font-size: var(--step-3); max-width: 16ch; }
  .sd-scope__head .lead { margin-top: 18px; }
  .sd-scope__link { margin-top: 18px; gap: 8px; white-space: normal; text-align: left; font-weight: 600; }
  .sd-scope__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 640px) and (max-width: 1023px) { .sd-scope__list { grid-template-columns: 1fr 1fr; } }
  .sd-scope__item { display: grid; } /* reveal lives on the item, tilt on the card: they never write the same transform */
  .sd-card {
    position: relative; overflow: hidden; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 22px; align-items: start;
    padding: clamp(22px, 2.6vw, 32px); border-radius: var(--radius-lg); background: var(--card); border: 1px solid var(--line);
    box-shadow: 0 18px 40px -30px rgba(11, 26, 58, 0.4); transition: border-color 0.4s, box-shadow 0.6s var(--ease-out);
  }
  .sd-card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); box-shadow: 0 26px 50px -28px rgba(242, 106, 27, 0.45); }
  @media (min-width: 640px) and (max-width: 1023px) { .sd-card { grid-template-columns: 1fr; } }
  .sd-card__wire { position: absolute; left: 0; right: 0; top: 0; height: 3px; overflow: hidden; background: color-mix(in srgb, var(--fg) 6%, transparent); }
  .sd-card__wire::before { content: ''; position: absolute; inset: 0; background: var(--grad-ink); transform: scaleX(0); transform-origin: 0 50%; transition: transform 1.3s var(--ease-out) 0.2s; }
  .sd-card__wire i { position: absolute; top: 0; left: 0; width: 22%; height: 100%; background: linear-gradient(90deg, transparent, #ffd79a, transparent); opacity: 0; }
  .is-inview > .sd-card .sd-card__wire::before { transform: scaleX(1); }
  .is-inview > .sd-card .sd-card__wire i { animation: sd-run 3.6s cubic-bezier(0.5, 0, 0.5, 1) 1.4s infinite; }
  @keyframes sd-run { 0% { transform: translateX(-100%); opacity: 0; } 10%, 60% { opacity: 1; } 75%, 100% { transform: translateX(460%); opacity: 0; } }
  .sd-card__n { position: relative; font-size: clamp(2.4rem, 1.8rem + 2vw, 3.6rem); font-weight: 800; line-height: 0.9; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1.2px color-mix(in srgb, var(--fg) 30%, transparent); }
  .sd-card__n::after { content: attr(data-n); position: absolute; inset: 0; -webkit-text-stroke: 0; background: var(--grad-ink); -webkit-background-clip: text; background-clip: text; color: transparent; clip-path: inset(0 100% 0 0); transition: clip-path 1.1s var(--ease-out) 0.45s; }
  .is-inview > .sd-card .sd-card__n::after { clip-path: inset(0 0 0 0); }
  .sd-card h3 { font-size: var(--step-1); letter-spacing: -0.02em; margin: 4px 0 8px; }
  .sd-card p { color: var(--muted); }
  :global(html:not(.js)) .sd-card__wire::before { transform: none; }
  :global(html:not(.js)) .sd-card__n::after { clip-path: none; }
  @media (prefers-reduced-motion: reduce) {
    .sd-card__wire::before { transform: none; }
    .sd-card__n::after { clip-path: none; }
    .sd-panel.is-live .sd-panel__orbit, .sd-panel.is-live .sd-panel__led { animation: none; }
  }
</style>

<script>
  import { onPage } from '../../scripts/engine.js';
  onPage(({ gsap, env, onRefresh }) => {
    const panel = document.querySelector<HTMLElement>('[data-sd-panel]');
    if (!panel) return;
    // markup ships the final (live) state for no-JS / reduced motion; the power-up replays it
    if (env.reduced) return;
    const live = () => panel.classList.add('is-live');
    panel.classList.remove('is-live', 'is-lit');

    // power-up: panel opens, dial ticks light round, the ring closes, the icon draws itself, the LED goes live
    const ticks = panel.querySelectorAll('.sd-panel__ticks line');
    const icon = panel.querySelectorAll('.sd-panel__icon path, .sd-panel__icon circle, .sd-panel__icon rect, .sd-panel__icon line');
    const tl = gsap.timeline({ delay: env.desktop ? 0.25 : 0, scrollTrigger: env.desktop ? undefined : { trigger: panel, start: 'top 88%', once: true } });
    tl.fromTo(panel, { clipPath: 'inset(46% 0% 46% 0% round 24px)', opacity: 0 }, { clipPath: 'inset(0% 0% 0% 0% round 24px)', opacity: 1, duration: 0.9, ease: 'expo.inOut', clearProps: 'clipPath' })
      .from(ticks, { opacity: 0, duration: 0.05, stagger: 0.01 }, 0.5)
      .fromTo(panel.querySelector('.sd-panel__arc'), { drawSVG: '0%' }, { drawSVG: '100%', duration: 1, ease: 'power2.inOut' }, 0.5)
      .fromTo(icon, { drawSVG: '0%' }, { drawSVG: '100%', duration: 1, ease: 'power2.inOut', stagger: 0.06 }, 0.65)
      .from(panel.querySelectorAll('.sd-panel__name, .sd-panel__tags li'), { y: 14, opacity: 0, duration: 0.6, ease: 'expo.out', stagger: 0.05 }, 0.7)
      .add(live, 1.45) // ring closed: LED live, the static halo under the arc fades in
      .add(() => panel.classList.add('is-lit')); // icon drawn: its glow filter switches on (painted once, never while drawing)

    if (!env.desktop) return;
    // the dial leans toward the pointer like a selector knob
    const dial = panel.querySelector<SVGElement>('.sd-panel__dial')!;
    const hero = panel.closest('section') as HTMLElement;
    const turn = gsap.quickTo(dial, 'rotation', { duration: 1.2, ease: 'power3.out' });
    let cx = 0; // panel centre, measured on refresh: no layout read per pointer event
    const measure = () => { const r = panel.getBoundingClientRect(); cx = r.left + r.width / 2; };
    measure();
    onRefresh(measure);
    const move = (e: PointerEvent) => turn(gsap.utils.clamp(-28, 28, (e.clientX - cx) * 0.05));
    const reset = () => turn(0);
    hero.addEventListener('pointermove', move);
    hero.addEventListener('pointerleave', reset);
    return () => { hero.removeEventListener('pointermove', move); hero.removeEventListener('pointerleave', reset); };
  });
</script>
