---
/*
  Services index. Theme rhythm: hero (dark) → El Tablero, static (light) → the three lines in detail (dark) →
  proceso (light) → CTA (dark).
  Hero foot: a one-line diagram — the busbar feeds three breakers, each one a link to its service page; current
  pulses run along the bar and down every drop. Lines: big rows with a floating post preview that follows the
  pointer (desktop), numbers that fill as each row crosses the middle of the screen.
*/
import Base from '../../layouts/Base.astro';
import Icon from '../../components/ui/Icon.astro';
import Cta from '../../components/ui/Cta.astro';
import PageHero from '../../components/pages/PageHero.astro';
import Proceso from '../../components/pages/Proceso.astro';
import Tablero from '../../components/home/Tablero.astro';
import { services } from '../../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icons = { 'potencia-electrica': 'transformer', 'respaldo-energetico': 'generator', climatizacion: 'snowflake' } as const;
const previews: Record<string, string> = { 'potencia-electrica': 'DdmM5JnRQUK', 'respaldo-energetico': 'DdeXN0Ckbm8', climatizacion: 'DdwubTgvotH' };
---
<Base title="Servicios" description="Servicios eléctricos de potencia en media y baja tensión, respaldo energético con plantas eléctricas y tableros ATS, y climatización industrial y comercial.">
  <PageHero id="servicios" kicker="Servicios · SSD&S" title="Soluciones dinámicas en electricidad y potencia." accent="electricidad y potencia." lead="Acompañamos al sector comercial e industrial con un portafolio especializado. Rigor técnico, respuesta oportuna y máxima seguridad en cada proyecto." crumbs={[{ label: 'Servicios' }]}>
    <nav slot="bottom" class="container sv-bus" aria-label="Líneas de servicio" data-sv-bus>
      <p class="sv-bus__src mono" aria-hidden="true"><span class="sv-bus__led"></span>Tablero principal · 3 circuitos</p>
      <div class="sv-bus__grid">
        <span class="sv-bus__rail" aria-hidden="true"><i></i></span>
        <ol class="sv-bus__list">
          {services.map((s, i) => (
            <li class="sv-bus__item" style={`--i:${i}`}>
              <span class="sv-bus__drop" aria-hidden="true">
                <i></i>
                <svg class="sv-bus__brk" viewBox="0 0 24 24" focusable="false"><path d="M12 1v7M12 23v-7M12 16 18 8.5" /><path d="m10.5 6.5 3 3m0-3-3 3" /></svg>
              </span>
              <a class="sv-bus__card" href={`${base}/servicios/${s.slug}/`}>
                <span class="sv-bus__icon" aria-hidden="true"><Icon name={icons[s.slug as keyof typeof icons]} size={26} stroke={1.6} /></span>
                <span class="sv-bus__txt">
                  <span class="sv-bus__code mono">{s.code} · {s.kicker}</span>
                  <span class="sv-bus__name">{s.short}</span>
                </span>
                <span class="sv-bus__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  </PageHero>

  <Tablero mode="static" />

  <section id="lineas" class="section sv-lines" data-theme="dark" aria-labelledby="lineas-title" data-sv-lines>
    <div class="container">
      <div class="sv-lines__head">
        <p class="eyebrow" data-reveal="up">Tres líneas de servicio</p>
        <h2 id="lineas-title" data-split="lines">Un portafolio para mantener tu empresa en movimiento.</h2>
      </div>
      <ol class="sv-lines__list">
        {services.map((s) => (
          <li class="sv-row" data-slug={s.slug}>
            <a class="sv-row__link" href={`${base}/servicios/${s.slug}/`}>
              <span class="sv-row__n num" data-n={s.code} aria-hidden="true">{s.code}</span>
              <span class="sv-row__icon" data-draw aria-hidden="true"><Icon name={icons[s.slug as keyof typeof icons]} size={34} stroke={1.5} /></span>
              <span class="sv-row__body">
                <span class="sv-row__kicker mono">{s.kicker}</span>
                <h3 class="sv-row__title">{s.name}</h3>
                <span class="sv-row__summary">{s.summary}</span>
                <span class="sv-row__tags">{s.tags.map((t) => <span>{t}</span>)}</span>
              </span>
              <span class="sv-row__arrow" aria-hidden="true"><Icon name="arrow" size={22} /></span>
              <span class="sv-row__wire" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <div class="sv-float" aria-hidden="true">
      {services.map((s) => <img src={`${base}/ig/${previews[s.slug]}.webp`} data-slug={s.slug} width="640" height="811" alt="" loading="lazy" decoding="async" />)}
    </div>
  </section>

  <section id="proceso" class="section sv-process" data-theme="light" aria-labelledby="proceso-title">
    <div class="container">
      <div class="sv-process__head">
        <p class="eyebrow" data-reveal="up">Cómo trabajamos</p>
        <h2 id="proceso-title" data-split="lines">De la evaluación inicial al mantenimiento.</h2>
      </div>
      <Proceso />
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* ---------- hero: one-line diagram ---------- */
  .sv-bus { position: relative; margin-top: clamp(40px, 7vh, 80px); }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .sv-bus { opacity: 0; } } /* revealed by the energising timeline */
  .sv-bus__src { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 14px; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .sv-bus__led { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 10px rgba(61, 220, 132, 0.9); animation: sv-blink 2.4s ease-in-out infinite; }
  @keyframes sv-blink { 50% { opacity: 0.45; } }
  .sv-bus__grid { position: relative; padding-top: 64px; }
  .sv-bus__rail { position: absolute; left: 0; right: 0; top: 0; height: 3px; border-radius: 3px; overflow: hidden; background: linear-gradient(90deg, #f26a1b, #ff9c5c 50%, #ffd79a); box-shadow: 0 0 14px rgba(255, 140, 60, 0.6); transform-origin: 0 50%; }
  .sv-bus__rail i, .sv-bus__drop i { position: absolute; border-radius: inherit; background: linear-gradient(90deg, transparent, #fff, transparent); will-change: transform; }
  .sv-bus__rail i { top: 0; left: 0; width: 14%; height: 100%; animation: sv-run-x 3.2s cubic-bezier(0.45, 0, 0.55, 1) 1.2s infinite; transform: translateX(-100%); }
  @keyframes sv-run-x { to { transform: translateX(720%); } }
  .sv-bus__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 760px) { .sv-bus__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 2vw, 24px); } }
  .sv-bus__item { position: relative; display: flex; }
  .sv-bus__drop { position: absolute; left: 34px; top: -64px; width: 3px; height: 64px; border-radius: 3px; overflow: visible; background: color-mix(in srgb, var(--orange-400) 55%, transparent); transform-origin: 50% 0; transition: background-color 0.4s, box-shadow 0.4s; }
  .sv-bus__drop i { left: 0; top: 0; width: 100%; height: 30%; overflow: hidden; background: linear-gradient(180deg, transparent, #fff, transparent); animation: sv-run-y 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite; animation-delay: calc(1.6s + var(--i) * 0.45s); transform: translateY(-100%); opacity: 0; }
  @keyframes sv-run-y { 0% { transform: translateY(-100%); opacity: 0; } 10% { opacity: 1; } 45% { transform: translateY(340%); opacity: 1; } 55%, 100% { transform: translateY(340%); opacity: 0; } }
  .sv-bus__brk { position: absolute; left: 50%; top: 50%; width: 26px; height: 26px; margin: -13px 0 0 -13px; padding: 2px; border-radius: 6px; background: var(--navy-900); fill: none; stroke: var(--glow); stroke-width: 1.8; stroke-linecap: round; transition: transform 0.5s var(--ease-spring), stroke 0.3s; }
  .sv-bus__item:is(:hover, :focus-within) .sv-bus__drop { background: var(--glow); box-shadow: 0 0 14px rgba(255, 190, 110, 0.9); }
  .sv-bus__item:is(:hover, :focus-within) .sv-bus__brk { transform: scale(1.18); stroke: #fff; }
  .sv-bus__card {
    position: relative; flex: 1; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px; min-height: 76px;
    padding: 14px 16px 14px 14px; border-radius: 18px; border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02)); color: var(--fg);
    transition: border-color 0.4s, transform 0.6s var(--ease-out), background-color 0.4s, box-shadow 0.6s var(--ease-out);
  }
  .sv-bus__card:hover { border-color: rgba(255, 180, 84, 0.6); transform: translateY(-4px); box-shadow: 0 22px 44px -22px rgba(242, 106, 27, 0.6); }
  .sv-bus__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; color: var(--glow); background: rgba(242, 106, 27, 0.16); transition: background-color 0.4s, color 0.4s; }
  .sv-bus__card:hover .sv-bus__icon { background: var(--orange-500); color: #fff; }
  .sv-bus__txt { display: grid; gap: 2px; min-width: 0; }
  .sv-bus__code { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-text); }
  .sv-bus__name { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; line-height: 1.2; letter-spacing: -0.01em; }
  .sv-bus__go { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.16); transition: background-color 0.3s, border-color 0.3s, transform 0.5s var(--ease-out); }
  .sv-bus__card:hover .sv-bus__go { background: var(--orange-500); border-color: var(--orange-500); transform: rotate(-35deg); }
  /* narrow screens: the busbar runs down the left edge and each circuit tees off to the right */
  @media (max-width: 759px) {
    .sv-bus__grid { padding-top: 0; padding-left: 36px; }
    .sv-bus__rail { top: 0; bottom: 38px; left: 0; right: auto; width: 3px; height: auto; background: linear-gradient(180deg, #f26a1b, #ff9c5c 50%, #ffd79a); transform-origin: 50% 0; }
    .sv-bus__rail i { width: 100%; height: 20%; background: linear-gradient(180deg, transparent, #fff, transparent); animation-name: sv-run-down; transform: translateY(-100%); }
    @keyframes sv-run-down { to { transform: translateY(520%); } }
    .sv-bus__drop { left: -36px; top: 50%; width: 36px; height: 3px; margin-top: -1.5px; transform-origin: 0 50%; }
    .sv-bus__drop i { width: 40%; height: 100%; background: linear-gradient(90deg, transparent, #fff, transparent); animation-name: sv-run-r; }
    @keyframes sv-run-r { 0% { transform: translateX(-100%); opacity: 0; } 10% { opacity: 1; } 45% { transform: translateX(250%); opacity: 1; } 55%, 100% { transform: translateX(250%); opacity: 0; } }
    .sv-bus__brk { width: 22px; height: 22px; margin: -11px 0 0 -11px; transform: rotate(-90deg); }
    .sv-bus__item:is(:hover, :focus-within) .sv-bus__brk { transform: rotate(-90deg) scale(1.18); }
  }
  @media (prefers-reduced-motion: reduce) { .sv-bus__rail i, .sv-bus__drop i, .sv-bus__led { animation: none; opacity: 0; } .sv-bus__led { opacity: 1; } }

  /* ---------- the three lines ---------- */
  .sv-lines { overflow: hidden; background: radial-gradient(70% 60% at 100% 0%, rgba(242, 106, 27, 0.14), transparent 60%), var(--navy-900); }
  .sv-lines__head { max-width: 60rem; margin-bottom: clamp(32px, 5vw, 64px); }
  .sv-lines__head h2 { font-size: clamp(2rem, 1.1rem + 4vw, 4.6rem); max-width: 18ch; }
  .sv-lines__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .sv-row { border-bottom: 1px solid var(--line); }
  .sv-row__link { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 18px 22px; align-items: start; padding: clamp(26px, 3.4vw, 48px) clamp(4px, 1vw, 16px); transition: background-color 0.5s; }
  @media (min-width: 900px) { .sv-row__link { grid-template-columns: 7.5rem auto minmax(0, 1fr) auto; align-items: center; gap: 22px 36px; } }
  .sv-row__link:hover { background: linear-gradient(90deg, rgba(242, 106, 27, 0.1), transparent 70%); }
  .sv-row__n { position: relative; font-size: clamp(2.2rem, 1.2rem + 3vw, 4.4rem); font-weight: 800; line-height: 0.9; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1.2px rgba(255, 255, 255, 0.3); }
  .sv-row__n::after { content: attr(data-n); position: absolute; inset: 0; -webkit-text-stroke: 0; background: var(--grad-brand); -webkit-background-clip: text; background-clip: text; color: transparent; clip-path: inset(0 100% 0 0); transition: clip-path 1s var(--ease-out); }
  .sv-row.is-on .sv-row__n::after, .sv-row__link:hover .sv-row__n::after { clip-path: inset(0 0 0 0); }
  .sv-row__icon { display: none; place-items: center; width: 72px; height: 72px; border-radius: 20px; color: var(--glow); border: 1px solid var(--line); background: rgba(255, 255, 255, 0.03); transition: background-color 0.4s, color 0.4s, border-color 0.4s; }
  @media (min-width: 900px) { .sv-row__icon { display: grid; } }
  .sv-row__link:hover .sv-row__icon { background: var(--orange-500); color: #fff; border-color: var(--orange-500); }
  .sv-row__body { display: grid; gap: 8px; min-width: 0; }
  @media (max-width: 899px) { .sv-row__body { grid-column: 1 / -1; grid-row: 2; } }
  .sv-row__kicker { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); }
  .sv-row__title { font-size: var(--step-2); letter-spacing: -0.025em; }
  .sv-row__summary { color: var(--muted); max-width: 62ch; }
  .sv-row__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .sv-row__tags span { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; padding: 6px 11px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); transition: border-color 0.4s, color 0.4s; }
  .sv-row__link:hover .sv-row__tags span { border-color: rgba(255, 180, 84, 0.45); color: var(--fg); }
  .sv-row__arrow { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--line); transition: background-color 0.3s, color 0.3s, border-color 0.3s, transform 0.5s var(--ease-out); }
  .sv-row__link:hover .sv-row__arrow { background: var(--orange-500); color: #fff; border-color: var(--orange-500); transform: rotate(-35deg); }
  .sv-row__wire { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--grad-brand); box-shadow: 0 0 12px rgba(255, 140, 60, 0.8); transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.9s var(--ease-out); }
  .sv-row__link:hover .sv-row__wire, .sv-row__link:focus-visible .sv-row__wire { transform: scaleX(1); }
  :global(html:not(.js)) .sv-row__n::after { clip-path: none; }
  @media (prefers-reduced-motion: reduce) { .sv-row__n::after { clip-path: none; } }

  /* floating post preview (desktop only, follows the pointer) */
  .sv-float { position: absolute; left: 0; top: 0; z-index: 2; width: clamp(200px, 17vw, 260px); aspect-ratio: 640 / 811; pointer-events: none; opacity: 0; border-radius: 18px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.12); will-change: transform, opacity; }
  .sv-float img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.35s; }
  .sv-float img.is-on { opacity: 1; }
  :global(html:not(.is-desktop-fx)) .sv-float { display: none; }

  /* ---------- process ---------- */
  .sv-process__head { margin-bottom: clamp(36px, 5vw, 64px); }
  .sv-process__head h2 { font-size: clamp(2rem, 1.1rem + 4vw, 4.6rem); max-width: 17ch; }
</style>

<script>
  import { onPage } from '../../scripts/engine.js';
  onPage(({ gsap, env, ScrollTrigger }) => {
    const bus = document.querySelector<HTMLElement>('[data-sv-bus]');
    const lines = document.querySelector<HTMLElement>('[data-sv-lines]');
    if (!bus || !lines) return;
    const rows = [...lines.querySelectorAll<HTMLElement>('.sv-row')];
    const offs: (() => void)[] = [];

    // numbers fill while their row sits in the middle band of the screen
    rows.forEach((row) => ScrollTrigger.create({ trigger: row, start: 'top 70%', end: 'bottom 30%', toggleClass: 'is-on' }));

    if (!env.reduced) {
      // the busbar energises, the drops fall to each breaker, the circuits light up
      const narrow = window.matchMedia('(max-width: 759px)').matches;
      const tl = gsap.timeline({ scrollTrigger: { trigger: bus, start: 'top 95%', once: true } });
      tl.set(bus, { opacity: 1 })
        .from(bus.querySelector('.sv-bus__src'), { opacity: 0, x: -20, duration: 0.6, ease: 'expo.out' })
        .from(bus.querySelector('.sv-bus__rail'), { [narrow ? 'scaleY' : 'scaleX']: 0, duration: 1.1, ease: 'expo.inOut' }, '<0.1')
        .from(bus.querySelectorAll('.sv-bus__drop'), { [narrow ? 'scaleX' : 'scaleY']: 0, duration: 0.5, ease: 'power2.out', stagger: 0.14 }, '-=0.45')
        .from(bus.querySelectorAll('.sv-bus__brk'), { scale: 0, rotate: -90, duration: 0.6, ease: 'back.out(2)', stagger: 0.14, clearProps: 'transform' }, '<0.15')
        .from(bus.querySelectorAll('.sv-bus__card'), { y: 30, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.14, clearProps: 'transform,opacity' }, '<0.1');
    }

    if (!env.desktop) return;
    // floating preview of a real post, following the pointer over the rows
    const float = lines.querySelector<HTMLElement>('.sv-float')!;
    const imgs = [...float.querySelectorAll<HTMLImageElement>('img')];
    const xTo = gsap.quickTo(float, 'x', { duration: 0.7, ease: 'power3.out' });
    const yTo = gsap.quickTo(float, 'y', { duration: 0.7, ease: 'power3.out' });
    const rTo = gsap.quickTo(float, 'rotation', { duration: 0.9, ease: 'power3.out' });
    gsap.set(float, { xPercent: -50, yPercent: -50, scale: 0.6 });
    let lastX = 0;
    const list = lines.querySelector<HTMLElement>('.sv-lines__list')!;
    const move = (e: PointerEvent) => {
      const r = lines.getBoundingClientRect();
      const x = e.clientX - r.left + 150, y = e.clientY - r.top;
      xTo(x); yTo(y); rTo(gsap.utils.clamp(-10, 10, (e.clientX - lastX) * 0.6)); lastX = e.clientX;
    };
    const show = (slug: string) => {
      imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.slug === slug));
      gsap.to(float, { opacity: 1, scale: 1, duration: 0.5, ease: 'expo.out', overwrite: 'auto' });
    };
    const hide = () => gsap.to(float, { opacity: 0, scale: 0.6, duration: 0.4, ease: 'power3.out', overwrite: 'auto' });
    rows.forEach((row) => {
      const enter = () => show(row.dataset.slug || '');
      row.addEventListener('pointerenter', enter);
      offs.push(() => row.removeEventListener('pointerenter', enter));
    });
    list.addEventListener('pointermove', move);
    list.addEventListener('pointerleave', hide);
    offs.push(() => { list.removeEventListener('pointermove', move); list.removeEventListener('pointerleave', hide); });
    return () => offs.forEach((f) => f());
  });
</script>
