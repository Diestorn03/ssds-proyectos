---
// Home — "Corriente Viva" (docs/CONCEPTO.md). Section order and theme rhythm are owned by the lead;
// each scene is owned by its component. Themes: dark / light alternate so the header flips with the page.
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Tablero from '../components/home/Tablero.astro';
import Transferencia from '../components/home/Transferencia.astro';
import Diagnostico from '../components/home/Diagnostico.astro';
import Cobertura from '../components/home/Cobertura.astro';
import Recorrido from '../components/home/Recorrido.astro';
import Valores from '../components/home/Valores.astro';
import Instagram from '../components/home/Instagram.astro';
import Cta from '../components/ui/Cta.astro';
import Icon from '../components/ui/Icon.astro';
import { faqs, wa } from '../data/site.js';
---
<Base title="Inicio" home>
  <Hero />
  <Tablero />
  <Transferencia />
  <Diagnostico />
  <Cobertura />
  <Recorrido />
  <Valores />

  <section class="section faq" id="faq" data-theme="light" aria-labelledby="faq-title">
    <div class="container faq__grid">
      <div class="faq__head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-title" data-split="words">Lo que nos preguntan antes de cotizar.</h2>
        <p class="lead" data-reveal="up" data-delay=".15">Elegir el esquema equivocado te cuesta dinero y paradas de producción. Te ayudamos a identificar el tuyo.</p>
        <a class="btn btn--ghost" href={wa('Hola SSD&S, tengo una consulta técnica.')} target="_blank" rel="noopener" data-reveal="up" data-delay=".3"><Icon name="whatsapp" size={18} />Hacer otra pregunta</a>
      </div>
      <div class="faq__list" data-stagger="0.08">
        {faqs.map((f, i) => (
          <details class="faq__item" name="faq" open={i === 0}>
            <summary>
              <span class="faq__n mono">0{i + 1}</span>
              <span class="faq__q">{f.q}</span>
              <span class="faq__chev"><Icon name="chevron" size={18} /></span>
            </summary>
            <p class="faq__a muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Instagram limit={8} />
  <Cta />
</Base>

<style>
  .faq__grid { display: grid; gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (min-width: 900px) { .faq__grid { grid-template-columns: 0.85fr 1.15fr; } }
  @media (min-width: 900px) { .faq__head { position: sticky; top: calc(var(--header-h) + 32px); } }
  .faq__head h2 { max-width: 14ch; }
  .faq__head .lead { margin: 22px 0 28px; max-width: 40ch; }
  .faq__list { display: grid; gap: 10px; }
  .faq__item { border-radius: var(--radius); border: 1px solid var(--line); background: var(--card); overflow: hidden; transition: border-color 0.3s, box-shadow 0.4s; interpolate-size: allow-keywords; }
  .faq__item[open] { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); box-shadow: 0 20px 40px -28px rgba(11, 26, 58, 0.35); }
  .faq__item summary { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; min-height: 64px; padding: 16px 22px; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); letter-spacing: -0.02em; line-height: 1.25; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__n { color: var(--accent-text); font-size: 0.8rem; }
  .faq__chev { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); color: var(--muted); transition: transform 0.5s var(--ease-out), background-color 0.3s, color 0.3s; }
  .faq__item[open] .faq__chev { transform: rotate(180deg); background: var(--accent); border-color: var(--accent); color: #fff; }
  .faq__a { padding: 0 22px 22px 58px; max-width: 62ch; }
  @media (max-width: 599px) { .faq__item summary { padding: 14px 16px; gap: 12px; } .faq__a { padding: 0 16px 18px; } }
  .faq__item::details-content { block-size: 0; overflow: hidden; transition: block-size 0.5s var(--ease-out), content-visibility 0.5s allow-discrete; }
  .faq__item[open]::details-content { block-size: auto; }
</style>
