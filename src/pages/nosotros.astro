---
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Cta from '../components/ui/Cta.astro';
import Instagram from '../components/home/Instagram.astro';
import { brand, values, sectors, services, process } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const valueIcons = ['gauge', 'clock', 'shield', 'pin'] as const;
const sectorIcons = ['factory', 'building', 'home'] as const;
---
<Base title="Nosotros" description="SSD&S C.A. es una empresa de potencia e ingeniería industrial con oficina principal en Maracay, Aragua. Rigor técnico, respuesta oportuna y máxima seguridad en cada proyecto, con atención en todo el territorio nacional.">
  <section class="ab-hero section">
    <div class="ab-hero__bg" aria-hidden="true">
      <span class="streak streak--thick" style="top: 26%; --angle: -12deg"></span>
      <span class="streak" style="top: 72%; --angle: -12deg; --streak-opacity: .5"></span>
    </div>
    <div class="container ab-hero__grid">
      <div>
        <p class="eyebrow">Nosotros</p>
        <h1 data-split="words">Potencia e ingeniería industrial desde Maracay para toda Venezuela.</h1>
        <p class="lead" data-reveal="up" data-delay=".15">Detrás de cada gran proceso industrial hay una infraestructura eléctrica sólida y un equipo técnico calificado respaldándola. En {brand.name} combinamos el rigor técnico con la ejecución segura para garantizar que la energía de tu planta nunca se detenga.</p>
      </div>
      <blockquote class="ab-hero__quote" data-reveal="left" data-delay=".3">
        <p data-lit>La ingeniería no es solo suministrar energía; es saber distribuirla, automatizarla y protegerla.</p>
        <cite class="mono">— {brand.legalName}</cite>
      </blockquote>
    </div>
  </section>

  <section class="section on-light">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Lo que garantizamos</p>
        <h2 data-split="words">Rigor técnico, respuesta oportuna y máxima seguridad.</h2>
      </div>
      <ul class="grid grid--4 ab-values" data-stagger="0.1">
        {values.map((v, i) => (
          <li class="card" data-glow>
            <span class="ab-values__icon"><Icon name={valueIcons[i]} size={28} /></span>
            <h3>{v.t}</h3>
            <p class="muted">{v.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section ab-story">
    <div class="container ab-story__grid">
      <div class="ab-story__col">
        <p class="eyebrow">Qué hacemos</p>
        <h2 data-split="words">Tres líneas de servicio, un solo equipo.</h2>
        <p class="lead" data-reveal="up">Desde la evaluación inicial hasta el montaje en alta y media tensión, entregamos soluciones dinámicas para el sector residencial, comercial e industrial.</p>
        <ul class="ab-story__services" data-stagger="0.1">
          {services.map((s) => (
            <li><a href={`${base}/servicios/${s.slug}/`}><span class="mono accent">{s.code}</span><strong>{s.name}</strong><Icon name="arrow" size={18} /></a></li>
          ))}
        </ul>
      </div>
      <div class="ab-story__col">
        <p class="eyebrow">Cómo trabajamos</p>
        <ol class="ab-process" data-stagger="0.1">
          {process.map((p) => (
            <li><span class="num accent">{p.n}</span><div><strong>{p.t}</strong><p class="muted">{p.d}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section on-light">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">A quién atendemos</p>
        <h2 data-split="words">Industrial, comercial y residencial.</h2>
        <p class="lead">No importa dónde esté tu planta industrial o comercio: nuestro equipo llega a ti con soluciones de ingeniería de alto nivel.</p>
      </div>
      <ul class="grid grid--3" data-stagger="0.1">
        {sectors.map((s, i) => (
          <li class="card ab-sector">
            <span class="ab-values__icon"><Icon name={sectorIcons[i]} size={28} /></span>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Instagram limit={4} />
  <Cta title="Conecta con nuestro equipo técnico." text="Contáctanos para asesorías directas o cotizaciones de proyectos, en Maracay o en cualquier estado del país." waText="Hola SSD&S, quiero una asesoría / cotización de proyecto." label="Escribir por WhatsApp" />
</Base>

<style>
  .ab-hero { overflow: hidden; padding-top: calc(var(--header-h) + clamp(56px, 9vw, 120px)); background: radial-gradient(80% 60% at 0% 0%, rgba(242, 106, 27, 0.22), transparent 60%), var(--navy-900); }
  .ab-hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .ab-hero__grid { position: relative; display: grid; gap: 40px; align-items: end; }
  @media (min-width: 960px) { .ab-hero__grid { grid-template-columns: 1.3fr 0.9fr; } }
  .ab-hero h1 { font-size: var(--step-4); max-width: 18ch; }
  .ab-hero .lead { margin-top: 22px; max-width: 54ch; }
  .ab-hero__quote { margin: 0; padding: clamp(22px, 3vw, 34px); border-left: 3px solid var(--accent); background: var(--card); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .ab-hero__quote p { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.02em; }
  .ab-hero__quote cite { display: block; margin-top: 16px; font-style: normal; color: var(--muted); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .ab-values__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: rgba(242, 106, 27, 0.12); color: var(--accent); margin-bottom: 18px; }
  .ab-values h3, .ab-sector h3 { margin-bottom: 10px; }
  .ab-story__grid { display: grid; gap: clamp(36px, 6vw, 80px); }
  @media (min-width: 960px) { .ab-story__grid { grid-template-columns: 1fr 1fr; } }
  .ab-story__col .lead { margin: 18px 0 28px; }
  .ab-story__services { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ab-story__services a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 16px 18px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--card); font-family: var(--font-display); transition: border-color 0.3s, transform 0.5s var(--ease-out); }
  .ab-story__services a:hover { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); transform: translateX(4px); }
  .ab-process { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .ab-process li { display: grid; grid-template-columns: auto 1fr; gap: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .ab-process .num { font-size: var(--step-1); font-weight: 800; }
  .ab-process strong { font-family: var(--font-display); font-size: var(--step-1); display: block; margin-bottom: 4px; }
</style>
