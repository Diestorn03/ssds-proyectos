---
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import { brand, contact, services, social, wa } from '../data/site.js';
---
<Base title="Contacto" description={`Escríbenos por WhatsApp al ${contact.phoneDisplay} o a ${contact.email}. Oficina principal en Maracay, Aragua; atención en todo el territorio nacional.`}>
  <section class="contact section">
    <div class="contact__bg" aria-hidden="true">
      <span class="streak streak--thick" style="top: 22%; --angle: -12deg"></span>
      <span class="streak" style="top: 66%; --angle: -12deg; --streak-opacity: .45"></span>
    </div>
    <div class="container contact__grid">
      <div class="contact__copy">
        <p class="eyebrow">Contacto</p>
        <h1 data-split="words">Conecta con nuestro equipo técnico.</h1>
        <p class="lead" data-reveal="up" data-delay=".15">Para cotizaciones, consultas o emergencias técnicas. Respondemos por WhatsApp y coordinamos la visita en Maracay o en cualquier estado del país.</p>

        <ul class="contact__channels" data-stagger="0.1">
          <li>
            <a href={wa()} target="_blank" rel="noopener" class="channel" data-glow>
              <span class="channel__icon channel__icon--wa"><Icon name="whatsapp" size={22} /></span>
              <span><strong>WhatsApp</strong><span class="channel__v">{contact.phoneDisplay}</span></span>
              <Icon name="arrowUpRight" size={18} class="channel__arrow" />
            </a>
          </li>
          <li>
            <a href={`tel:${contact.phoneE164}`} class="channel" data-glow>
              <span class="channel__icon"><Icon name="phone" size={22} /></span>
              <span><strong>Llamada</strong><span class="channel__v">{contact.phoneDisplay}</span></span>
              <Icon name="arrowUpRight" size={18} class="channel__arrow" />
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`} class="channel" data-glow>
              <span class="channel__icon"><Icon name="mail" size={22} /></span>
              <span><strong>Correo</strong><span class="channel__v">{contact.email}</span></span>
              <Icon name="arrowUpRight" size={18} class="channel__arrow" />
            </a>
          </li>
          <li>
            <a href={social.instagram} target="_blank" rel="noopener" class="channel" data-glow>
              <span class="channel__icon"><Icon name="instagram" size={22} /></span>
              <span><strong>Instagram</strong><span class="channel__v">@{contact.instagram}</span></span>
              <Icon name="arrowUpRight" size={18} class="channel__arrow" />
            </a>
          </li>
          <li>
            <div class="channel channel--static">
              <span class="channel__icon"><Icon name="pin" size={22} /></span>
              <span><strong>Oficina principal</strong><span class="channel__v">{contact.address}</span><span class="channel__note">Cuadrillas a todo el territorio nacional</span></span>
            </div>
          </li>
        </ul>
      </div>

      <form class="qform card" id="qform" data-reveal="right" data-delay=".2" novalidate>
        <p class="qform__eyebrow mono">Arma tu solicitud</p>
        <h2 class="qform__title">Cuéntanos qué necesitas y te lo enviamos por WhatsApp.</h2>
        <div class="qform__row">
          <label class="field"><span>Nombre</span><input name="nombre" type="text" autocomplete="name" required placeholder="Tu nombre" /></label>
          <label class="field"><span>Empresa</span><input name="empresa" type="text" autocomplete="organization" placeholder="Empresa o residencia" /></label>
        </div>
        <label class="field"><span>Servicio</span>
          <select name="servicio" required>
            <option value="">Selecciona un servicio</option>
            {services.map((s) => <option value={s.name}>{s.name}</option>)}
            <option value="Otro">Otro / no estoy seguro</option>
          </select>
        </label>
        <label class="field"><span>Ubicación</span><input name="ubicacion" type="text" placeholder="Ciudad y estado" /></label>
        <label class="field"><span>Mensaje</span><textarea name="mensaje" rows="4" required placeholder="Describe la instalación, el equipo o la falla"></textarea></label>
        <p class="qform__error" role="alert" hidden>Completa nombre, servicio y mensaje.</p>
        <div class="btn-row">
          <button class="btn btn--primary" type="submit"><Icon name="whatsapp" size={20} />Enviar por WhatsApp</button>
          <button class="btn btn--ghost" type="button" data-mail><Icon name="mail" size={18} />Enviar por correo</button>
        </div>
        <p class="qform__hint">Se abre WhatsApp o tu correo con el mensaje ya redactado. Sin formularios en servidor: escribes directo al equipo de {brand.shortName}.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact { overflow: hidden; padding-top: calc(var(--header-h) + clamp(48px, 8vw, 96px)); background: radial-gradient(90% 60% at 0% 0%, rgba(242, 106, 27, 0.22), transparent 60%), var(--navy-900); }
  .contact__bg { position: absolute; inset: 0; pointer-events: none; }
  .contact__grid { position: relative; display: grid; gap: clamp(36px, 6vw, 80px); align-items: start; }
  @media (min-width: 960px) { .contact__grid { grid-template-columns: 1.05fr 1fr; } }
  .contact__copy h1 { max-width: 14ch; }
  .contact__copy .lead { margin: 22px 0 36px; max-width: 46ch; }
  .contact__channels { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .channel { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 14px 16px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--card); transition: border-color 0.3s, transform 0.5s var(--ease-out); }
  .channel:not(.channel--static):hover { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); transform: translateX(4px); }
  .channel strong { display: block; font-family: var(--font-display); font-size: 0.95rem; }
  .channel__v { display: block; color: var(--muted); font-size: 0.95rem; }
  .channel__note { display: block; color: var(--amber-400); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 4px; }
  .channel__icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: rgba(255, 255, 255, 0.06); color: var(--accent); }
  .channel__icon--wa { color: #25d366; }
  .channel__arrow { color: var(--muted); }
  .qform { display: grid; gap: 16px; }
  .qform__eyebrow { color: var(--accent); font-size: 0.75rem; text-transform: uppercase; }
  .qform__title { font-size: var(--step-1); letter-spacing: -0.02em; margin-bottom: 6px; }
  .qform__row { display: grid; gap: 16px; }
  @media (min-width: 560px) { .qform__row { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: 6px; font-size: 0.85rem; color: var(--muted); }
  .field input, .field select, .field textarea { width: 100%; font: inherit; font-size: 1rem; color: var(--fg); background: rgba(255, 255, 255, 0.05); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; transition: border-color 0.3s, background-color 0.3s; }
  .field select option { color: #111; }
  .field textarea { resize: vertical; min-height: 110px; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--accent); background: rgba(255, 255, 255, 0.08); }
  .field input:user-invalid, .field select:user-invalid, .field textarea:user-invalid { border-color: #ff6b6b; }
  .qform__error { color: #ffb4b4; font-size: 0.9rem; }
  .qform__hint { color: var(--muted); font-size: 0.82rem; }
</style>

<script>
  import { contact } from '../data/site.js';
  function initForm() {
    const form = document.getElementById('qform') as HTMLFormElement | null;
    if (!form) return;
    const err = form.querySelector('.qform__error') as HTMLElement;
    const compose = () => {
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) || '').trim();
      if (!v('nombre') || !v('servicio') || !v('mensaje')) { err.hidden = false; form.reportValidity(); return null; }
      err.hidden = true;
      return [
        `Hola SSD&S, soy ${v('nombre')}${v('empresa') ? ` de ${v('empresa')}` : ''}.`,
        `Servicio: ${v('servicio')}.`,
        v('ubicacion') ? `Ubicación: ${v('ubicacion')}.` : '',
        `Mensaje: ${v('mensaje')}`,
      ].filter(Boolean).join('\n');
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = compose();
      if (msg) window.open(`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
    });
    form.querySelector('[data-mail]')?.addEventListener('click', () => {
      const msg = compose();
      if (msg) location.href = `mailto:${contact.email}?subject=${encodeURIComponent('Solicitud de servicio — sitio web')}&body=${encodeURIComponent(msg)}`;
    });
  }
  initForm();
  document.addEventListener('astro:after-swap', initForm);
</script>
