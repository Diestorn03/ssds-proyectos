---
// Escena #dimensionar "Dimensiona tu respaldo" (light). Tres pasos (Punto de partida · Equipos · Horas) + resultado con opciones
// Básica / Recomendada / Holgada, y un resumen fijo "Tu sistema". Reglas y precios: src/data/dimensionar.js · lógica: src/scripts/dimensionar.js
// Diseño: una cifra protagonista por pantalla, cada dato se ve una sola vez; naranja solo para acción y selección. Todo número es orientativo.
import Icon from '../ui/Icon.astro';
import { wa } from '../../data/site.js';
import { K, loads, presets, inverters, pricing, validezTxt } from '../../data/dimensionar.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nf = (n: number, d = 1) => n.toLocaleString('es-VE', { maximumFractionDigits: d });

// Glifos de equipos 24×24 (trazo 1.8) que Icon.astro no tiene; los alias reutilizan el más parecido.
const glyph: Record<string, string> = {
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  snowflake: '<path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19"/><path d="M12 2l-2 3h4M12 22l-2-3h4M2 12l3-2v4M22 12l-3-2v4"/>',
  phone: '<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z"/>',
  plug: '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0V8ZM12 17v4"/>',
  home: '<path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1v-9Z"/>',
  fridge: '<rect x="6" y="2.5" width="12" height="19" rx="2"/><path d="M6 10h12M9 6v1.5M9 13v3"/>',
  router: '<rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 17h.01M11 17h.01M7 14 5 9.5M17 14l2-4.5M12 14V8"/>',
  dish: '<ellipse cx="12" cy="9" rx="8" ry="4.5"/><path d="M12 13.5V20M8 21h8"/>',
  bulb: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>',
  fan: '<circle cx="12" cy="12" r="1.6"/><path d="M12 10.4C12 6 14 3.5 16 4s1.4 3-1 4.6M13.6 12c4.4 0 6.9 2 6.4 4s-3 1.4-4.6-1M12 13.6c0 4.4-2 6.9-4 6.4s-1.4-3 1-4.6M10.4 12C6 12 3.5 10 4 8s3-1.4 4.6 1"/>',
  tv: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  camera: '<path d="M3 8h3l1.5-2h9L18 8h3v11H3V8Z"/><circle cx="12" cy="13" r="3.5"/>',
  gate: '<path d="M3 21V6M21 21V6M3 10h18M3 16h18M8 10v6M13 10v6M18 10v6"/>',
  pump: '<circle cx="10" cy="13" r="5"/><path d="M15 13h6v-3M8 13h4M10 8V5h4"/>',
  ac: '<rect x="3" y="5" width="18" height="8" rx="2"/><path d="M7 9h10M8 16c0 2-1 3-1 5M12 16c0 2-1 3-1 5M16 16c0 2-1 3-1 5"/>',
  laptop: '<rect x="5" y="5" width="14" height="10" rx="1.5"/><path d="M2 19h20"/>',
  pc: '<rect x="3" y="4" width="8" height="16" rx="1.5"/><path d="M7 16h.01M14 8h7v8h-7zM17.5 16v3M15 19h5"/>',
  washer: '<rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="4"/><path d="M8 6.5h.01M11 6.5h.01"/>',
  microwave: '<rect x="3" y="6" width="18" height="12" rx="2"/><rect x="6" y="9" width="8" height="6" rx="1"/><path d="M17 9.5h.01M17 12h.01M17 14.5h.01"/>',
  blender: '<path d="M8 3h8l-1 10H9L8 3Z"/><path d="M7 13h10v3a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-3ZM10 21h4"/>',
  bottle: '<path d="M10 2h4v4l2 3v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2V9l2-3V2Z"/><path d="M8 13h8"/>',
  pos: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M8 14.5h2M12 14.5h2M8 18h8"/>',
};
const alias: Record<string, string> = { showcase: 'fridge', icecream: 'snowflake', register: 'pos', dryer: 'washer', drop: 'pump', stove: 'microwave', weld: 'bolt', motor: 'bolt' };
const gl = (k: string) => glyph[alias[k] ?? k] ?? glyph.plug;
const presetIc: Record<string, string> = { esencial: 'bulb', aire: 'ac', completa: 'home', negocio: 'pos', oficina: 'laptop', cero: 'plug' };
const presetList = [...presets, { id: 'cero', t: 'Desde cero', d: 'Marco mis equipos yo mismo', items: {} }];

// Equipos por categoría (el orden de loads[] manda dentro de cada una). Los que cotiza un ingeniero van aparte y al final.
const cats = [
  { id: 'esencial', t: 'Lo esencial' }, { id: 'clima', t: 'Clima' }, { id: 'agua', t: 'Agua' },
  { id: 'cocina', t: 'Cocina y lavado' }, { id: 'trabajo', t: 'Trabajo' }, { id: 'negocio', t: 'Negocio' }, { id: 'ing', t: 'Con ingeniero' },
].map((c) => ({ ...c, rows: loads.filter((l) => l.id !== 'otro' && (c.id === 'ing' ? l.engineer : !l.engineer && l.cat === c.id)) }));
const tabsList = [...cats, { id: 'otro', t: 'Otro equipo' }];
const sub = (l: any) => [l.engineer && 'Lo cotiza un ingeniero', l.v220 === true && !l.engineer && '220 V'].filter(Boolean).join(' · ');
const hours = [{ h: 2, t: 'un bajón' }, { h: 4, t: 'corte típico' }, { h: 8, t: 'una noche' }, { h: 12, t: 'medio día' }, { h: 24, t: 'día completo' }];
const places = [{ v: 'apto', t: 'Apartamento' }, { v: 'casa', t: 'Casa' }, { v: 'negocio', t: 'Negocio' }];
const cities = ['Maracay', 'Turmero', 'Cagua', 'La Victoria', 'Otra zona'];
const tiers = [{ k: 'basico' }, { k: 'recomendado' }, { k: 'holgado' }];
const lights = [{ k: 'start', t: 'Arranque' }, { k: 'hours', t: 'Horas' }, { k: 'charge', t: 'Recarga' }, { k: 'v220', t: '220 V' }];
const maxKw = Math.max(...inverters.filter((i: any) => i.available && i.priceEq > 0).map((i: any) => i.kw));
const waHi = wa('Hola SSD&S, quiero dimensionar un respaldo con inversor y baterías para mi casa o negocio.');
const svgIc = (d: string, s = 20) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
<section id="dimensionar" class="section dz" data-theme="light" data-fab-hide aria-labelledby="dimensionar-title">
  <div class="dz__bg" aria-hidden="true">
    <span class="streak streak--thick dz__ray"></span>
  </div>

  <div class="container">
    <h2 id="dimensionar-title" class="sr-only">Dimensiona tu respaldo</h2>

    <div class="dz-grid" data-dz-grid>
      <form class="dz-main" data-dz-form novalidate aria-label="Dimensiona tu respaldo en 3 pasos">
        <div class="dz-card" data-dz-card data-step="0" data-reveal="up" data-delay=".05">
          <div class="dz-prog" data-dz-track aria-hidden="true">
            <p class="dz-count">Paso <b data-dz-count>1</b> de 3 · <span data-dz-steplbl>Punto de partida</span></p>
            <div class="dz-seg3"><i data-dz-seg></i><i data-dz-seg></i><i data-dz-seg></i></div>
          </div>

          <div class="dz-steps">
            <!-- 1 · Punto de partida -->
            <fieldset class="dz-step dz-step--preset is-active" data-dz-step aria-describedby="dz-help-0">
              <legend class="dz-legend">¿Por dónde empezamos?</legend>
              <p class="dz-help" id="dz-help-0">Elige lo más parecido a tu caso. Después quitas o sumas equipos.</p>
              <div class="dz-opts">
                {presetList.map((p) => (
                  <label class="dz-card-opt">
                    <input type="radio" name="preset" value={p.id} />
                    <span class="dz-opt__ic" aria-hidden="true" set:html={svgIc(gl(presetIc[p.id]), 22)} />
                    <span class="dz-opt__txt"><span class="dz-opt__t">{p.t}</span><span class="dz-opt__d">{p.d}</span></span>
                    <span class="dz-opt__ck" aria-hidden="true"><Icon name="check" size={14} stroke={2.6} /></span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- 2 · Equipos -->
            <fieldset class="dz-step dz-step--items" data-dz-step aria-describedby="dz-help-1">
              <legend class="dz-legend">¿Qué quieres mantener encendido?</legend>
              <p class="dz-help" id="dz-help-1">Toca para agregar; con − y + ajustas la cantidad. No hace falta saber vatios.</p>
              <p class="dz-from" data-dz-fromrow hidden><span>Partiste de: <b data-dz-from></b></span><button type="button" class="btn btn--text" data-dz-change>cambiar</button></p>
              <div class="dz-tabs" role="tablist" aria-label="Categorías de equipos" data-dz-tabs>
                {tabsList.map((c, i) => (
                  <button type="button" role="tab" id={`dz-tab-${c.id}`} class="dz-tab" data-dz-tab={c.id} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`dz-panel-${c.id}`} tabindex={i === 0 ? 0 : -1}>
                    <span>{c.t}</span><span class="dz-tab__n" data-dz-gn hidden></span>
                  </button>
                ))}
              </div>
              <div class="dz-panels">
                {cats.map((c, i) => (
                  <div class="dz-rows" role="tabpanel" id={`dz-panel-${c.id}`} aria-labelledby={`dz-tab-${c.id}`} data-dz-group={c.id} hidden={i !== 0}>
                    {c.id === 'clima' && <p class="dz-hint" data-dz-hotnote hidden>Si donde vives hace mucho calor, actívalo en «Ajustar mi caso» al ver tu precio.</p>}
                    {c.id === 'ing' && <p class="dz-hint">Cocinas, secadoras, soldadoras y motores trifásicos no se respaldan con baterías de este tamaño: márcalos igual y te lo cotiza un ingeniero.</p>}
                    {c.rows.map((l: any) => (
                      <div class="dz-row" data-dz-row={l.id}>
                        <button type="button" class="dz-row__hit" data-dz-hit aria-pressed="false">
                          <span class="dz-opt__ic" aria-hidden="true" set:html={svgIc(gl(l.icon), 22)} />
                          <span class="dz-row__txt"><span class="dz-row__t">{l.t}</span>{sub(l) && <span class="dz-row__sub">{sub(l)}</span>}</span>
                        </button>
                        <span class="dz-qty" role="group" aria-label={`Cantidad: ${l.t}`}>
                          <button type="button" data-dz-dec aria-label={`Quitar uno: ${l.t}`}>−</button>
                          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" name={l.id} value="0" aria-label={`Cantidad: ${l.t}`} autocomplete="off" data-dz-qty />
                          <button type="button" data-dz-inc aria-label={`Sumar uno: ${l.t}`}>+</button>
                        </span>
                        {l.v220 === 'ask' && (
                          <div class="dz-ask" data-dz-ask hidden role="group" aria-labelledby={`dz-askq-${l.id}`}>
                            <p class="dz-ask__q" id={`dz-askq-${l.id}`}>¿Tu {l.hp ? 'bomba' : 'aire'} es de 220 V? Lo dice la placa{l.hp ? '' : ' o el breaker doble'}.</p>
                            <div class="dz-chips">
                              <label class="dz-pill"><input type="radio" name={`v220-${l.id}`} value="1" />Sí, es de 220</label>
                              <label class="dz-pill"><input type="radio" name={`v220-${l.id}`} value="0" />No, es de 110</label>
                              <label class="dz-pill"><input type="radio" name={`v220-${l.id}`} value="?" />No sé</label>
                            </div>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                ))}
                <div class="dz-rows" role="tabpanel" id="dz-panel-otro" aria-labelledby="dz-tab-otro" data-dz-group="otro" hidden>
                  <p class="dz-hint">Escribe la potencia que dice la placa. Si tiene motor (bomba, compresor), márcalo: cuenta su arranque.</p>
                  {[0, 1, 2].map((i) => (
                    <div class="dz-custom" data-dz-crow>
                      <label class="dz-f dz-f--t"><span class="dz-f__l">Nombre</span><input class="dz-field" type="text" name={`ct${i}`} maxlength="40" autocomplete="off" placeholder="Ej. bomba de pozo" /></label>
                      <label class="dz-f"><span class="dz-f__l">Potencia (W)</span><input class="dz-field" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="5" name={`cw${i}`} autocomplete="off" placeholder="Ej. 750" /></label>
                      <label class="dz-f"><span class="dz-f__l">Cantidad</span><input class="dz-field" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" name={`cn${i}`} autocomplete="off" placeholder="1" /></label>
                      <label class="dz-pill dz-custom__m"><input type="checkbox" name={`cm${i}`} value="1" />Tiene motor</label>
                    </div>
                  ))}
                </div>
              </div>
            </fieldset>

            <!-- 3 · Horas y dónde va -->
            <fieldset class="dz-step dz-step--hours" data-dz-step aria-describedby="dz-help-2">
              <legend class="dz-legend">¿Cuántas horas quieres cubrir por corte?</legend>
              <p class="dz-help" id="dz-help-2">Piensa en tu corte habitual. Si dudas, deja 8 h.</p>
              <div class="dz-hours">
                {hours.map((o) => (
                  <label class="dz-hour">
                    <input type="radio" name="hours" value={String(o.h)} checked={o.h === 8} />
                    <span class="dz-hour__h">{o.h} h</span><span class="dz-hour__t">{o.t}</span><span class="dz-hour__w" data-dz-hp={o.h}></span>
                  </label>
                ))}
              </div>
              <p class="dz-live" data-dz-liveline></p>
              <p class="dz-plant" data-dz-plant hidden>Para cortes tan largos conviene evaluar también una planta eléctrica. <a class="btn btn--text" href={`${base}/servicios/respaldo-energetico/`}>Ver Respaldo Energético</a></p>
              <fieldset class="dz-fs dz-q2">
                <legend class="dz-q2__t">¿Dónde va el sistema?</legend>
                <div class="dz-places">
                  {places.map((p) => <label class="dz-pill dz-place"><input type="radio" name="place" value={p.v} />{p.t}</label>)}
                </div>
              </fieldset>
            </fieldset>
          </div>

          <div class="dz-nav" data-dz-nav>
            <button type="button" class="btn btn--ghost dz-back" data-dz-back disabled>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
              <span class="dz-back__t">Atrás</span>
            </button>
            <p class="dz-bar__sum" aria-hidden="true"><b class="num" data-dz-bar-price></b><span data-dz-bar-sub></span></p>
            <button type="submit" class="btn btn--primary dz-next" data-dz-next disabled data-magnetic="0.2">
              <span data-dz-next-lbl>Siguiente</span><Icon name="arrow" size={20} class="arrow" />
            </button>
          </div>
          <p class="dz-nojs">
            Esta herramienta necesita JavaScript. Cuéntanos qué quieres mantener encendido y te respondemos por WhatsApp.<br />
            <a class="btn btn--wa" href={waHi} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />Dimensionar por WhatsApp</a>
          </p>
        </div>

        <!-- Resultado -->
        <article class="dz-res" data-dz-res hidden tabindex="-1" aria-labelledby="dz-res-title">
          <p class="dz-resume" data-dz-resume hidden><span>Configuración cargada desde el enlace.</span><button type="button" class="btn btn--text" data-dz-edit>Editar equipos</button></p>
          <header class="dz-res__top">
            <h3 id="dz-res-title" class="dz-res__title" data-dz-rtitle>Tu respaldo</h3>
            <p class="dz-res__sub" data-dz-rsub>Precio referencial en USD. Se confirma en la visita técnica.</p>
          </header>

          <div class="dz-ok" data-dz-ok>
            <p class="dz-status" data-dz-status data-state="ok"><span class="dz-status__ic" aria-hidden="true"></span><span data-dz-status-t></span></p>

            <section class="dz-cmp" aria-labelledby="dz-cmp-h">
              <div class="dz-cmp__bar">
                <h4 class="dz-cmp__h" id="dz-cmp-h">Elige una opción</h4>
                <div class="dz-seg" role="radiogroup" aria-label="Qué incluye el precio">
                  <span class="dz-seg__thumb" aria-hidden="true"></span>
                  <label class="dz-seg__opt"><input type="radio" name="install" value="equipo" checked /><span>Solo equipo</span></label>
                  <label class="dz-seg__opt"><input type="radio" name="install" value="instalado" /><span>Instalado</span></label>
                </div>
              </div>
              <div class="dz-tiers" data-dz-tiers role="radiogroup" aria-label="Opciones de respaldo">
                {tiers.map((t) => (
                  <label class="dz-tier" data-dz-tier={t.k} hidden>
                    <input type="radio" name="tier" value={t.k} />
                    <span class="dz-tier__top"><span class="dz-tier__lbl" data-dz-t="lbl"></span><span class="dz-tier__rev" data-dz-t="rev" hidden>Sujeta a revisión</span></span>
                    <span class="dz-tier__pic"><span class="dz-pic" data-dz-pic="inv"></span><span class="dz-pic" data-dz-pic="bat"></span></span>
                    <span class="dz-tier__price"><span class="dz-tier__from" data-dz-t="from" hidden>desde</span><b class="dz-tier__n num" data-dz-t="price"></b><span class="dz-tier__pl" data-dz-t="pl"></span></span>
                    <span class="dz-tier__sub" data-dz-t="sub"></span>
                    <span class="dz-tier__line" data-dz-t="line"></span>
                    <span class="dz-tier__h" data-dz-t="h"></span>
                    <span class="dz-tier__sys"><span data-dz-t="inv" data-k="Inversor"></span><span data-dz-t="bat" data-k="Baterías"></span></span>
                    <span class="dz-tier__delta" data-dz-t="delta"></span>
                  </label>
                ))}
              </div>
              <p class="dz-cmp__note" data-dz-cmpnote hidden></p>
              <p class="dz-adj" data-dz-adjline hidden>Incluye kit básico hasta {pricing.basicKitM} m del tablero. <button type="button" class="btn btn--text" data-dz-adjust>Ajustar transferencia y metros</button></p>
            </section>
          </div>

          <div class="dz-oos" data-dz-oos hidden>
            <h3 class="dz-oos__t">Esto se dimensiona con un ingeniero.</h3>
            <p class="dz-oos__s">Tu lista ya está en el mensaje: escríbenos y lo vemos contigo.</p>
            <p class="dz-oos__why"><b>Motivo</b><span data-dz-reason></span></p>
            <p class="dz-oos__lim">En línea cotizamos un solo inversor, de hasta {nf(maxKw, 0)} kW. Tu caso pasa de eso, o incluye equipos que no se respaldan con baterías de este tamaño.</p>
            <ul class="dz-oos__list" role="list" data-dz-list></ul>
            <ul class="dz-kpis" role="list" data-dz-figs></ul>
            <p class="dz-oos__tip" data-dz-tip hidden></p>
            <button type="button" class="btn btn--primary" data-dz-remove hidden></button>
          </div>

          <section class="dz-sel">
            <p class="dz-sel__t" data-dz-sel></p>
          </section>

          <div class="dz-cta">
            <a class="btn btn--wa" data-dz-wa data-magnetic="0.2" href={waHi} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /><span><span class="dz-xs-hide">Pedir por </span>WhatsApp</span></a>
            <button type="button" class="btn btn--ghost dz-pdf__btn" data-dz-pdf-btn data-dz-okonly aria-describedby="dz-pdf-hint">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19h14" /></svg>
              <span data-dz-pdf-lbl><span class="dz-xs-hide">Descargar presupuesto </span>PDF</span>
            </button>
          </div>

          <div class="dz-after">
            <details class="dz-pdfname" data-dz-okonly>
              <summary>Poner mi nombre en el PDF (opcional)</summary>
              <label class="dz-f"><span class="dz-f__l">Tu nombre</span><input class="dz-field" type="text" name="pdfName" maxlength="60" autocomplete="name" enterkeyhint="done" placeholder="Ej. María Pérez" aria-describedby="dz-pdf-hint" data-dz-pdf-name /></label>
              <p class="dz-micro" id="dz-pdf-hint">No se envía a ningún lado: solo se imprime en tu PDF.</p>
            </details>
            <p class="dz-pdf__ig" data-dz-pdf-ig hidden>
              <span>Para descargar, abre esta página en tu navegador.</span>
              <button type="button" class="btn btn--text" data-dz-copy="url"><span>Copiar enlace</span></button>
            </p>
            <p class="dz-pdf__err" role="alert" data-dz-pdf-err hidden></p>
            <p class="dz-micro">No pedimos tu teléfono ni tu correo. Se abre WhatsApp con el texto listo; lo envías tú.</p>
            <p class="dz-micro" data-dz-igtip hidden>Si WhatsApp no abre desde Instagram, toca ⋯ y elige Abrir en el navegador, o copia el mensaje.</p>
            <p class="dz-links">
              <button type="button" class="btn btn--text" data-dz-copy="url"><span>Copiar enlace</span></button>
              <button type="button" class="btn btn--text" data-dz-edit>Editar mis equipos</button>
              <button type="button" class="btn btn--text" data-dz-restart>Volver a empezar</button>
            </p>
          </div>

          <section class="dz-more" data-dz-okonly>
            <h4 class="dz-more__h">Detalles</h4>
            <details class="dz-acc">
              <summary>Qué incluye tu opción<Icon name="chevron" size={18} class="dz-chev" /></summary>
              <div class="dz-acc__b">
                <p data-dz-runs></p>
                <ul class="dz-checks" role="list" data-dz-lights>
                  {lights.map((l) => <li class="dz-light" data-dz-light={l.k} data-state="ok"><span class="dz-light__ic" aria-hidden="true"></span><span class="dz-light__k">{l.t}</span><span class="dz-light__t"></span></li>)}
                </ul>
                <ul class="dz-whys" role="list" data-dz-whys></ul>
