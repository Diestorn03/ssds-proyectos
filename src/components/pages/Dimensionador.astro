    .dz-tab[aria-selected='true'], .dz-hour:has(input:checked), .dz-pill:has(input:checked), .dz-card-opt:has(input:checked), .dz-tier:has(input:checked), .dz-seg__opt:has(input:checked) { outline: 3px solid Highlight; outline-offset: -3px; }
    .dz-tab[aria-selected='true'] { forced-color-adjust: none; background: Highlight; color: HighlightText; border-color: Highlight; }
    .dz-tier:has(input:checked) .dz-tier__top::before { forced-color-adjust: none; background: Highlight; border-color: Highlight; }
