      order: 99; position: sticky; bottom: 0; z-index: 4; flex-wrap: nowrap; margin: 0 calc(-1 * var(--dz-pad)); padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px)); gap: 8px;
      background: var(--white); border-top: 1px solid var(--line); border-radius: 0 0 var(--dz-r-lg) var(--dz-r-lg); box-shadow: 0 -12px 20px -16px rgba(11, 26, 58, 0.25);
