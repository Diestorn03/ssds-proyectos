---
/* Los pocos íconos que usa el cotizador, sin estilos propios. Icon.astro lleva un <style> con alcance: si /app/ y el sitio lo compartieran, Astro lo sacaría de
   Base.css y cambiaría el orden de la cascada de todo el sitio. Los estilos de `.icon` de aquí van en el bloque global de Dimensionador.astro. */
interface Props { name: keyof typeof icons; size?: number; class?: string; stroke?: number }
const { name, size = 24, class: cls = '', stroke = 1.8 } = Astro.props;
const icons = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="m5 12 4 4L19 6"/>',
  whatsapp: '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z"/><path d="M9 9.5c.3 2.5 2.6 4.8 5.2 5.2l1.3-1.3-1.8-.8-.9.7a4 4 0 0 1-2.2-2.2l.7-.9-.8-1.8L9 9.5Z"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
};
---
<svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[name]} />
