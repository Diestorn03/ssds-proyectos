---
/**
 * #valores · "Por qué SSD&S" · dark.
 * A giant bleed word POTENCIA in outline fills with the orange → gold ray (diagonal clip edge + a light ray riding it,
 * a meter scale underneath lights up with it). Below, the heading sticks beside a cascading stack of the 4 values
 * (engine .stack-card): each card rises tilted, stands up, "powers on" (outline number charges, icon + signal trace
 * draw with DrawSVG) and its LED lights on the heading's index bus. Sparks run along the edge of the live card,
 * an electric arc crackles on the top edge on hover. Closes with the quote (data-lit) and the CTA.
 * Gates: desktop = scrubbed fill + drift, sticky stack, tilt, index nav. Touch / <768px = fill plays once, vertical
 * cards (2 columns ≥700px) reveal once. Reduced = everything filled, drawn and lit, static. No JS = all visible.
 */
import { values, wa } from '../../data/site.js';

// 48×48 stroke icons (drawn with DrawSVG): gauge, stopwatch + bolt, shield + bolt, pin + ground rings
const icons = [
  '<path d="M8 33a16 16 0 1 1 32 0"/><path d="M24 13v4M12.7 17.7l2.8 2.8M35.3 17.7l-2.8 2.8M8 33h4M36 33h4"/><path d="M24 33l7-9"/><circle cx="24" cy="33" r="2.6"/><path d="M11 39h26"/>',
  '<circle cx="24" cy="27" r="15"/><path d="M20 6h8M24 6v6M35.5 14.5l3-3"/><path d="M26 17.5l-6.5 10.5h5.5l-1.5 8.5 6.5-10.5h-5.5l1.5-8.5Z"/>',
  '<path d="M24 5 9.5 10.5v11c0 9.4 6.3 17.4 14.5 20.5 8.2-3.1 14.5-11.1 14.5-20.5v-11L24 5Z"/><path d="M26 14l-7 11.5h6l-2 9 7-11.5h-6l2-9Z"/>',
  '<path d="M24 38s10.5-9.3 10.5-18.2a10.5 10.5 0 0 0-21 0C13.5 28.7 24 38 24 38Z"/><circle cx="24" cy="19.8" r="3.8"/><path d="M9 43.5c3.6-2.3 9-3.5 15-3.5s11.4 1.2 15 3.5"/>',
];
// 600×80 signal traces (xMinYMid slice: the key feature sits in the first 300 units so narrow cards keep it)
const traces = [
  { label: 'Medición', guides: 'M0 40H600M150 8V72M300 8V72', d: 'M0 40Q37.5 8 75 40T150 40T225 40T300 40T375 40T450 40T525 40T600 40' },
  { label: 'Reacción', guides: 'M0 44H600M196 8V72M252 8V72', d: 'M0 44H170L182 44L192 10L204 74L214 26L224 56L234 38L243 48L252 44H600' },
  { label: 'Protección', guides: 'M0 16H600M0 72H600', d: 'M0 44Q25 26 50 44T100 44L114 16H138L150 44L162 72H186L200 44Q225 26 250 44T300 44T350 44T400 44T450 44T500 44T550 44T600 44' },
  { label: 'Alcance', guides: 'M0 64H600', d: 'M0 58L50 34L115 52L180 22L245 44L290 40H600', nodes: [[50, 34], [115, 52], [180, 22], [245, 44]] },
];
// hover arc: 3 irregular jitters (seeded, so builds are stable) that flicker in turn along the top edge
const seeded = (seed) => () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const arcs = [11, 29, 47].map((seed) => {
  const r = seeded(seed);
  const pts = [];
  for (let x = 0; x < 400; x += 5 + r() * 11) pts.push(`${x.toFixed(1)},${(6 + (r() - 0.5) * (r() < 0.18 ? 11 : 5)).toFixed(1)}`);
  return [...pts, '400,6'].join(' ');
});
const waInspeccion = wa('Hola SSD&S, quiero agendar una inspección de mis instalaciones eléctricas.');
---
<section id="valores" class="section val" data-theme="dark" aria-labelledby="valores-title">
  <svg class="val__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="val-gi" gradientUnits="userSpaceOnUse" x1="6" y1="42" x2="42" y2="6"><stop offset="0" stop-color="#f26a1b" /><stop offset=".55" stop-color="#ff9c5c" /><stop offset="1" stop-color="#ffd79a" /></linearGradient>
      <linearGradient id="val-gt" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="600" y2="0"><stop offset="0" stop-color="#f26a1b" /><stop offset=".5" stop-color="#ff9c5c" /><stop offset="1" stop-color="#ffd79a" /></linearGradient>
    </defs>
  </svg>

  <!-- the bleed word: outline + gradient fill clipped on a diagonal edge driven by --p (0–100) -->
  <div class="val__band" aria-hidden="true">
    <div class="val__wordbox">
      <span class="val__word">Potencia</span>
      <span class="val__word val__word--fill">Potencia</span>
      <span class="val__ray"><i></i></span>
      <span class="val__scale"><span class="val__scale-on"></span></span>
    </div>
  </div>

  <div class="container val__grid">
    <header class="val__head">
      <p class="eyebrow">Por qué SSD&amp;S</p>
      <h2 id="valores-title" class="val__title" data-reveal="clip">Para que tu energía <span class="grad-text">nunca se detenga.</span></h2>
      <p class="val__lead" data-reveal="up" data-delay=".12">Garantizamos rigor técnico, respuesta oportuna y máxima seguridad en cada proyecto.</p>
      <nav class="val__nav" aria-label="Valores de SSD&S">
        <ol class="val__index" role="list">
          {values.map((v, i) => (
            <li><a href={`#valor-${i + 1}`}><span class="val__led" aria-hidden="true"></span><span class="val__i mono" aria-hidden="true">0{i + 1}</span><span>{v.t}</span></a></li>
          ))}
        </ol>
        <span class="val__bus" aria-hidden="true"><span></span></span>
      </nav>
    </header>

    <ol class="val__deck" role="list">
      {values.map((v, i) => (
        <li id={`valor-${i + 1}`} class="val__card stack-card" style={`--k:${i}`} tabindex="-1" data-glow>
          <div class="val__top">
            <span class="val__num" data-n={`0${i + 1}`} aria-hidden="true">0{i + 1}</span>
            <span class="val__icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="url(#val-gi)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={icons[i]} />
            </span>
          </div>
          <div class="val__scope" aria-hidden="true">
            <svg class="val__trace" viewBox="0 0 600 80" preserveAspectRatio="xMinYMid slice" focusable="false">
              <path class="tr-g" d={traces[i].guides} />
              <path class="tr" d={traces[i].d} />
              {traces[i].nodes?.map(([x, y]) => <circle class="tr tr-n" cx={x} cy={y} r="6" />)}
              <path class="tr-p tr-p--halo" d={traces[i].d} pathLength="1" />
              <path class="tr-p" d={traces[i].d} pathLength="1" />
            </svg>
            <span class="val__scope-tag mono">{traces[i].label}</span>
          </div>
          <div class="val__body">
            <h3 class="val__h">{v.t}</h3>
            <p class="val__text">{v.d}</p>
          </div>
          <span class="val__spark" aria-hidden="true"></span>
          <span class="val__spark val__spark--b" aria-hidden="true"></span>
          <svg class="val__arc" viewBox="0 0 400 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {arcs.map((pts) => <g><polyline class="val__arc-halo" points={pts} /><polyline points={pts} /></g>)}
          </svg>
        </li>
      ))}
    </ol>
  </div>

  <div class="container val__close">
    <div class="val__wire" aria-hidden="true"><span></span></div>
    <figure class="val__quote">
      <span class="val__qmark" aria-hidden="true"><i></i><i></i></span>
      <blockquote>
        <p data-lit>La ingeniería no es solo suministrar energía; es saber <em>distribuirla, automatizarla y protegerla.</em></p>
      </blockquote>
      <figcaption class="mono">SSD&amp;S · Potencia e Ingeniería Industrial</figcaption>
    </figure>
    <div class="val__cta" data-reveal="up">
      <p class="val__warn">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 2 20h20L12 3Z" /><path d="M12 10v4M12 17h.01" /></svg>
        No esperes a la falla para actuar.
      </p>
      <a class="btn btn--primary" href={waInspeccion} target="_blank" rel="noopener" data-magnetic>
        Agenda una inspección
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { onPage } from '../../scripts/engine.js';

  onPage(({ gsap, ScrollTrigger, env, scrollTo, onRefresh }) => {
    // scoped to this component: /nosotros/ has its own section#valores and this init runs on every page after home
    const root = document.querySelector('#valores.val');
    if (!root) return;
    const q = (s, el = root) => [...el.querySelectorAll(s)];
    const band = root.querySelector('.val__band');
    const cards = q('.val__card');
    const items = q('.val__index li');
    const last = cards.length - 1;

    // cumulative "power on": cards and LEDs up to i are on, i is the live one
    let cur = -2;
    const setCur = (i) => {
      if (i === cur) return;
      cur = i;
      cards.forEach((c, k) => { c.classList.toggle('is-on', k <= i); c.classList.toggle('is-current', k === i); });
      items.forEach((li, k) => { li.classList.toggle('is-on', k <= i); li.classList.toggle('is-cur', k === i); });
      root.style.setProperty('--lvl', String(Math.max(0, i) / last));
    };
    if (env.reduced) { setCur(last); return; } // final state: filled word (CSS), drawn strokes, all LEDs on

    const strokes = (c) => q('.val__icon :is(path, circle), .val__trace path.tr', c);
    const nodes = (c) => q('.tr-n', c);
    cards.forEach((c) => { gsap.set(strokes(c), { drawSVG: '0%' }); const n = nodes(c); if (n.length) gsap.set(n, { scale: 0, transformOrigin: '50% 50%' }); });
    // draw(i) powers the strokes on; draw(i, false) discharges them (scroll back past a card on desktop)
    const drawn = new Set();
    const draw = (i, on = true) => {
      if (drawn.has(i) === on) return;
      if (on) drawn.add(i); else drawn.delete(i);
      const n = nodes(cards[i]);
      if (on) {
        gsap.to(strokes(cards[i]), { drawSVG: '100%', duration: 1.3, ease: 'power2.inOut', stagger: 0.07, delay: 0.1, overwrite: true });
        if (n.length) gsap.to(n, { scale: 1, duration: 0.5, ease: 'back.out(3)', stagger: 0.12, delay: 0.55, overwrite: true });
      } else {
        gsap.to(strokes(cards[i]), { drawSVG: '0%', duration: 0.45, ease: 'power2.in', stagger: { each: 0.03, from: 'end' }, overwrite: true });
        if (n.length) gsap.to(n, { scale: 0, duration: 0.25, ease: 'power2.in', overwrite: true });
      }
    };

    // idle loops (sparks, pulses, comets) only tick while the section / card is on screen
    const io = new IntersectionObserver((entries) => entries.forEach((e) => e.target.classList.toggle(e.target === root ? 'is-live' : 'is-vis', e.isIntersecting)));
    io.observe(root);

    if (env.desktop) {
      gsap.timeline({ scrollTrigger: { trigger: band, start: 'top 92%', end: 'bottom 22%', scrub: 0.5 } })
        .fromTo(band, { '--p': 0 }, { '--p': 100, ease: 'none' }, 0)
        .fromTo(root.querySelector('.val__wordbox'), { xPercent: 3 }, { xPercent: -5, ease: 'none' }, 0);

      // each card rises tilted back and stands up as it reaches its sticky slot; engine .stack-card shrinks the one below
      const stickTop = (card) => parseFloat(getComputedStyle(card).top) || 0;
      const lead = () => innerHeight * 0.3;
      const sts = cards.map((card, i) => {
        gsap.fromTo(card, { rotationX: 9, transformPerspective: 1600 }, {
          rotationX: 0, ease: 'none',
          scrollTrigger: { trigger: card, start: 'top bottom', end: () => `top ${stickTop(card)}px`, scrub: true },
        });
        return ScrollTrigger.create({
          trigger: card,
          start: () => `top ${stickTop(card) + lead()}px`,
          onEnter: () => { setCur(i); draw(i); },
          onLeaveBack: () => { setCur(i - 1); draw(i, false); },
        });
      });

      // the sticky head releases on the same frame as the stack (its margin-bottom = the height gap), measured once per refresh
      const head = root.querySelector('.val__head');
      const syncHead = () => {
        head.style.marginBottom = '';
        const c = cards[0];
        const gap = stickTop(c) + c.offsetHeight + parseFloat(getComputedStyle(c).marginBottom) - stickTop(head) - head.offsetHeight;
        head.style.marginBottom = `${Math.max(0, gap)}px`;
      };
      onRefresh(syncHead);
      syncHead();

      // index LEDs jump to the moment each card lands in its slot (sticky cards can't be anchor targets)
      const nav = root.querySelector('.val__index');
      const onNav = (e) => {
        const a = e.target.closest('a');
        if (!a) return;
        const i = items.indexOf(a.parentElement);
        if (i < 0) return;
        e.preventDefault();
        scrollTo(sts[i].start + lead() + 2, { offset: 0 });
        cards[i].focus({ preventScroll: true });
      };
      nav.addEventListener('click', onNav);
      return () => { io.disconnect(); nav.removeEventListener('click', onNav); head.style.marginBottom = ''; };
    }

    // touch / narrow: everything plays once on entry
    gsap.to(band, { '--p': 100, duration: 2.2, ease: 'power2.inOut', scrollTrigger: { trigger: band, start: 'top 85%', once: true } });
    cards.forEach((card, i) => {
      io.observe(card);
      gsap.fromTo(card, { y: 48, opacity: 0 }, {
        y: 0, opacity: 1, duration: 1, ease: 'expo.out', clearProps: 'transform',
        scrollTrigger: { trigger: card, start: 'top 88%', once: true, onEnter: () => { card.classList.add('is-on'); draw(i); } },
      });
    });
    return () => io.disconnect();
  });
</script>

<style>
  .val { overflow: clip; padding-block: clamp(40px, 6vw, 96px) var(--section-y); }
  .val::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(55% 30% at 100% 38%, rgba(37, 72, 138, 0.32), transparent 70%),
      radial-gradient(45% 30% at 0% 70%, rgba(26, 52, 104, 0.4), transparent 70%);
  }
  .val__defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* ================= bleed word ================= */
  .val__band { --p: 100; position: relative; display: flex; justify-content: center; margin-bottom: clamp(48px, 7vw, 104px); }
  :global(.js) .val__band { --p: 0; }
  .val__wordbox { position: relative; flex: none; font-size: 19.5vw; line-height: 0.8; will-change: transform; }
  .val__word {
    display: block; font-family: var(--font-display); font-weight: 800; letter-spacing: -0.045em; text-transform: uppercase;
    white-space: nowrap; padding-inline: 0.02em; user-select: none;
    /* variable fonts keep overlapping contours: paint the stroke first and cover its inner half with the bg */
    color: var(--navy-900); -webkit-text-stroke: 3px rgba(255, 255, 255, 0.2); paint-order: stroke fill;
  }
  .val__word--fill {
    /* box grown .12em up and down (line-height grown by the same .24em keeps the baseline) so background-clip:text
       also paints the round glyph overshoot that pokes out of the .8 line box */
    position: absolute; inset: -0.12em 0; line-height: 1.04; -webkit-text-stroke: 3px transparent; color: transparent;
    background: linear-gradient(100deg, #e0560e 0%, #f26a1b 22%, #ff9c5c 55%, #ffd79a 100%);
    -webkit-background-clip: text; background-clip: text;
    /* diagonal edge leaning like the brand ray (20.5°): bottom at x, top at x + 1.04em·tan(20.5°) */
    clip-path: polygon(-2% 0, calc(var(--p) * 1.12% - 12% + 0.39em) 0, calc(var(--p) * 1.12% - 12%) 100%, -2% 100%);
  }
  .val__ray {
    position: absolute; inset: 0; pointer-events: none;
    transform: translateX(calc(var(--p) * 1.12% - 12%));
    opacity: clamp(0, min(var(--p), 100 - var(--p)) * 0.25, 1);
    will-change: transform;
  }
  .val__ray i {
    position: absolute; left: 0.195em; top: 50%; width: 3px; height: 1.2em; margin: -0.6em 0 0 -1.5px;
    transform: rotate(20.5deg); border-radius: 3px;
    background: linear-gradient(180deg, transparent, rgba(255, 215, 154, 0.9) 28%, #fff 50%, rgba(255, 156, 92, 0.9) 72%, transparent);
    box-shadow: 0 0 14px 3px rgba(255, 140, 60, 0.55), 0 0 44px 10px rgba(255, 110, 30, 0.25);
  }
  /* meter scale under the word: dim ticks, lit ticks follow the fill edge, a comet runs along it while on screen */
  .val__scale { position: absolute; left: 0; right: 0; top: 100%; margin-top: 0.07em; height: clamp(8px, 1.2vw, 16px); overflow: hidden; }
  .val__scale, .val__scale-on {
    background:
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 12.5%) 0 0 / 100% 100% no-repeat,
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 2.5%) 0 100% / 100% 45% no-repeat;
  }
  .val__scale { --tick: rgba(255, 255, 255, 0.18); }
  .val__scale-on { --tick: #ffb454; position: absolute; inset: 0; clip-path: inset(0 calc(112% - var(--p) * 1.12%) 0 0); }
  .val__scale::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent 0 86%, rgba(255, 156, 92, 0.8) 95%, #fff 99.5%, transparent);
    transform: translateX(-100%); animation: val-run 6.5s cubic-bezier(0.55, 0, 0.35, 1) infinite paused;
  }
  .val.is-live .val__scale::after { animation-play-state: running; }

  /* ================= head ================= */
  .val__grid { display: grid; gap: clamp(32px, 5vw, 56px); }
  .val__head { max-width: 40rem; }
  .val__title { font-size: clamp(2rem, 1.05rem + 3vw, 3.9rem); max-width: 13ch; }
  .val__title .grad-text { padding-right: 0.06em; }
  .val__lead { margin-top: clamp(16px, 2vw, 24px); font-size: var(--step-1); line-height: 1.45; color: var(--muted); max-width: 34ch; }
  .val__nav { display: none; position: relative; margin-top: clamp(20px, 3.4vh, 36px); }
  .val__index { list-style: none; display: grid; }
  .val__index a {
    display: flex; align-items: center; gap: 14px; min-height: 44px; padding-right: 8px;
    color: var(--muted); font-weight: 500; font-size: 0.98rem; transition: color 0.4s;
  }
  .val__index a:hover, .val__index .is-cur a { color: var(--fg); }
  .val__i { font-size: 0.75rem; color: color-mix(in srgb, var(--muted) 70%, transparent); transition: color 0.4s; }
  .val__index .is-on .val__i { color: var(--accent-text); }
  .val__led {
    position: relative; z-index: 1; flex: none; width: 14px; height: 14px; border-radius: 50%;
    background: var(--navy-900); border: 2px solid rgba(255, 255, 255, 0.24);
    transition: background-color 0.4s, border-color 0.4s, box-shadow 0.5s;
  }
  .val__index .is-on .val__led { background: var(--orange-500); border-color: var(--glow); box-shadow: 0 0 12px 2px rgba(255, 140, 60, 0.65); }
  .val__led::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--orange-400); opacity: 0; }
  .val__index .is-cur .val__led::after { animation: val-ping 1.8s var(--ease-out) infinite paused; }
  .val.is-live .val__index .is-cur .val__led::after { animation-play-state: running; }
  /* the bus: a conductor behind the LEDs that charges with the stack */
  .val__bus { position: absolute; left: 6px; top: 22px; bottom: 22px; width: 2px; background: rgba(255, 255, 255, 0.1); border-radius: 2px; }
  .val__bus span { position: absolute; inset: 0; background: var(--grad-brand-v); transform-origin: 50% 0; transform: scaleY(var(--lvl, 0)); transition: transform 0.7s var(--ease-out); box-shadow: 0 0 8px rgba(255, 140, 60, 0.6); }

  /* ================= cards ================= */
  .val__deck { list-style: none; display: grid; gap: 16px; }
  .val__card {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; grid-template-rows: auto auto 1fr; gap: clamp(14px, 2vh, 22px); /* body takes the slack: titles align across a row */
    padding: clamp(20px, 2.6vw, 36px);
    border-radius: var(--radius-lg); border: 1px solid rgba(255, 255, 255, 0.09);
    background:
      radial-gradient(110% 80% at 100% 0%, rgba(242, 106, 27, 0.12), transparent 55%),
      linear-gradient(165deg, #14295a 0%, #0f2149 55%, #0b1938 100%);
    box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.07);
    transition: border-color 0.4s;
  }
  .val__card:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .val__top, .val__scope, .val__body { position: relative; z-index: 1; }
  @media (hover: hover) { .val__card:hover { border-color: rgba(255, 140, 60, 0.4); } }

  .val__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .val__num {
    position: relative; font-family: var(--font-display); font-weight: 800; line-height: 0.8; letter-spacing: -0.06em;
    font-size: clamp(3.6rem, 2.6rem + 3.8vw, 7rem); padding-right: 0.06em;
    color: #14295a; -webkit-text-stroke: 3px rgba(255, 255, 255, 0.24); paint-order: stroke fill;
  }
  .val__num::after {
    content: attr(data-n); position: absolute; inset: -0.12em 0; line-height: 1.04; -webkit-text-stroke: 3px transparent; paint-order: stroke fill;
    background: var(--grad-brand-v); -webkit-background-clip: text; background-clip: text; color: transparent;
    clip-path: inset(110% -10% -20% -10%); transition: clip-path 1.2s var(--ease-out) 0.15s;
  }
  .val__icon {
    flex: none; display: grid; place-items: center; width: clamp(56px, 5vw, 72px); aspect-ratio: 1; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12); background: radial-gradient(circle, rgba(242, 106, 27, 0.16), transparent 70%);
    transition: border-color 0.6s, box-shadow 0.6s, transform 0.6s var(--ease-out);
  }
  .val__icon { position: relative; }
  .val__icon svg { width: 58%; height: auto; }
  .val__icon::before {
    content: ''; position: absolute; inset: -7px; border-radius: 50%; border: 1px dashed rgba(255, 180, 84, 0.45);
    opacity: 0; transition: opacity 0.6s; animation: val-spin 14s linear infinite paused;
  }
  .val__card.is-on .val__icon::before { opacity: 1; }
  @media (hover: hover) { .val__card:hover .val__icon { transform: rotate(-8deg) scale(1.06); } }

  /* signal trace: a small oscilloscope strip */
  .val__scope {
