---
/*
  #instagram · "Señal en vivo" · dark. The 14 real posts as a live feed.
  Header: the handle is "written" by a spark (clip + travelling glint); story ring spins around the isotype.
  Wire: a marquee of brand claims between two conductors, an electron runs along the top one.
  Grid: `limit` posts, every other column dropped (masonry rhythm). Each card "powers on" as it enters: it rises,
  a diagonal orange ray crosses it and the dark veil lifts. Idle: every few seconds a diagonal ray wave crosses the
  whole grid (the brand motif). Hover (fine pointer): photo zoom, meta panel slides up, the ray sweeps, the brand
  edge lights, tilt. Desktop gate: even columns drift on scroll (parallax), pointer glow behind the grid.
  "Ver las 14 publicaciones" shows the rest at once and powers them on as their photos are ready. Cards open the lightbox (ui/Lightbox.astro +
  scripts/lightbox.js); without JS they are links to Instagram and every post is listed.
  Reduced motion: no pre-hide, no entrance, no wave, no parallax, lightbox without morph.
  Props: limit (home 8, Nosotros 4).
*/
import Icon from '../ui/Icon.astro';
import Lightbox from '../ui/Lightbox.astro';
import Logo from '../chrome/Logo.astro';
import { brand, posts, postUrl, social, contact, claims, wa } from '../../data/site.js';
interface Props { limit?: number }
const { limit = 8 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shown = Math.max(1, Math.min(limit, posts.length));
const extra = posts.length - shown;
const day = (d: string, month: 'short' | 'long') => new Date(d + 'T12:00:00').toLocaleDateString('es-VE', { day: 'numeric', month, year: 'numeric' });
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="ig section" id="instagram" data-theme="dark" aria-labelledby="ig-title">
  <div class="ig__bg" aria-hidden="true">
    <div class="ig__rays"><span class="streak ig__ray ig__ray--a"></span><span class="streak ig__ray ig__ray--b"></span></div>
  </div>

  <div class="container ig__head">
    <p class="eyebrow" data-reveal="left">Instagram</p>
    <h2 id="ig-title" class="ig__title">
      <span class="ig__lead" data-split="words">Lo que publicamos en</span>
      <span class="ig__handle"><span class="ig__handle-t">@{contact.instagram}</span><span class="ig__spark" aria-hidden="true"></span></span>
    </h2>
    <div class="ig__row" data-reveal="up" data-delay=".15">
      <div class="ig__profile">
        <span class="ig__ring" aria-hidden="true"><Logo variant="mark" size={30} /></span>
        <p class="ig__who"><strong>{brand.name}</strong><span class="mono">{posts.length} publicaciones<span class="ig__tag"> · {brand.tagline}</span></span></p>
      </div>
      <a class="btn btn--primary ig__follow" href={social.instagram} target="_blank" rel="noopener" data-magnetic>
        <Icon name="instagram" size={20} />Seguir en Instagram<Icon name="arrowUpRight" size={18} class="arrow" />
      </a>
    </div>
  </div>

  <div class="ig__wire marquee" data-speed="0.4">
    <div class="marquee__track">
      {claims.map((c) => <span class="ig__claim mono"><Icon name="bolt" size={14} />{c}</span>)}
    </div>
  </div>

  <ul class="ig__grid container" id="ig-grid" role="list" data-glow>
    {posts.map((p, i) => (
      <li class:list={['ig__item', i >= shown && 'ig__item--more']}>
        <a
          class="ig__card" href={postUrl(p.code)} target="_blank" rel="noopener" data-lightbox data-tilt="4"
          data-title={p.title} data-date={day(p.date, 'long')} data-datetime={p.date} data-text={p.text} data-reel={p.reel ? '' : undefined}
          aria-label={`${p.title} · ${day(p.date, 'long')}${p.reel ? ' · Reel' : ''}`}
        >
          <img
            src={`${base}/ig/${p.code}.webp`} srcset={`${base}/ig/${p.code}-320.webp 320w, ${base}/ig/${p.code}.webp 640w`}
            sizes="(min-width: 900px) min(22vw, 290px), 46vw"
            width="640" height="811" alt="" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" draggable="false"
          />
          <span class="ig__veil"></span>
          <span class="ig__sweep"></span>
          <span class="ig__edge"></span>
          {(p.reel || i === 0) && (
            <span class="ig__top" aria-hidden="true">
              {p.reel && <span class="ig__chip ig__chip--reel mono"><Icon name="play" size={10} />Reel</span>}
              {i === 0 && <span class="ig__chip ig__chip--new mono"><i></i>Reciente</span>}
            </span>
          )}
          <span class="ig__zoom" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M10 20H4v-6M20 4l-6.5 6.5M4 20l6.5-6.5" /></svg>
          </span>
          <span class="ig__meta" aria-hidden="true">
            <span class="ig__date mono"><b>{pad(i + 1)}</b>{day(p.date, 'short').replace(/\s\d{4}$/, '')}<span class="ig__year">{p.date.slice(0, 4)}</span></span>
            <span class="ig__name">{p.title}</span>
            <span class="ig__text">{p.text}</span>
          </span>
        </a>
      </li>
    ))}
    <li class:list={['ig__item', 'ig__end', extra > 0 && 'ig__item--more']}>
      <div class="ig__endcard">
        <span class="streak ig__endray" aria-hidden="true"></span>
        <span class="ig__endring" aria-hidden="true"><Logo variant="mark" size={34} /></span>
        <p class="ig__endtitle">Sigue a tu solución industrial.</p>
        <p class="ig__endtext">Síguenos en Instagram o escríbenos por WhatsApp para asesorías directas o cotizaciones.</p>
        <div class="ig__endcta">
          <a class="btn btn--primary btn--sm" href={social.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} />Seguir en Instagram</a>
          <a class="btn btn--ghost btn--sm" href={wa('Hola SSD&S, vi sus publicaciones en Instagram y quiero más información.')} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
        </div>
      </div>
    </li>
  </ul>

  {extra > 0 && (
    <div class="container ig__foot">
      <button class="ig__more" type="button" aria-expanded="false" aria-controls="ig-grid" hidden>
        <span>Ver las {posts.length} publicaciones</span>
        <span class="ig__cells" aria-hidden="true">{posts.map((_, k) => <i class:list={[k < shown && 'is-on']} />)}</span>
        <span class="ig__plus mono" aria-hidden="true">+{extra}</span>
      </button>
    </div>
  )}
  <p class="sr-only" aria-live="polite" data-ig-status></p>

  <Lightbox id="ig-lightbox" handle={contact.instagram} src={`${base}/ig/${posts[0].code}.webp`} />
</section>

<script>
  import { onPage } from '../../scripts/engine.js';
  import { initLightbox } from '../../scripts/lightbox.js';

  onPage(({ gsap, ScrollTrigger, env, getLenis, onRefresh }) => {
    const root = document.getElementById('instagram');
    if (!root) return;
    const grid = root.querySelector('.ig__grid');
    const all = [...grid.children];
    const items = all.filter((li) => li.querySelector('.ig__card'));
    const cards = items.map((li) => li.querySelector('.ig__card'));
    const tile = grid.querySelector('.ig__end');
    const more = root.querySelector('.ig__more');
    const status = root.querySelector('[data-ig-status]');
    const dlg = root.querySelector('.lb');
    const part = (els, sel) => els.map((li) => li.querySelector(sel)).filter(Boolean);
    const destroyLightbox = initLightbox(dlg, cards, { gsap, env, getLenis });

    /* ---------- "power on": rise, the ray crosses, the veil lifts ---------- */
    const done = new WeakSet();
    const powerOn = (els, delay = 0) => {
      els = els.filter((el) => !done.has(el));
      if (!els.length) return;
      els.forEach((el) => done.add(el));
      const st = { each: 0.09, from: 'start' };
      gsap.timeline({ delay })
        .fromTo(els, { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 1.1, ease: 'expo.out', stagger: st, clearProps: 'transform' }, 0)
        .fromTo(part(els, 'img'), { scale: 1.18 }, { scale: 1, duration: 1.5, ease: 'expo.out', stagger: st, clearProps: 'transform' }, 0)
        .fromTo(part(els, '.ig__sweep'), { xPercent: -72 }, { xPercent: 72, duration: 1, ease: 'power2.inOut', stagger: st, clearProps: 'transform' }, 0.12)
        .fromTo(part(els, '.ig__veil'), { opacity: 0.92 }, { opacity: 0, duration: 0.8, ease: 'power2.out', stagger: st }, 0.4);
    };
    const initial = all.filter((li) => !li.classList.contains('ig__item--more'));
    if (!env.reduced) {
      const run = (batch) => powerOn(batch);
      ScrollTrigger.batch(initial, { start: 'top 92%', onEnter: run, onEnterBack: run });
    }

    /* ---------- header: the spark writes the handle ---------- */
    const handle = root.querySelector('.ig__handle');
    const handleT = root.querySelector('.ig__handle-t');
    const spark = root.querySelector('.ig__spark');
    if (!env.reduced) {
      gsap.timeline({ scrollTrigger: { trigger: handle, start: 'top 88%', once: true }, delay: 0.3 })
        .set(spark, { opacity: 1, x: 0 })
        .fromTo(handleT, { clipPath: 'inset(-10% 100% -10% 0)' }, { clipPath: 'inset(-10% 0% -10% 0)', duration: 1.25, ease: 'power3.inOut' }, 0)
        .to(spark, { x: () => handle.offsetWidth, duration: 1.25, ease: 'power3.inOut' }, 0)
        .to(spark, { opacity: 0, duration: 0.35 }, '>-0.1');
    }

    /* ---------- desktop: columns drift at two depths, background rays travel ---------- */
    if (env.desktop) {
      const scrub = { trigger: grid, start: 'top bottom', end: 'bottom top', scrub: 0.8 };
      gsap.fromTo([...cards.filter((_, k) => k % 2), tile?.firstElementChild].filter(Boolean), { y: 44 }, { y: -44, ease: 'none', scrollTrigger: { ...scrub } });
      gsap.fromTo(cards.filter((_, k) => !(k % 2)), { y: -14 }, { y: 14, ease: 'none', scrollTrigger: { ...scrub } });
      gsap.fromTo(root.querySelector('.ig__rays'), { xPercent: -18 }, { xPercent: 18, ease: 'none', scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true } });
    }

    /* ---------- idle: a diagonal ray wave crosses the grid every few seconds ---------- */
    // the wave's per-card delay depends only on the index and the column count: set it on refresh, never mid-scroll
    let cols = 0, waveT = 0, inView = false;
    const measure = () => {
      const c = getComputedStyle(grid).gridTemplateColumns.split(' ').length || 2;
      if (c === cols) return;
      cols = c;
      cards.forEach((card, k) => card.style.setProperty('--pd', `${((k % cols) + Math.floor(k / cols)) * 0.12}s`));
    };
    measure();
    onRefresh(measure);
    // no layout reads here: only powered-on cards can be visible (hidden "more" cards power on only once shown)
    const wave = () => {
      if (inView && !document.hidden && !dlg.open) items.forEach((li, k) => { if (done.has(li)) cards[k].classList.add('is-pulse'); });
      waveT = setTimeout(wave, 6500);
    };
    const onEnd = (e) => { if (e.target.classList.contains('ig__sweep')) e.target.parentElement.classList.remove('is-pulse'); };
    let io;
    if (!env.reduced) {
      grid.addEventListener('animationend', onEnd);
      io = new IntersectionObserver(([e]) => {
        inView = e.isIntersecting;
        clearTimeout(waveT);
        if (inView) waveT = setTimeout(wave, 2600);
      }, { threshold: 0.2 });
      io.observe(grid);
    }

    /* ---------- "Ver las 14": the grid grows in the click task (a shift right after an input is not CLS), the new
       cards stay dark (opacity 0) until their photos are decoded (max 450 ms), then they power on. Intent (hover,
       focus, press; the hover also charges the meter cells) starts the photo downloads early. ---------- */
    const rest = all.filter((li) => li.classList.contains('ig__item--more'));
    const restImgs = part(rest, 'img');
    let alive = true, fetched = false;
    const prefetch = () => {
      if (fetched) return;
      fetched = true;
      restImgs.forEach((im) => { im.loading = 'eager'; });
    };
    const reveal = () => {
      prefetch();
      more.setAttribute('aria-expanded', 'true');
      more.disabled = true;
      rest.forEach((li) => li.classList.add('is-on'));
      rest[0]?.querySelector('a')?.focus({ preventScroll: true });
      more.closest('.ig__foot').hidden = true;
      status.textContent = `Se muestran las ${items.length} publicaciones.`;
      requestAnimationFrame(() => ScrollTrigger.refresh());
      if (env.reduced) return;
      const ready = Promise.all(restImgs.map((im) => im.decode().catch(() => {})));
      Promise.race([ready, new Promise((r) => setTimeout(r, 450))]).then(() => { if (alive) powerOn(rest); });
    };
    if (more && rest.length) {
      more.hidden = false;
      more.addEventListener('click', reveal);
      ['pointerenter', 'pointerdown', 'focus'].forEach((ev) => more.addEventListener(ev, prefetch, { once: true }));
    }

    return () => {
      alive = false;
      destroyLightbox();
      clearTimeout(waveT);
      io?.disconnect();
      grid.removeEventListener('animationend', onEnd);
      more?.removeEventListener('click', reveal);
      ['pointerenter', 'pointerdown', 'focus'].forEach((ev) => more?.removeEventListener(ev, prefetch));
    };
  });
</script>

<style>
  .ig {
    --ig-off: clamp(18px, 3.6vw, 64px);
    background: var(--navy-950); overflow: clip;
  }

  /* ---------- background: schematic grid, glows, two brand rays ---------- */
  .ig__bg {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
    background:
      radial-gradient(55% 45% at 88% 6%, rgba(242, 106, 27, 0.14), transparent 70%),
      radial-gradient(45% 40% at 4% 96%, rgba(37, 72, 138, 0.4), transparent 70%);
  }
  .ig__bg::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(70% 55% at 50% 38%, #000, transparent 75%); mask-image: radial-gradient(70% 55% at 50% 38%, #000, transparent 75%);
  }
  .ig__rays { position: absolute; inset: 0; }
  .ig__ray--a { top: 30%; --angle: -13deg; --streak-opacity: 0.45; }
  .ig__ray--b { top: 72%; --angle: -13deg; --streak-opacity: 0.22; }

  /* ---------- header ---------- */
  .ig__head { container-type: inline-size; display: grid; }
  .ig__title { display: grid; font-size: clamp(1.7rem, 1.2rem + 2vw, 3rem); letter-spacing: -0.03em; }
  .ig__lead { display: block; color: color-mix(in srgb, var(--fg) 88%, transparent); }
  /* the handle is one 21-character word: sized to the container (cqi) so it never overflows */
  .ig__handle {
    position: relative; display: block; width: max-content; max-width: 100%;
    margin-top: 0.08em; font-size: min(2.35em, 8.9cqi); line-height: 1.08; font-weight: 800; font-style: italic;
    letter-spacing: -0.045em; white-space: nowrap;
  }
  .ig__handle-t {
    display: block; padding: 0 0.12em 0.1em 0; /* room for the italic overhang inside the clip */
    background: linear-gradient(100deg, #f26a1b 0%, #ff9c5c 38%, #ffd79a 62%, #ff9c5c 82%, #f26a1b 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .ig__spark {
    position: absolute; left: 0; top: 4%; bottom: 8%; width: 3px; border-radius: 3px; opacity: 0; pointer-events: none;
    background: linear-gradient(180deg, transparent, #fff 30%, var(--glow) 70%, transparent);
    box-shadow: 0 0 14px 4px rgba(255, 170, 80, 0.85), 0 0 40px 10px rgba(242, 106, 27, 0.45);
  }
  /* the arc flash at the tip */
  .ig__spark::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 0.9em; height: 0.9em; translate: -50% -50%; border-radius: 50%;
    background: radial-gradient(circle, #fff 0 6%, rgba(255, 215, 154, 0.9) 12%, rgba(242, 106, 27, 0.35) 34%, transparent 66%);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ig__handle-t { clip-path: inset(-10% 100% -10% 0); }
  }

  .ig__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; margin-top: clamp(22px, 3vw, 34px); }
  .ig__profile { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .ig__ring { position: relative; flex: none; display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; }
  .ig__ring::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 0deg, #f26a1b, #ffd79a 25%, #ff7d33 50%, rgba(242, 106, 27, 0.15) 70%, #f26a1b);
    animation: ig-spin 4.5s linear infinite;
  }
  .ig__ring::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--navy-900); box-shadow: inset 0 0 0 2px var(--navy-950); }
  .ig__ring :global(.logo) { position: relative; z-index: 1; }
  @keyframes ig-spin { to { transform: rotate(1turn); } }
  .ig__who { display: grid; gap: 2px; min-width: 0; }
  .ig__who strong { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; }
  .ig__who .mono { font-size: 0.75rem; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 559px) { .ig__follow { flex: 1 1 100%; } .ig__tag { display: none; } }

  /* ---------- the wire (marquee between two conductors) ---------- */
  .ig__wire {
    position: relative; margin-top: clamp(40px, 5vw, 64px);
    border-block: 1px solid rgba(255, 255, 255, 0.09);
    background: linear-gradient(90deg, rgba(242, 106, 27, 0.05), rgba(255, 255, 255, 0.015), rgba(242, 106, 27, 0.05));
  }
  .ig__wire::before {
    content: ''; position: absolute; top: -1px; left: 0; width: 140px; height: 2px; pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--orange-400) 60%, #fff);
    box-shadow: 0 0 12px 2px rgba(255, 140, 60, 0.7);
    animation: ig-electron 5.5s linear infinite;
  }
  @keyframes ig-electron { from { transform: translateX(-160px); } to { transform: translateX(100vw); } }
  .ig__claim {
    display: inline-flex; align-items: center; gap: 12px; padding: 15px 22px 15px 0; white-space: nowrap;
    font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .ig__claim :global(svg) { color: var(--orange-400); }

  /* ---------- grid ---------- */
  .ig__grid {
    position: relative; list-style: none; margin-block: clamp(36px, 5vw, 64px) 0; padding: 0 0 var(--ig-off);
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px);
  }
  @media (min-width: 900px) { .ig__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  /* pointer light behind the cards (engine sets --gx/--gy on [data-glow], desktop only) */
  .ig__grid[data-glow]::before {
    inset: -80px; border-radius: 0;
    background: radial-gradient(520px circle at calc(var(--gx) + 80px) calc(var(--gy) + 80px), rgba(255, 140, 60, 0.16), transparent 60%);
  }
  .ig__item { position: relative; }
  .ig__item:nth-child(even) { translate: 0 var(--ig-off); }
  :global(.js) .ig__item--more:not(.is-on) { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ig__item { opacity: 0; }
  }

  /* ---------- card ---------- */
  .ig__card {
    position: relative; display: block; aspect-ratio: 640 / 811; border-radius: var(--radius); overflow: hidden; isolation: isolate;
    background: var(--navy-800); color: var(--white); container-type: inline-size;
    box-shadow: 0 28px 50px -30px rgba(0, 0, 0, 0.9);
    transition: box-shadow 0.6s var(--ease-out);
  }
  .ig__card:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .ig__card img { width: 100%; height: 100%; object-fit: cover; transition: scale 1.2s var(--ease-out), opacity 0.2s; }
  .ig__card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08); pointer-events: none; }
  .ig__veil { position: absolute; inset: 0; background: var(--navy-950); opacity: 0; pointer-events: none; }
  /* the brand ray: a thin diagonal line with an orange falloff, parked off-card on the left */
  .ig__sweep {
    position: absolute; inset: -10% -60%; pointer-events: none; transform: translateX(-72%);
    background: linear-gradient(115deg, transparent 43%, rgba(242, 106, 27, 0.18) 47%, rgba(255, 156, 92, 0.75) 49.4%, #fff4df 50%, rgba(255, 156, 92, 0.75) 50.6%, rgba(242, 106, 27, 0.18) 53%, transparent 57%);
  }
  .ig__edge {
    position: absolute; inset: 0; border-radius: inherit; padding: 1.5px; pointer-events: none; opacity: 0;
    background: linear-gradient(135deg, #ffd79a, #f26a1b 40%, rgba(242, 106, 27, 0.1) 70%, #ff9c5c);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    transition: opacity 0.5s;
  }
  .ig__card.is-pulse .ig__sweep { animation: ig-sweep 1.25s cubic-bezier(0.65, 0, 0.35, 1) var(--pd, 0s) both; }
  @keyframes ig-sweep { from { transform: translateX(-72%); } to { transform: translateX(72%); } }
  .ig__card.is-lifted img, .ig__card.is-lifted > span { opacity: 0; transition: none; }

  .ig__top { position: absolute; top: 10px; left: 10px; right: 50px; display: flex; flex-wrap: wrap; gap: 6px; pointer-events: none; }
  .ig__chip {
    display: inline-flex; align-items: center; gap: 5px; height: 26px; padding: 0 10px; border-radius: var(--r-pill);
    background: rgba(6, 13, 31, 0.72); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: #fff;
  }
  .ig__chip--reel { background: var(--orange-500); box-shadow: 0 6px 16px -6px rgba(242, 106, 27, 0.9); }
  /* live dot: the ring is a pseudo-element that only scales and fades (compositor, no repaint per frame) */
  .ig__chip--new i { position: relative; width: 6px; height: 6px; border-radius: 50%; background: var(--ok); }
  .ig__chip--new i::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; background: rgba(61, 220, 132, 0.6);
    animation: ig-live 2s ease-out infinite;
  }
  @keyframes ig-live { from { transform: scale(1); opacity: 1; } 70%, to { transform: scale(3.3); opacity: 0; } }
  .ig__zoom {
    position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    background: var(--orange-500); color: #fff; box-shadow: 0 8px 20px -8px rgba(242, 106, 27, 0.9);
    opacity: 0; scale: 0.5; transition: opacity 0.3s, scale 0.5s var(--ease-spring);
  }

  .ig__meta {
    position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: 6px; padding: 56px 16px 16px; pointer-events: none;
