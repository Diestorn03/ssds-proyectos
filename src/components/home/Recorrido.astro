---
/**
 * #recorrido · El Recorrido (the process: 01 Evaluación → 04 Mantenimiento) · light.
 * Desktop gate (scripts/recorrido.js adds .rc--pin): the stage pins and the track slides sideways; an orange→gold
 * cable fills ahead of the reader with a crackling tip, a branch shoots up into each station as the tip passes and
 * the station "se conecta" (LED on, number charges, the brand ray sweeps its photo), the HUD reads "Etapa 0X / 04".
 * Touch / narrow: native scroll-snap row, static cable, each card connects once when half in view.
 * Reduced motion / no JS: everything drawn connected; desktop + reduced = wrapping grid.
 * The <ol> is the content; cable, tip, HUD and bursts are decorative (aria-hidden).
 */
import Icon from '../ui/Icon.astro';
import { process, postUrl, wa } from '../../data/site.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const visuals: Record<string, { icon: 'gauge' | 'layers' | 'transformer' | 'wrench'; code: string; chip: string; alt: string }> = {
  '01': { icon: 'gauge', code: 'DdMYUkREepK', chip: 'Inspección técnica', alt: 'Mano con un multímetro naranja midiendo una instalación. Pieza de SSD&S: ¿Tu empresa necesita baja o media tensión?' },
  '02': { icon: 'layers', code: 'DdeXN0Ckbm8', chip: 'A la carga exacta', alt: 'Tablero con contactores y cableado de una transferencia. Pieza de SSD&S: Transferencia manual o automática.' },
  '03': { icon: 'transformer', code: 'DdmM5JnRQUK', chip: 'Protocolos estrictos', alt: 'Tablero eléctrico abierto con breakers y conductores. Pieza de SSD&S: Precisión en redes de media tensión.' },
  '04': { icon: 'wrench', code: 'Ddt6o2VkdoJ', chip: 'Preventivo y correctivo', alt: 'Gabinete de una planta eléctrica al aire libre. Pieza de SSD&S: Cuatro consumibles esenciales.' },
};
const stations = process.map((s) => ({ ...s, ...visuals[s.n], src: `${base}/ig/${visuals[s.n].code}.webp`, href: postUrl(visuals[s.n].code) }));
const wave = 'M0 18 Q15 3 30 18 T60 18 T90 18 T120 18 T150 18 T180 18 T210 18 T240 18 T270 18 T300 18 T330 18 T360 18 T390 18 T420 18 T450 18 T480 18 T510 18 T540 18 T570 18 T600 18 T630 18 T660 18'; // one sine period = 60 units, long enough for any body width
const sparks = [-160, -118, -72, -28, 18, 64, 110, 152];
---
<section id="recorrido" class="section rc" data-theme="light" aria-labelledby="recorrido-title">
  <a class="rc__skip btn btn--primary btn--sm" href="#valores">Saltar el recorrido <Icon name="arrow" size={16} /></a>

  <div class="rc__stage">
    <div class="rc__bg" aria-hidden="true">
      <span class="bleed-word rc__bleed">Recorrido</span>
      <span class="rc__ray"><span class="streak streak--thick"></span></span>
    </div>

    <header class="rc__intro">
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 id="recorrido-title" data-split="words">De la evaluación inicial al mantenimiento, <span class="accent">con un solo equipo.</span></h2>
      <p class="rc__lead" data-reveal="up" data-delay=".15">Combinamos el rigor técnico con la ejecución segura para garantizar que la energía de tu planta nunca se detenga.</p>
      <p class="rc__hint mono" aria-hidden="true"><span class="rc__hint-line"></span>Sigue la corriente</p>
    </header>

    <div class="rc__bar">
    <div class="rc__hud" aria-hidden="true">
      <span class="rc__hud-k">Etapa</span>
      <span class="rc__hud-n num">0<span class="rc__roll"><span class="rc__roll-strip">{stations.map((s) => <i>{s.n.slice(1)}</i>)}</span></span></span>
      <span class="rc__hud-of">/ 0{stations.length}</span>
      <span class="rc__hud-t"><span class="rc__hud-strip">{stations.map((s) => <i>{s.t}</i>)}</span></span>
      <span class="rc__seg">{stations.map(() => <i></i>)}</span>
      <span class="rc__hud-st"><span class="rc__hud-run">Conectando</span><span class="rc__hud-ok">Circuito completo</span></span>
    </div>
    <p class="rc__swipe mono" aria-hidden="true">Desliza <Icon name="arrow" size={16} /></p>
    </div>

    <div class="rc__rail">
      <div class="rc__track">
        <span class="rc__src" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="40" height="40" focusable="false"><path d="M20 3 35 11.5v17L20 37 5 28.5v-17Z" /><circle cx="20" cy="20" r="4.5" /></svg>
        </span>
        <ol class="rc__list" role="list">
          {stations.map((s) => (
            <li class="rc__card">
              <article class="rc__station" aria-labelledby={`rc-t-${s.n}`}>
                <a class="rc__visual" href={s.href} target="_blank" rel="noopener">
                  <span class="rc__frame">
                    <img src={s.src} width="640" height="811" alt={s.alt} loading="lazy" decoding="async" draggable="false" />
                    <span class="rc__sweep" aria-hidden="true"></span>
                  </span>
                  <span class="rc__ig mono"><Icon name="instagram" size={14} />Ver en Instagram<span class="sr-only"> (se abre en una pestaña nueva)</span><Icon name="arrowUpRight" size={14} /></span>
                </a>
                <div class="rc__body">
                  <p class="rc__status mono" aria-hidden="true"><span class="rc__led"></span><span class="rc__st-on">Conectada</span><span class="rc__st-off">En espera</span><span class="rc__ico"><Icon name={s.icon} size={20} /></span></p>
                  <div class="rc__head">
                    <span class="rc__num num" aria-hidden="true"><span class="rc__num-o">{s.n}</span><span class="rc__num-f">{s.n}</span></span>
                    <h3 class="rc__title" id={`rc-t-${s.n}`}><span class="sr-only">Etapa {s.n}: </span>{s.t}</h3>
                  </div>
                  <p class="rc__desc">{s.d}</p>
                  <span class="rc__wave" aria-hidden="true"><svg viewBox="0 0 60 36" preserveAspectRatio="xMinYMid meet" focusable="false"><line class="rc__wave-0" x1="0" y1="18" x2="660" y2="18" /><path class="rc__wave-1" pathLength="1" d={wave} /></svg></span>
                  <p class="rc__chip mono">{s.chip}</p>
                </div>
              </article>
              <span class="rc__branch" aria-hidden="true"></span>
              <span class="rc__zap" aria-hidden="true">{sparks.slice(0, 6).map((r) => <i style={`--r:${r}deg`}></i>)}</span>
            </li>
          ))}
          <li class="rc__card rc__card--next">
            <div class="rc__next" data-theme="dark">
              <span class="rc__next-ray" aria-hidden="true"><span class="streak streak--thick"></span></span>
              <svg class="rc__bolt" viewBox="0 0 24 24" width="56" height="56" aria-hidden="true" focusable="false">
                <defs><linearGradient id="rc-bolt-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffd79a" /><stop offset=".55" stop-color="#ff9c5c" /><stop offset="1" stop-color="#f26a1b" /></linearGradient></defs>
                <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
              </svg>
              <p class="rc__next-k mono">Siguiente conexión</p>
              <h3 class="rc__next-t">Tu proyecto es <span class="accent">el siguiente</span></h3>
              <p class="rc__next-d">Desde la evaluación inicial hasta el montaje, entregamos soluciones dinámicas para el sector residencial, comercial e industrial.</p>
              <a class="btn btn--primary rc__next-cta" href={wa('Hola SSD&S, quiero agendar una evaluación técnica.')} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />Agenda una evaluación técnica<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
            </div>
            <span class="rc__branch" aria-hidden="true"></span>
            <span class="rc__zap" aria-hidden="true">{sparks.map((r) => <i style={`--r:${r}deg`}></i>)}</span>
          </li>
        </ol>
        <span class="rc__cable" aria-hidden="true"><span class="rc__reveal"><span class="rc__fill"><span class="rc__flow"></span></span></span></span>
        <span class="rc__tip" aria-hidden="true">
          <b class="rc__tail"></b>
          {sparks.slice(0, 5).map((r, k) => <i style={`--r:${r + 20}deg;--d:${0.62 + k * 0.13}s;--w:${k * 0.17}s`}></i>)}
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/recorrido.js';
</script>

<style>
  .rc {
    --edge: max(var(--gutter), (100% - var(--container)) / 2);
    --under: 34px;           /* cable height above the track's bottom edge */
    --branch: 26px;          /* branch from the cable up to a station */
    --pad: 8px;
    --ghost: rgba(11, 26, 58, 0.12);
    overflow: clip;
    background-color: var(--bg);
    background-image:
      linear-gradient(rgba(11, 26, 58, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 26, 58, 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center top;
  }

  /* ---------- skip link (visible on keyboard focus) ---------- */
  .rc__skip { position: absolute; left: var(--gutter); top: calc(var(--header-h) + 12px); z-index: 8; opacity: 0; transform: translateY(-12px); pointer-events: none; transition: opacity 0.3s, transform 0.3s var(--ease-out); }
  .rc__skip:focus-visible { opacity: 1; transform: none; pointer-events: auto; }

  /* ---------- decorative background (pin only) ---------- */
  .rc__bg { display: none; }

  /* ---------- intro ---------- */
  .rc__intro, .rc__bar { width: min(100% - 2 * var(--gutter), var(--container)); margin-inline: auto; }
  .rc__bar { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 20px; margin-top: 26px; }
  .rc__intro { position: relative; z-index: 2; }
  .rc__intro h2 { font-size: clamp(1.85rem, 1.15rem + 3.4vw, 3.6rem); max-width: 17ch; }
  .rc__lead { margin-top: 1.1rem; font-size: var(--step-1); line-height: 1.45; color: var(--muted); max-width: 44ch; }
  .rc__hint { display: none; }

  /* ---------- HUD: "Etapa 0X / 04" (only when the scene is live) ---------- */
  .rc__hud { display: none; }
  .rc--live .rc__hud { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-family: var(--font-mono); color: var(--muted); }
  .rc__hud-k, .rc__hud-of, .rc__hud-st { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .rc__hud-n { display: inline-flex; font-weight: 800; font-size: 2rem; line-height: 1; letter-spacing: -0.03em; color: var(--ink); }
  .rc__roll, .rc__hud-t { display: inline-block; overflow: hidden; }
  .rc__roll { height: 1em; }
  .rc__roll-strip, .rc__hud-strip { display: flex; flex-direction: column; transition: transform 0.7s var(--ease-out); }
  .rc__roll-strip { transform: translateY(calc(var(--s, 0) * -1em)); }
  .rc__roll-strip i, .rc__hud-strip i { font-style: normal; }
  .rc__roll-strip i { height: 1em; }
  .rc__hud-t { height: 1.35em; font-family: var(--font-display); font-weight: 600; font-size: 1rem; color: var(--ink); letter-spacing: -0.01em; }
  .rc__hud-strip { transform: translateY(calc(var(--s, 0) * -1.35em)); }
  .rc__hud-strip i { height: 1.35em; line-height: 1.35; white-space: nowrap; }
  .rc__seg { display: inline-flex; gap: 4px; }
  .rc__seg i { width: 16px; height: 6px; border-radius: 2px; background: rgba(11, 26, 58, 0.14); transition: background-color 0.4s, box-shadow 0.4s; }
  .rc__hud[data-on='1'] .rc__seg i:nth-child(-n + 1),
  .rc__hud[data-on='2'] .rc__seg i:nth-child(-n + 2),
  .rc__hud[data-on='3'] .rc__seg i:nth-child(-n + 3),
  .rc__hud[data-on='4'] .rc__seg i { background: var(--orange-500); box-shadow: 0 0 8px rgba(242, 106, 27, 0.55); }
  .rc__hud-st { display: none; }
  .rc__hud-run, .rc__hud-ok { grid-area: 1 / 1; white-space: nowrap; transition: opacity 0.4s, transform 0.6s var(--ease-out); }
  .rc__hud-ok { color: var(--ink); opacity: 0; transform: translateY(0.9em); }
  .rc.is-complete .rc__hud-run { opacity: 0; transform: translateY(-0.9em); }
  .rc.is-complete .rc__hud-ok { opacity: 1; transform: none; }

  /* ---------- rail / track: native scroll-snap row by default ---------- */
  .rc__rail {
    margin-top: 18px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .rc__rail::-webkit-scrollbar { display: none; }
  @media (pointer: fine) {
    .rc__rail { scrollbar-width: thin; scrollbar-color: rgba(11, 26, 58, 0.3) transparent; }
    .rc__rail::-webkit-scrollbar { display: block; height: 6px; }
    .rc__rail::-webkit-scrollbar-thumb { background: rgba(11, 26, 58, 0.3); border-radius: 6px; }
  }
  .rc__track { position: relative; width: max-content; padding: 18px var(--edge) var(--under); }
  .rc__list { list-style: none; display: flex; align-items: stretch; gap: 14px; }
  .rc__card { position: relative; flex: none; width: min(80vw, 620px); padding-bottom: var(--branch); scroll-snap-align: start; container: rc / inline-size; }

  /* source hexagon at the start of the cable */
  .rc__src { position: absolute; left: calc(max(var(--gutter), (100vw - var(--container)) / 2) - 14px); bottom: var(--under); width: 28px; height: 28px; transform: translateY(50%); display: none; }
  .rc__src svg { width: 100%; height: 100%; fill: var(--white); stroke: var(--orange-500); stroke-width: 2.5; }
  .rc__src circle { fill: var(--orange-500); stroke: none; }

  /* ---------- station card ---------- */
  .rc__station {
    position: relative; height: 100%; display: grid; grid-template-rows: auto 1fr;
    padding: var(--pad); border-radius: 24px; background: var(--white);
    border: 1px solid var(--line-light);
    box-shadow: 0 28px 50px -36px rgba(11, 26, 58, 0.5), 0 2px 6px -2px rgba(11, 26, 58, 0.08);
  }
  @media (hover: hover) and (pointer: fine) {
    .rc__station { transition: translate 0.6s var(--ease-out); }
    .rc__station:hover { translate: 0 -6px; }
  }
  /* ink, not orange: an orange ring would read as one more powered (orange) station ring */
  .rc__station:has(.rc__visual:focus-visible) { outline: 3px solid var(--ink); outline-offset: 5px; }
  /* powered ring: flickers on when the station connects, then glows steady */
  .rc__station::after {
    content: ''; position: absolute; inset: -1px; border-radius: inherit; pointer-events: none;
    border: 1.5px solid var(--orange-400);
    box-shadow: 0 0 0 4px rgba(242, 106, 27, 0.08), 0 18px 40px -22px rgba(242, 106, 27, 0.55);
    opacity: 0.7;
  }
  .rc--live .rc__card:not(.is-on) .rc__station::after { opacity: 0; }
  .rc--live .rc__card.is-on .rc__station::after { animation: rc-flicker 0.9s linear 0.28s both; }
  @keyframes rc-flicker { 0% { opacity: 0; } 12% { opacity: 1; } 22% { opacity: 0.15; } 34% { opacity: 0.95; } 46% { opacity: 0.3; } 60%, 100% { opacity: 0.7; } }

  .rc__visual { position: relative; display: block; border-radius: 16px; }
  @supports selector(:has(*)) { .rc__visual:focus-visible { outline: none; } }
  .rc__frame {
    position: relative; display: block; aspect-ratio: 640 / 811; overflow: hidden; border-radius: 16px; background: var(--navy-800);
    clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 0 100%);
  }
  .rc__frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; transition: filter 1s var(--ease-out) 0.2s, scale 1s var(--ease-out); }
  .rc--live .rc__card:not(.is-on) .rc__frame img { filter: grayscale(1) contrast(0.88) brightness(1.06); }
  /* the chamfered corner carries the brand ray */
  .rc__visual::after {
    content: ''; position: absolute; top: 15px; right: -6px; width: 42px; height: 2px; border-radius: 2px; pointer-events: none;
    background: var(--grad-brand); transform: rotate(45deg); box-shadow: 0 0 10px rgba(255, 140, 60, 0.8);
  }
  /* the brand ray sweeps the photo once when the station connects */
  .rc__sweep {
    position: absolute; inset: -10% -50%; pointer-events: none; opacity: 0;
    background: linear-gradient(105deg, transparent 41%, rgba(255, 215, 154, 0.7) 48%, rgba(255, 125, 51, 0.5) 52%, transparent 60%);
  }
  .rc--live .rc__card.is-on .rc__sweep { animation: rc-sweep 1.3s var(--ease-out) 0.35s both; }
  @keyframes rc-sweep { from { transform: translateX(-72%); opacity: 1; } to { transform: translateX(72%); opacity: 1; } }

  .rc__ig {
    position: absolute; left: 12px; bottom: 12px; z-index: 1; display: inline-flex; align-items: center; gap: 6px;
    min-height: 32px; padding: 0 12px; border-radius: var(--r-pill); font-size: 0.75rem; letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.94); color: var(--ink); box-shadow: 0 8px 20px -10px rgba(11, 26, 58, 0.6);
    transition: opacity 0.4s, transform 0.5s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .rc__ig { opacity: 0; transform: translateY(8px); }
    .rc__visual:hover .rc__ig, .rc__visual:focus-visible .rc__ig { opacity: 1; transform: none; }
    .rc__visual:hover .rc__frame img { scale: 1.05; }
  }

  .rc__body { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 14px 10px 10px; container-type: inline-size; }
  .rc__status { display: flex; align-items: center; gap: 8px; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .rc__led { width: 9px; height: 9px; flex: none; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px rgba(61, 220, 132, 0.2), 0 0 10px rgba(61, 220, 132, 0.9); transition: background-color 0.3s 0.3s, box-shadow 0.3s 0.3s; }
  .rc__st-off { display: none; }
  /* live LED: a ring pings out of it while the station is powered */
  .rc__led { position: relative; }
  .rc__led::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--ok); opacity: 0; animation: rc-ping 2.4s var(--ease-out) 1s infinite; }
  .rc--live .rc__card:not(.is-on) .rc__led::after { animation: none; }
  @keyframes rc-ping { 0% { transform: scale(0.6); opacity: 0.9; } 70%, 100% { transform: scale(2.2); opacity: 0; } }
  .rc__ico {
    display: grid; place-items: center; width: 40px; height: 40px; margin: -6px 0 -6px auto; border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--orange-500) 45%, var(--line-light)); background: color-mix(in srgb, var(--orange-500) 7%, var(--white)); color: var(--orange-600);
    box-shadow: 0 6px 16px -8px rgba(242, 106, 27, 0.6); transition: color 0.4s 0.3s, background-color 0.4s 0.3s, border-color 0.4s 0.3s, box-shadow 0.4s 0.3s;
  }
  .rc--live .rc__card:not(.is-on) .rc__ico { border-color: var(--line-light); background: var(--paper); color: #8792a8; box-shadow: none; }
  .rc--live .rc__card:not(.is-on) .rc__led { background: #c2c9d6; box-shadow: 0 0 0 3px rgba(11, 26, 58, 0.06); }
  .rc--live .rc__card:not(.is-on) .rc__st-on { display: none; }
  .rc--live .rc__card:not(.is-on) .rc__st-off { display: inline; }

  .rc__head { display: flex; align-items: flex-end; gap: 12px; }
  .rc__num { position: relative; flex: none; font-weight: 800; font-size: 3.2rem; line-height: 0.82; letter-spacing: -0.05em; }
  .rc__num-o { display: block; color: #e4e9f2; }
  .rc__num-f {
    position: absolute; inset: 0; color: transparent;
    background: linear-gradient(180deg, #ffb454 0%, #f26a1b 55%, #d95a12 100%); -webkit-background-clip: text; background-clip: text;
    right: -0.12em; /* the last glyph's ink overhangs the box (negative tracking): paint it too */
    clip-path: inset(0 0 0 0); transition: clip-path 0.9s var(--ease-out) 0.3s;
  }
  .rc--live .rc__card:not(.is-on) .rc__num-f { clip-path: inset(100% 0 0 0); transition-delay: 0s; }
  .rc__title { font-size: min(clamp(1.45rem, 1.2rem + 0.9vw, 1.9rem), 12.5cqi); letter-spacing: -0.03em; }
  .rc__desc { font-size: 0.95rem; line-height: 1.55; color: var(--muted); text-wrap: wrap; }
  .rc__chip {
    align-self: flex-start; margin-top: auto; display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 12px; border-radius: var(--r-pill); border: 1px solid var(--line-light); background: var(--paper);
    font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); line-height: 1.2;
  }
  /* live signal: flat while waiting, a sine draws in when the station connects, then keeps running */
  /* the loop moves the <svg> box (composited), one sine period = height * 60/36 */
  .rc__wave { --wh: 34px; display: none; position: relative; width: 100%; height: var(--wh); margin-top: auto; overflow: hidden; }
  .rc__wave svg { position: absolute; left: 0; top: 0; width: calc(100% + var(--wh) * 5 / 3); max-width: none; height: 100%; animation: rc-wave 1.1s linear infinite; }
  .rc__wave-0 { stroke: var(--ghost); stroke-width: 1.5; stroke-dasharray: 2 3; }
  .rc__wave-1 { fill: none; stroke: var(--orange-500); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1.4s var(--ease-out) 0.35s; }
  .rc--live .rc__card:not(.is-on) .rc__wave-1 { stroke-dashoffset: 1; transition-duration: 0.3s; transition-delay: 0s; }
  .rc--live .rc__card:not(.is-on) .rc__wave svg { animation-play-state: paused; }
  @keyframes rc-wave { to { transform: translateX(calc(var(--wh) * -5 / 3)); } }
  .rc__chip::before { content: ''; width: 6px; height: 6px; flex: none; border-radius: 50%; background: var(--orange-500); box-shadow: 0 0 8px rgba(242, 106, 27, 0.8); }

  /* vertical card: a shorter window on the piece so a whole card fits between the header and the action bar */
  @container rc (max-width: 519px) { .rc__frame { aspect-ratio: 1 / 1.08; } }
  /* narrow card: number above the title so a long title keeps the whole column */
  @container rc (max-width: 300px) { .rc__head { flex-direction: column; align-items: flex-start; gap: 6px; } }
  /* landscape station when the card is wide enough (tablet row, reduced grid) */
  @container rc (min-width: 520px) {
    .rc__station { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr); grid-template-rows: none; gap: 6px; }
    .rc__body { padding: 16px 14px 12px 18px; }
    .rc__head { flex-direction: column; align-items: flex-start; gap: 8px; }
    .rc__num { font-size: 4.2rem; }
    .rc__wave { display: block; }
    .rc__wave + .rc__chip { margin-top: 0; }
  }

  /* ---------- "tu proyecto es el siguiente": dark card ---------- */
  .rc__next {
    position: relative; overflow: hidden; isolation: isolate; height: 100%;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: 14px;
    padding: clamp(22px, 5%, 36px); border-radius: 24px; color: var(--fg);
    background:
      radial-gradient(120% 70% at 85% 0%, rgba(242, 106, 27, 0.38), transparent 60%),
      radial-gradient(90% 60% at 0% 100%, rgba(37, 72, 138, 0.7), transparent 65%),
      var(--navy-900);
    box-shadow: inset 0 0 0 1px rgba(255, 156, 92, 0.22), 0 30px 60px -34px rgba(11, 26, 58, 0.7);
  }
  .rc__next-ray { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .rc__next-ray .streak { top: 26%; --angle: -14deg; --streak-opacity: 0.85; }
  @container rc (min-width: 520px) { .rc__next-ray { left: 42%; } .rc__next-ray .streak { top: 14%; } }
  .rc__bolt { width: 56px; height: 56px; margin-bottom: auto; fill: none; stroke: url(#rc-bolt-grad); stroke-width: 1.4; stroke-linejoin: round; filter: drop-shadow(0 0 10px rgba(255, 140, 60, 0.6)); }
  .rc__next-k { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--glow); }
  .rc__next-t { font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem); line-height: 1.05; max-width: 12ch; }
  .rc__next-d { font-size: 0.95rem; line-height: 1.55; color: var(--muted); max-width: 34ch; }
  /* wide dark card (reduced grid): the bolt becomes the emblem on the right, the ray crosses it, clear of the copy */
  @container rc (min-width: 700px) {
    .rc__next { padding-right: 38%; }
    .rc__next-ray { left: 50%; }
    .rc__next-ray .streak { top: 50%; --angle: -12deg; }
    .rc__bolt { position: absolute; right: 10%; top: 50%; width: min(170px, 20%); height: auto; aspect-ratio: 1; margin: 0; transform: translateY(-50%); stroke-width: 1; }
  }
  .rc__next-cta { white-space: normal; text-align: left; margin-top: 6px; max-width: 100%; }
  .rc--live .rc__card--next:not(.is-on) .rc__bolt { opacity: 0.35; filter: none; }
  .rc--live .rc__card--next:not(.is-on) .rc__next-ray { opacity: 0; }
  .rc__bolt, .rc__next-ray { transition: opacity 0.8s var(--ease-out) 0.3s; }
  .rc--live .rc__card--next.is-on .rc__bolt { animation: rc-bolt 1s linear 0.3s both; }
  @keyframes rc-bolt { 0% { opacity: 0.35; } 15% { opacity: 1; } 25% { opacity: 0.4; } 40%, 100% { opacity: 1; } }

  /* ---------- cable, branches, junction bursts ---------- */
  .rc__cable {
    position: absolute; left: 0; right: 0; bottom: var(--under); height: 6px; transform: translateY(50%);
    border-radius: 6px; background: var(--ghost);
  }
  /* ruler ticks under the cable: minor every 16px, major every 96px */
  .rc__cable::after {
    content: ''; position: absolute; left: 0; right: 0; top: calc(100% + 8px); height: 10px; pointer-events: none;
    background:
      repeating-linear-gradient(90deg, rgba(11, 26, 58, 0.26) 0 1px, transparent 1px 96px),
      repeating-linear-gradient(90deg, rgba(11, 26, 58, 0.14) 0 1px, transparent 1px 16px) 0 4px / 100% 6px no-repeat;
  }
  /* reveal = a sliding mask (transform only, no repaint): the mask moves left by the unlit length s while the
     fill inside moves right by s, so the fill stays put and its right end is cut at the tip. The mask bleeds
     14px up and down so the glow is not clipped. */
  .rc__reveal { position: absolute; inset: -14px 0; overflow: hidden; }
  .rc__fill {
    position: absolute; inset: 15px 0; border-radius: 6px; overflow: hidden;
    background: var(--grad-brand); box-shadow: 0 0 12px rgba(242, 106, 27, 0.6);
  }
  .rc--pin.is-flowing :is(.rc__reveal, .rc__fill) { will-change: transform; }
  /* current: two layers at different periods and speeds (transform only):
     comet-shaped energy packets + a faint fast shimmer of sparks */
  .rc__flow { position: absolute; inset: 0; }
  .rc__flow::before, .rc__flow::after { content: ''; position: absolute; top: 0; bottom: 0; right: 0; }
  .rc__flow::before {
    left: -260px;
    background: repeating-linear-gradient(90deg, rgba(255, 244, 222, 0) 0 170px, rgba(255, 244, 222, 0.5) 222px, #fff 246px, rgba(255, 244, 222, 0) 260px);
    animation: rc-flow-a 0.9s linear infinite;
  }
  .rc__flow::after {
    left: -110px;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0) 0 100px, rgba(255, 255, 255, 0.6) 104px, rgba(255, 255, 255, 0) 108px 110px);
    animation: rc-flow-b 0.45s linear infinite;
  }
  @keyframes rc-flow-a { to { transform: translateX(260px); } }
  @keyframes rc-flow-b { to { transform: translateX(110px); } }
  /* circuit complete: one surge of light runs the whole conductor */
  .rc__fill::after {
    content: ''; position: absolute; top: -2px; bottom: -2px; left: 0; width: 12%; opacity: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), #fff 60%, rgba(255, 255, 255, 0));
  }
  .rc.is-complete .rc__fill::after { animation: rc-surge 1.6s var(--ease-in-out) both; }
  @keyframes rc-surge { from { transform: translateX(-100%); opacity: 1; } 92% { opacity: 1; } to { transform: translateX(833%); opacity: 0; } }

  .rc__card::after { /* ghost branch */
    content: ''; position: absolute; left: 50%; bottom: 0; width: 2px; height: var(--branch); margin-left: -1px; background: var(--ghost);
  }
  .rc__card::before { /* junction node on the cable */
    content: ''; position: absolute; left: 50%; bottom: 0; z-index: 2; width: 14px; height: 14px; border-radius: 50%;
    transform: translate(-50%, 50%); background: var(--white); border: 2px solid var(--orange-500);
    box-shadow: 0 0 0 4px rgba(242, 106, 27, 0.14), 0 0 12px rgba(242, 106, 27, 0.55);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .rc--live .rc__card:not(.is-on)::before { border-color: rgba(11, 26, 58, 0.28); box-shadow: none; }
  .rc__branch {
    position: absolute; left: 50%; bottom: 0; z-index: 1; width: 3px; height: var(--branch); margin-left: -1.5px; border-radius: 3px;
    background: linear-gradient(0deg, #f26a1b, #ffd79a); box-shadow: 0 0 10px rgba(242, 106, 27, 0.7);
    transform-origin: 50% 100%;
  }
  .rc--live:not(.rc--pin) .rc__branch { transition: transform 0.5s var(--ease-out); }
  .rc--live:not(.rc--pin) .rc__card:not(.is-on) .rc__branch { transform: scaleY(0); }
  .rc__zap { position: absolute; left: 50%; bottom: 0; z-index: 3; width: 0; height: 0; pointer-events: none; }
  .rc__zap i {
    position: absolute; left: 0; top: -1px; width: 16px; height: 2px; border-radius: 2px; opacity: 0; transform-origin: 0 50%;
    background: linear-gradient(90deg, #fff, #ffd79a 45%, rgba(255, 156, 92, 0));
  }
  .rc--live .rc__card.is-on .rc__zap i { animation: rc-zap 0.7s var(--ease-out) both; }
  @keyframes rc-zap {
    from { opacity: 1; transform: rotate(var(--r)) translateX(5px) scaleX(0.3); }
    to { opacity: 0; transform: rotate(var(--r)) translateX(30px) scaleX(1); }
  }

  /* ---------- glowing tip (pin only) ---------- */
  .rc__tip { display: none; }

  /* ---------- swipe hint ---------- */
  .rc__swipe { display: flex; align-items: center; gap: 8px; margin: 0 0 0 auto; min-height: 24px; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); transition: opacity 0.5s; }
  .rc__swipe :global(svg) { color: var(--orange-600); animation: rc-nudge 1.6s var(--ease-in-out) infinite; }
  @keyframes rc-nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(6px); } }
  .rc.is-swiped .rc__swipe { opacity: 0.35; }
  .rc.is-swiped .rc__swipe :global(svg) { animation: none; }

  /* ---------- desktop + reduced motion: wrapping grid, no cable ---------- */
  @media (min-width: 768px) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .rc__rail { overflow: visible; scroll-snap-type: none; margin-top: clamp(32px, 4vw, 56px); }
    .rc__track { width: min(100% - 2 * var(--gutter), var(--container)); margin-inline: auto; padding: 0; }
    .rc__list { display: grid; grid-template-columns: 1fr; gap: 20px; }
    .rc__card { width: auto; padding-bottom: 0; }
    .rc__card::before, .rc__card::after, .rc__branch, .rc__zap, .rc__cable, .rc__bar { display: none; }
    .rc__next { min-height: 280px; }
  }
  @media (min-width: 1100px) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .rc__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rc__card--next { grid-column: 1 / -1; }
  }

  /* =====================================================================
     Desktop gate: pinned horizontal recorrido (class set by scripts/recorrido.js)
     ===================================================================== */
  .rc--pin {
    /* sized from the height that is really free between the HUD and the ground (short laptop windows, 560px+),
       the leftover on tall screens is split above the cards and under the cable: the composition stays centred */
    --hud-b: calc(var(--header-h) + 18px + clamp(2rem, 4.4vh, 3.2rem) + 14px); /* HUD bottom + air */
    --under0: clamp(44px, 8vh, 120px);
    --branch: clamp(22px, 4vh, 64px);
    --lift: 3vh;               /* even stations stand this much higher */
    --avail: calc(100vh - var(--hud-b) - var(--under0) - var(--branch) - var(--lift) - 2 * var(--pad));
    --tall: clamp(280px, min(var(--avail), 64vh), 780px);
    --under: calc(var(--under0) + max(0px, var(--avail) - var(--tall)) / 2); /* cable height above the ground */
    --pad: 12px;
    --vis-w: calc(var(--tall) * 0.79);
    --body-w: clamp(250px, 21vw, 440px);
    --intro-w: min(38rem, 36vw);
    /* the stage is a CSS sticky pin (the compositor holds it: no lag on keyboard / scrollbar scrolling, no
       fixed↔static flip); --d = horizontal travel + end dwell, set by scripts/recorrido.js once per refresh */
    height: calc(100vh + var(--d, 0px));
    padding: 0;
    /* the stage clips its own overflow; an ancestor clip around a sticky layer moves in its space every frame
       and forces the whole stage to repaint while pinned (trace: 113 → 31 stage paints per pass) */
    overflow: visible;
    z-index: 4; /* over the chrome's margin line while pinned: the current turns horizontal here */
  }
  .rc--pin .rc__stage { position: sticky; top: 0; height: 100vh; overflow: clip; }
  /* ground under the cable */
  .rc--pin .rc__stage::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: var(--under); z-index: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(11, 26, 58, 0.05), rgba(11, 26, 58, 0.015));
    border-top: 1px solid rgba(11, 26, 58, 0.06);
  }
  .rc--pin .rc__bg { display: block; position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .rc--pin .rc__bleed { position: absolute; left: 0; top: calc(var(--header-h) + 3vh); font-size: min(24vw, 34vh); -webkit-text-stroke: 1.5px rgba(11, 26, 58, 0.07); will-change: transform; }
  .rc--pin .rc__ray { position: absolute; inset: 0; opacity: 0.55; }
  .rc--pin .rc__ray .streak { top: 30%; --angle: -7deg; }

  .rc--pin .rc__intro { position: absolute; z-index: 2; left: var(--edge); bottom: calc(var(--under) + var(--branch)); width: var(--intro-w); margin: 0; will-change: transform; }
  .rc--pin .rc__intro h2 { font-size: clamp(2rem, min(2.9vw, 5vh), 3.6rem); max-width: 16ch; }
  .rc--pin .rc__lead { font-size: clamp(1rem, min(1.25vw, 2.3vh), 1.3rem); max-width: 40ch; }
  .rc--pin .rc__hint { display: flex; align-items: center; gap: 12px; margin-top: clamp(16px, 3vh, 32px); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .rc__hint-line { position: relative; width: 56px; height: 2px; overflow: hidden; border-radius: 2px; background: var(--ghost); }
  .rc__hint-line::after { content: ''; position: absolute; inset: 0; background: var(--grad-brand); animation: rc-hint 1.8s var(--ease-in-out) infinite; }
  @keyframes rc-hint { from { transform: translateX(-100%); } to { transform: translateX(100%); } }

  .rc--pin .rc__bar { display: contents; }
  .rc--pin .rc__hud { position: absolute; z-index: 3; top: calc(var(--header-h) + 18px); right: var(--edge); width: auto; margin: 0; gap: 10px 14px; flex-wrap: nowrap; }
  .rc--pin .rc__hud-n { font-size: clamp(2rem, 4.4vh, 3.2rem); }
  .rc--pin .rc__hud-t { font-size: clamp(1rem, 2.1vh, 1.35rem); min-width: 9.2em; }
  .rc--pin .rc__hud-st { display: inline-grid; overflow: hidden; }
  .rc--pin .rc__seg i { width: 22px; }

  .rc--pin .rc__rail { position: absolute; inset: 0; z-index: 1; margin: 0; overflow: visible; scroll-snap-type: none; }
  .rc--pin .rc__track { height: 100%; display: flex; align-items: flex-end; padding: 0 var(--edge) var(--under) calc(var(--edge) + var(--intro-w) + 6vw); will-change: transform; }
  .rc--pin .rc__list { align-items: flex-end; gap: clamp(32px, 4.2vw, 88px); }
  .rc--pin .rc__card { container-type: normal; width: calc(var(--vis-w) + var(--body-w) + var(--pad) * 2 + 2px); }
  .rc--pin .rc__card:nth-child(even) { padding-bottom: calc(var(--branch) + var(--lift)); }
  .rc--pin .rc__card:nth-child(even)::after, .rc--pin .rc__card:nth-child(even) .rc__branch { height: calc(var(--branch) + var(--lift)); }
  .rc--pin .rc__src { display: block; }

  .rc--pin .rc__station { height: calc(var(--tall) + var(--pad) * 2); grid-template-columns: var(--vis-w) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); border-radius: 28px; }
  .rc--pin .rc__visual, .rc--pin .rc__frame { height: 100%; }
  .rc--pin .rc__frame { aspect-ratio: auto; border-radius: 18px; clip-path: polygon(0 0, calc(100% - 40px) 0, 100% 40px, 100% 100%, 0 100%); }
  .rc--pin .rc__visual::after { top: 19px; right: -9px; width: 56px; }
  .rc--pin .rc__frame img { width: 110%; height: 100%; max-width: none; margin-left: -5%; object-position: 50% 50%; will-change: transform; }
  .rc--pin .rc__body { gap: clamp(8px, 1.6vh, 16px); padding: clamp(12px, 2.4vh, 26px) clamp(12px, 1.4vw, 24px) clamp(8px, 1.6vh, 18px) clamp(16px, 1.8vw, 30px); }
  .rc--pin .rc__head { flex-direction: column; align-items: flex-start; gap: clamp(6px, 1.2vh, 12px); }
  .rc--pin .rc__num { font-size: calc(var(--tall) * 0.19); }
  .rc--pin .rc__title { font-size: min(clamp(1.45rem, calc(var(--tall) * 0.074), 3.2rem), 12.5cqi); }
  .rc--pin .rc__desc { font-size: clamp(0.9rem, calc(var(--tall) * 0.039), 1.3rem); }
  .rc--pin .rc__wave { display: block; --wh: clamp(28px, calc(var(--tall) * 0.08), 52px); }
  .rc--pin .rc__wave + .rc__chip { margin-top: 0; }

  .rc--pin .rc__card--next { width: var(--tall); }
  .rc--pin .rc__next { height: calc(var(--tall) + var(--pad) * 2); border-radius: 28px; padding: clamp(22px, 4vh, 44px); }
  .rc--pin .rc__bolt { width: calc(var(--tall) * 0.16); height: calc(var(--tall) * 0.16); }
  .rc--pin .rc__next-t { font-size: clamp(1.7rem, calc(var(--tall) * 0.078), 3rem); }
  .rc--pin .rc__next-d { font-size: clamp(0.9rem, calc(var(--tall) * 0.037), 1.15rem); }
  .rc--pin .rc__next-cta { min-height: 48px; padding: 0 20px; font-size: clamp(0.92rem, calc(var(--tall) * 0.038), 1.1rem); }

  .rc--pin .rc__swipe { display: none; }

  .rc--pin .rc__tip { display: block; position: absolute; left: 0; bottom: var(--under); z-index: 4; width: 0; height: 0; pointer-events: none; will-change: transform; }
  .rc__tip::before { /* hot core */
    content: ''; position: absolute; left: -13px; top: -13px; width: 26px; height: 26px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0 22%, #ffe7bf 34%, rgba(255, 156, 92, 0.75) 52%, rgba(242, 106, 27, 0) 72%);
  }
  .rc__tip::after { /* breathing halo */
    content: ''; position: absolute; left: -36px; top: -36px; width: 72px; height: 72px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 140, 60, 0.34), rgba(255, 140, 60, 0) 68%);
    animation: rc-halo 1.4s var(--ease-in-out) infinite alternate;
  }
  @keyframes rc-halo { from { transform: scale(0.75); opacity: 0.7; } to { transform: scale(1.15); opacity: 1; } }
  .rc__tail { position: absolute; right: 0; top: -2px; width: 180px; height: 4px; border-radius: 4px; background: linear-gradient(90deg, rgba(255, 240, 214, 0), rgba(255, 244, 226, 0.95)); }
  .rc__tip i {
    position: absolute; left: 0; top: -1px; width: 11px; height: 2px; border-radius: 2px; opacity: 0; transform-origin: 0 50%;
    background: linear-gradient(90deg, #fff, #ffd79a);
    animation: rc-crackle var(--d) var(--ease-out) var(--w) infinite;
  }
  @keyframes rc-crackle {
    0% { opacity: 0; transform: rotate(var(--r)) translateX(6px) scaleX(0.3); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: rotate(var(--r)) translateX(24px) scaleX(1); }
  }
  /* idle loops only while the stage is pinned on screen */
  .rc--pin:not(.is-flowing) .rc__tip i, .rc--pin:not(.is-flowing) .rc__tip::after, .rc--pin:not(.is-flowing) .rc__flow::before, .rc--pin:not(.is-flowing) .rc__flow::after, .rc--pin:not(.is-flowing) .rc__wave svg, .rc--pin:not(.is-flowing) .rc__led::after { animation-play-state: paused; }
  .rc.is-complete .rc__tip i { display: none; }
  :global(.is-lite) .rc__tip i { display: none; }
</style>
