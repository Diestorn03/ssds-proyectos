---
/*
  #inicio · "Alta Tensión" (docs/CONCEPTO.md, escena 1). Dark, one screen tall.
  Poster (CSS glows + grid + the brand ray SVG with a current pulse running along it) is the first frame everywhere.
  Desktop gate (+ !lite): WebGL "campo eléctrico" (scripts/hero/campo.js, loaded on idle after the intro) fades in
  over it and auto-degrades back to the poster. Desktop: lens-meter over the H1, char intro after the loader,
  3-column 3D wall of the 14 real posts with pointer parallax, pin +100 % from 1024 px (field calms, title rises and
  blurs, lead/CTAs leave, the wall flattens and shrinks, the bridge line arrives word by word).
  Touch / <1024 px: the posts as two rows drifting in opposite directions along the brand diagonal, a live wire
  between them, one scripted lens sweep over "confiable", no pin, no WebGL. Reduced motion: static poster, all visible.
*/
import Icon from '../ui/Icon.astro';
import { brand, claims, posts, wa } from '../../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (code: string) => `${base}/ig/${code}.webp`;
const cols = [posts.slice(0, 5), posts.slice(5, 10), posts.slice(10, 14)];
const colDur = [46, 58, 40];
const rows = [posts.slice(0, 7), posts.slice(7, 14)];
const rowDur = [52, 60];
const bridge = '¿Tu energía está protegida?'.split(' ');

// Poster field lines (build time): streamlines around the brand ray (same geometry as the SVG streak), bunched
// towards it like the field around a conductor; Catmull-Rom through points every 100 units → cubic Béziers.
const ray = (x: number) => 720 - (560 / 1800) * (x + 100);
const rnd = (n: number) => { const v = Math.sin(n * 127.1) * 43758.5453; return v - Math.floor(v); };
const f1 = (n: number) => n.toFixed(1);
const field = [-9, -6, -4, -3, -2, -1, 1, 2, 3, 5, 7, 10].map((i) => {
  const off = Math.sign(i) * Math.pow(Math.abs(i), 1.35) * 24;
  const amp = 8 + rnd(i) * 20, fr = 0.0035 + rnd(i + 9) * 0.003, ph = rnd(i + 3) * 6.28;
  const pts: number[][] = [];
  for (let x = -300; x <= 1900; x += 100) pts.push([x, ray(x) + off + amp * Math.sin(x * fr + ph)]);
  let d = `M${pts[0][0]} ${f1(pts[0][1])}`;
  for (let k = 0; k < pts.length - 1; k++) {
    const p0 = pts[k - 1] || pts[k], a = pts[k], b = pts[k + 1], p3 = pts[k + 2] || b;
    d += ` C${f1(a[0] + (b[0] - p0[0]) / 6)} ${f1(a[1] + (b[1] - p0[1]) / 6)} ${f1(b[0] - (p3[0] - a[0]) / 6)} ${f1(b[1] - (p3[1] - a[1]) / 6)} ${b[0]} ${f1(b[1])}`;
  }
  return { d, o: (0.16 + 0.42 * Math.exp(-Math.abs(i) / 2.5)).toFixed(2), live: [-2, 1, 3].includes(i) };
});
---
<section class="section hero is-intro" id="inicio" data-theme="dark" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow hero__glow--a"></div>
    <div class="hero__glow hero__glow--b"></div>
    <svg class="hero__field" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <linearGradient id="hero-fg" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#f26a1b" stop-opacity="0" />
          <stop offset=".35" stop-color="#ff7d33" />
          <stop offset=".75" stop-color="#ffb454" />
          <stop offset="1" stop-color="#ffd79a" stop-opacity=".4" />
        </linearGradient>
      </defs>
      <g fill="none" stroke="url(#hero-fg)" stroke-width="1.4">{field.map((l) => <path d={l.d} stroke-opacity={l.o} />)}</g>
    </svg>
    <!-- the packets get their own layer: their per-frame repaints never re-raster the static field lines -->
    <svg class="hero__packets-layer" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
      <g class="hero__packets" fill="none">{field.filter((l) => l.live).map((l) => <path d={l.d} pathLength="100" />)}</g>
    </svg>
    <canvas class="hero__gl"></canvas>
    <div class="hero__grid"></div>
    <svg class="hero__streaks" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <linearGradient id="hero-g" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#ff7d33" stop-opacity="0" />
          <stop offset=".45" stop-color="#ffd79a" />
          <stop offset=".6" stop-color="#ff9c5c" />
          <stop offset="1" stop-color="#ff7d33" stop-opacity="0" />
        </linearGradient>
        <filter id="hero-f" x="-10%" y="-300%" width="120%" height="700%"><feGaussianBlur stdDeviation="7" /></filter>
      </defs>
      <g fill="none" stroke="url(#hero-g)" stroke-linecap="round">
        <line x1="-100" y1="720" x2="1700" y2="160" stroke-width="12" filter="url(#hero-f)" opacity=".75" />
        <line x1="-100" y1="720" x2="1700" y2="160" stroke-width="2.5" />
        <line x1="120" y1="960" x2="1760" y2="450" stroke-width="1.5" opacity=".55" />
      </g>
    </svg>
    <svg class="hero__pulse" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
      <path class="hero__pulse-glow" d="M-100 720 L1700 160" pathLength="100" />
      <path class="hero__pulse-core" d="M-100 720 L1700 160" pathLength="100" />
    </svg>
    <div class="hero__deep"></div>
    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <div class="hero__head">
        <p class="eyebrow hero__kicker hero__in">{brand.tagline}</p>
        <div class="hero__title-wrap">
          <h1 id="hero-title" class="hero__title"><span class="hero__line">Energía</span> <span class="hero__line"><span class="hero__key">confiable</span></span> <span class="hero__line">para tu negocio.</span></h1>
          <div class="hero__title hero__lens" aria-hidden="true"><span class="hero__line">Energía</span> <span class="hero__line"><span class="hero__key">confiable</span></span> <span class="hero__line">para tu negocio.</span></div>
          <span class="hero__ring" aria-hidden="true"><i class="hero__probe"></i></span>
        </div>
      </div>

      <div class="hero__act">
        <p class="lead hero__lead hero__in">{brand.description}</p>
        <div class="cta-row hero__ctas hero__in">
          <a class="btn btn--primary" href={wa()} target="_blank" rel="noopener" data-magnetic="0.25"><Icon name="whatsapp" size={20} />Cotizar por WhatsApp<span class="sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
          <a class="btn btn--ghost" href="#tablero">Ver servicios<Icon name="arrow" size={18} class="arrow" /></a>
        </div>
        <ul class="hero__facts hero__in">
          <li><Icon name="pin" size={16} />{brand.city}, {brand.region}</li>
          <li><Icon name="shield" size={16} />Cobertura nacional</li>
          <li><Icon name="clock" size={16} />Respuesta oportuna</li>
        </ul>
      </div>

      <p class="hero__bridge">{bridge.map((w, i) => <><span class:list={['hero__bw', { 'grad-text': i === bridge.length - 1 }]}>{w}</span>{i < bridge.length - 1 && ' '}</>)}<span class="hero__bridge-rule" aria-hidden="true"></span></p>
    </div>

    <div class="hero__wall" aria-hidden="true">
      <div class="hero__rig">
        <div class="hero__wall-inner">
          {cols.map((col, i) => (
            <div class="hero__col" data-dir={i === 1 ? 'down' : 'up'} style={`--dur:${colDur[i]}s`}>
              <div class="hero__track">
                {col.map((p) => <img src={src(p.code)} width="640" height="811" alt="" loading="eager" decoding="async" draggable="false" />)}
              </div>
            </div>
          ))}
          <span class="hero__sheen"><i></i></span>
        </div>
      </div>
    </div>

    <div class="hero__band" aria-hidden="true">
      <div class="hero__band-tilt">
        {rows.map((row, i) => (
          <div class="hero__row" data-dir={i === 1 ? 'right' : 'left'} style={`--dur:${rowDur[i]}s`}>
            <div class="hero__rtrack">
              {row.map((p) => <img src={src(p.code)} width="640" height="811" alt="" loading="lazy" decoding="async" draggable="false" />)}
            </div>
          </div>
        ))}
        <span class="hero__band-wire"><i></i></span>
      </div>
    </div>

    <a class="hero__scroll mono" href="#tablero"><span class="hero__scroll-in hero__in"><span class="hero__scroll-line"></span>Explorar</span></a>
  </div>

  <div class="marquee hero__marquee" data-speed="0.6" aria-hidden="true">
    <div class="marquee__track">
      {claims.map((c) => <span class="hero__mq">{c}<i></i></span>)}
    </div>
  </div>
</section>

<style>
  /* ---------- frame ---------- */
  .hero {
    --pad-top: calc(var(--header-h) + clamp(12px, 3.2vh, 40px));
    position: relative; overflow: clip; isolation: isolate;
    min-height: 100svh; display: grid; grid-template-rows: minmax(0, 1fr) auto;
    padding: var(--pad-top) 0 0; background: var(--navy-950); color: #fff;
  }
  @media (min-width: 1024px) { .hero { height: 100svh; min-height: 600px; } }

  /* ---------- background: poster → canvas → grid → ray → pulse → depth → scrim ---------- */
  .hero__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: radial-gradient(120% 90% at 72% 8%, #10244f 0%, var(--navy-900) 42%, var(--navy-950) 100%); }
  .hero__glow { position: absolute; border-radius: 50%; opacity: 0.6; will-change: transform; }
  .hero__glow--a { width: 70vw; height: 70vw; max-width: 1000px; max-height: 1000px; right: -25vw; top: -30vw; background: radial-gradient(circle, rgba(242, 106, 27, 0.5) 0%, rgba(242, 106, 27, 0.18) 35%, transparent 70%); animation: hero-breathe-a 14s ease-in-out infinite alternate; }
  .hero__glow--b { width: 50vw; height: 50vw; left: -20vw; bottom: -15vw; background: radial-gradient(circle, rgba(37, 72, 138, 0.75) 0%, rgba(37, 72, 138, 0.25) 40%, transparent 70%); animation: hero-breathe-b 18s ease-in-out infinite alternate; }
  @keyframes hero-breathe-a { to { transform: translate3d(-6vw, 5vw, 0) scale(1.12); } }
  @keyframes hero-breathe-b { to { transform: translate3d(5vw, -3vw, 0) scale(0.9); } }
  .hero__field, .hero__packets-layer { position: absolute; inset: 0; width: 100%; height: 100%; will-change: transform; }
  .hero__packets path { stroke: #fff0d6; stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 5 200; stroke-dashoffset: 6; }
  .hero.is-live .hero__packets path { animation: hero-current 7s cubic-bezier(0.45, 0, 0.35, 1) infinite; }
  .hero.is-live .hero__packets path:nth-child(2) { animation-duration: 8.5s; animation-delay: 2.2s; }
  .hero.is-live .hero__packets path:nth-child(3) { animation-duration: 6.2s; animation-delay: 4.1s; }
  .hero.is-gl :is(.hero__field, .hero__packets-layer) { visibility: hidden; transition: visibility 0s 1.2s; }
  .hero.is-gl .hero__packets path { animation-play-state: paused; }
  .hero__gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.1s var(--ease-out); }
  .hero.is-gl .hero__gl { opacity: 1; }
  .hero.is-gl .hero__glow { animation-play-state: paused; }
  .hero__grid { position: absolute; inset: 0; opacity: 0.35; background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px); background-size: 72px 72px; -webkit-mask-image: radial-gradient(70% 70% at 60% 40%, #000, transparent); mask-image: radial-gradient(70% 70% at 60% 40%, #000, transparent); }
  /* the ray stays bright between the copy and the wall, and sinks under the text */
  .hero__streaks, .hero__pulse { position: absolute; inset: 0; width: 100%; height: 100%; -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.4) 36%, #000 58%); mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.4) 36%, #000 58%); }
  @media (max-width: 1023px) { .hero__streaks, .hero__pulse { -webkit-mask-image: none; mask-image: none; } }
  .hero.is-gl .hero__streaks { opacity: 0.7; transition: opacity 1.1s; }
  /* a packet of current running along the ray (own layer: its repaints never touch the blurred streak) */
  .hero__pulse { will-change: transform; }
  .hero__pulse path { fill: none; stroke-linecap: round; stroke-dasharray: 6 200; stroke-dashoffset: 8; }
  .hero__pulse-glow { stroke: rgba(255, 170, 90, 0.35); stroke-width: 12; }
  .hero__pulse-core { stroke: #fff4df; stroke-width: 2.5; }
  .hero.is-live .hero__pulse path { animation: hero-current 5.6s cubic-bezier(0.5, 0, 0.3, 1) 0.6s infinite; }
  @keyframes hero-current { 0% { stroke-dashoffset: 8; } 45%, 100% { stroke-dashoffset: -104; } }
  .hero__deep { position: absolute; inset: 0; opacity: 0; background: radial-gradient(120% 90% at 70% 10%, rgba(6, 13, 31, 0.45), rgba(6, 13, 31, 0.92) 75%); }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(6, 13, 31, 0.78) 0%, rgba(6, 13, 31, 0.5) 34%, rgba(6, 13, 31, 0) 62%), linear-gradient(0deg, rgba(6, 13, 31, 0.6) 0%, rgba(6, 13, 31, 0) 22%); }
  .hero.is-off :is(.hero__glow, .hero__pulse path, .hero__packets path, .hero__track, .hero__rtrack, .hero__sheen i, .hero__band-wire i),
  .hero.is-off .hero__ring::before, .hero.is-off .hero__key::before, .hero.is-off .hero__scroll-line::after { animation-play-state: paused; }

  /* ---------- layout ---------- */
  .hero__inner { position: relative; display: grid; align-content: center; gap: clamp(28px, 5vw, 48px); min-height: 0; padding-bottom: clamp(20px, 4vh, 40px); }
  .hero__copy { position: relative; min-width: 0; }
  @media (min-width: 1024px) {
    .hero__inner { grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); grid-template-rows: minmax(0, 1fr); align-content: stretch; align-items: center; gap: clamp(32px, 4vw, 72px); padding-bottom: 0; }
  }

  /* ---------- copy ---------- */
  .hero__kicker { margin-bottom: clamp(12px, 2.4vh, 22px); }
  .hero__title-wrap { position: relative; --lx: 50%; --ly: 50%; --lr: 0px; --ls: 0; --rd: 170px; }
  .hero__copy { container-type: inline-size; }
  .hero__title { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(2.35rem, 1rem + 6.4vw, 3.6rem); line-height: 0.98; letter-spacing: -0.04em; color: #fff; text-wrap: balance; }
  /* 3 set lines sized to the copy column: "para tu negocio." (≈8.1em) always fits, and to the viewport height */
  @media (min-width: 560px) { .hero__title { font-size: max(2.6rem, min(11.8cqi, 10.8vh, 6.6rem)); } .hero__line { display: block; } }
  .hero__line { padding: 0.04em 0.1em 0.1em 0; margin: -0.04em -0.1em -0.1em 0; }
  :global(.js) .hero.is-intro .hero__title .hero__line { display: block; overflow: clip; }
  @media (max-width: 559px) { :global(.js) .hero.is-intro .hero__title .hero__line { display: inline; overflow: visible; } }
  /* the live wire under "confiable" (pseudo-elements: they survive SplitText's split/revert): drawn after the intro,
     a spark glides along it now and then */
  .hero__key { position: relative; display: inline-block; }
  .hero__key::after { content: ''; position: absolute; left: 0.02em; right: 0.1em; bottom: 0.02em; height: 3px; border-radius: 3px; background: var(--grad-brand); box-shadow: 0 0 12px rgba(255, 140, 60, 0.7); transform-origin: 0 50%; transition: transform 0.9s var(--ease-in-out) 0.1s; }
  .hero__key::before { content: ''; position: absolute; z-index: 1; left: 0; right: 0.1em; bottom: calc(0.02em - 5px); height: 13px; pointer-events: none; opacity: 0; background: radial-gradient(closest-side, #fff 0%, rgba(255, 236, 200, 0.95) 35%, rgba(255, 170, 80, 0) 100%) no-repeat 0 50% / 44px 100%; }
  .hero.is-live .hero__key::before { animation: hero-wire 5.2s cubic-bezier(0.6, 0, 0.35, 1) 1.2s infinite; }
  @keyframes hero-wire { 0% { transform: translate3d(-4%, 0, 0); opacity: 0; } 4% { opacity: 1; } 30% { opacity: 1; } 36%, 100% { transform: translate3d(96%, 0, 0); opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .hero:not(.is-live) .hero__key::after { transform: scaleX(0); } }

  /* lens-meter: an ungridded copy of the H1 filled with the brand gradient, magnified inside a circle that follows the pointer */
  .hero__lens {
    position: absolute; inset: 0; pointer-events: none; user-select: none;
    /* the whole orange → gold ramp inside the circle, not a 170 px slice of a title-wide gradient */
    background: linear-gradient(115deg, var(--orange-500) 10%, #ff9c5c 45%, var(--glow) 90%) calc(var(--lx) - var(--lr)) calc(var(--ly) - var(--lr)) / calc(var(--lr) * 2 + 1px) calc(var(--lr) * 2 + 1px) no-repeat;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    clip-path: circle(var(--lr) at var(--lx) var(--ly));
    transform: scale(1.12); transform-origin: var(--lx) var(--ly);
  }
  /* the white title gets a hole under the glass (no doubled letters) while the lens is open */
  .hero__title-wrap.is-lens > .hero__title:not(.hero__lens) {
    -webkit-mask: radial-gradient(circle calc(var(--lr) * 1.12) at var(--lx) var(--ly), transparent 97%, #000 100%);
    mask: radial-gradient(circle calc(var(--lr) * 1.12) at var(--lx) var(--ly), transparent 97%, #000 100%);
  }
  .hero__ring {
    position: absolute; left: 0; top: 0; width: var(--rd); height: var(--rd); margin: calc(var(--rd) / -2) 0 0 calc(var(--rd) / -2);
    border-radius: 50%; pointer-events: none; border: 1.5px solid rgba(255, 215, 154, 0.95);
    background: radial-gradient(closest-side, rgba(255, 150, 70, 0) 70%, rgba(255, 150, 70, 0.14) 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12), inset 0 0 30px rgba(255, 140, 60, 0.28), 0 0 40px -4px rgba(255, 140, 60, 0.55), 0 16px 44px -14px rgba(0, 0, 0, 0.7);
    transform: translate3d(var(--lx), var(--ly), 0) scale(var(--ls)); opacity: min(1, calc(var(--ls) * 3));
  }
  /* dial ticks, slowly turning like a meter's selector */
  .hero__ring::before {
    content: ''; position: absolute; inset: 4px; border-radius: 50%;
    background: repeating-conic-gradient(from 0deg, rgba(255, 215, 154, 0.7) 0deg 1.2deg, transparent 1.2deg 15deg);
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 7px), #000 calc(100% - 6px)); mask: radial-gradient(closest-side, transparent calc(100% - 7px), #000 calc(100% - 6px));
    animation: hero-dial 16s linear infinite;
  }
  @keyframes hero-dial { to { transform: rotate(360deg); } }
  /* the probe: a gold tip on the rim with its lead going off to the upper left */
  .hero__probe { position: absolute; left: 14.6%; top: 14.6%; width: 9px; height: 9px; margin: -4.5px; border-radius: 50%; background: var(--glow); box-shadow: 0 0 0 3px rgba(255, 180, 84, 0.25), 0 0 14px 3px rgba(255, 170, 70, 0.85); }
  .hero__probe::after { content: ''; position: absolute; left: 50%; top: 50%; width: 46px; height: 2px; margin-top: -1px; border-radius: 2px; background: linear-gradient(90deg, var(--orange-400), transparent); transform-origin: 0 50%; transform: rotate(-135deg) translateX(8px); }

  .hero__act { margin-top: clamp(16px, 3vh, 30px); }
  .hero__lead { margin: 0; max-width: 46ch; font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem); color: rgba(244, 246, 251, 0.82); }
  .hero__ctas { margin-top: clamp(18px, 3.2vh, 30px); }
  .hero__ctas .btn--ghost { background: rgba(6, 13, 31, 0.35); }
  .hero__facts { list-style: none; margin: clamp(16px, 3vh, 28px) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 26px; font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .hero__facts li { display: inline-flex; align-items: center; gap: 8px; }
  .hero__facts :global(svg) { color: var(--accent); }

  /* bridge line (desktop pin only) */
  .hero__bridge { display: none; position: absolute; left: 0; right: 0; bottom: clamp(8px, 3vh, 36px); margin: 0; max-width: 15ch; font-family: var(--font-display); font-weight: 700; font-size: min(clamp(2.4rem, 1rem + 3.2vw, 4.4rem), 9vh); line-height: 1.02; letter-spacing: -0.035em; pointer-events: none; }
  .hero__bw { display: inline-block; opacity: 0; }
  .hero__bridge-rule { display: block; width: min(60%, 360px); height: 2px; margin-top: 0.35em; border-radius: 2px; background: var(--grad-brand); box-shadow: 0 0 14px rgba(255, 140, 60, 0.7); transform: scaleX(0); transform-origin: 0 50%; }

  /* ---------- desktop wall: 3 drifting columns, tilted in 3D ---------- */
  /* the vertical fade lives on each column (and the sheen), inside the tilted plane: it scales with the rig when the
     pin shrinks it, so the wall dissolves instead of showing hard crop edges */
  .hero__wall { --fade: linear-gradient(180deg, transparent 0%, #000 13%, #000 86%, transparent 100%); display: none; position: relative; align-self: stretch; margin-right: calc(-1 * min(var(--gutter), 40px)); perspective: 1400px; }
  .hero__rig, .hero__wall-inner { height: 100%; transform-style: preserve-3d; }
  .hero__rig { transform: rotateY(-14deg) rotateX(5deg); transform-origin: 40% 50%; }
  .hero__wall-inner { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; will-change: transform; }
  /* 1024-1279: the near (right) edge of the tilt would bleed past the viewport */
  @media (max-width: 1279px) { .hero__wall { margin-right: 0; } .hero__rig { transform-origin: 62% 50%; } }
  .hero__col { position: relative; height: 100%; overflow: hidden; -webkit-mask-image: var(--fade); mask-image: var(--fade); }
  .hero__track { position: absolute; left: 0; right: 0; top: 0; }   /* out of flow: the loop never inflates the grid row */
  .hero__col:nth-child(2) .hero__track { margin-top: -40%; }
  .hero__col:nth-child(3) .hero__track { margin-top: -18%; }
  .hero__track img, .hero__rtrack img { display: block; width: 100%; height: auto; aspect-ratio: 640 / 811; object-fit: cover; border-radius: 12px; background: var(--navy-800); box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.06); user-select: none; }
  .hero__track img { margin-bottom: 14px; }
  .hero.is-drift .hero__track { animation: hero-up var(--dur) linear infinite; will-change: transform; }
  .hero.is-drift .hero__col[data-dir='down'] .hero__track { animation-direction: reverse; }
  @keyframes hero-up { to { transform: translate3d(0, -50%, 0); } }
  /* a slow light sweep across the wall, the ray motif again */
  .hero__sheen { position: absolute; inset: 0; pointer-events: none; overflow: hidden; transform: translateZ(1px); -webkit-mask-image: var(--fade); mask-image: var(--fade); }
  .hero__sheen i { position: absolute; inset: -10% -30%; background: linear-gradient(105deg, transparent 42%, rgba(255, 215, 154, 0.16) 49%, rgba(255, 255, 255, 0.22) 50%, rgba(255, 215, 154, 0.16) 51%, transparent 58%); transform: translate3d(-70%, 0, 0); }
  .hero.is-live .hero__sheen i { animation: hero-sheen 9s var(--ease-in-out) 2s infinite; }
  @keyframes hero-sheen { 0% { transform: translate3d(-70%, 0, 0); } 30%, 100% { transform: translate3d(70%, 0, 0); } }

  /* ---------- touch / < 1024 px: two rows on the diagonal ---------- */
  .hero__band { position: relative; width: 100vw; margin-left: calc(50% - 50vw); padding-block: clamp(18px, 4vw, 36px); pointer-events: none; }
  .hero__band-tilt { position: relative; display: grid; gap: 12px; transform: rotate(-6deg); margin-inline: -12vw; }
  .hero__row { overflow: hidden; }
  .hero__rtrack { display: flex; gap: 12px; width: max-content; padding-right: 12px; }
  .hero__rtrack img { width: clamp(108px, 23vw, 176px); flex: none; }
  .hero__row[data-dir='right'] .hero__rtrack { transform: translate3d(-12%, 0, 0); }
  .hero.is-drift .hero__rtrack { animation: hero-left var(--dur) linear infinite; will-change: transform; }
  .hero.is-drift .hero__row[data-dir='right'] .hero__rtrack { animation-direction: reverse; }
  @keyframes hero-left { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }
  /* the live wire between the rows */
  .hero__band-wire { position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; overflow: hidden; background: var(--grad-streak); box-shadow: 0 0 10px rgba(255, 150, 70, 0.8), 0 0 26px rgba(255, 110, 30, 0.45); }
  .hero__band-wire i { position: absolute; top: -3px; bottom: -3px; left: 0; width: 90px; background: radial-gradient(closest-side, #fff, rgba(255, 215, 154, 0.8) 40%, transparent); transform: translate3d(-100px, 0, 0); }
  .hero.is-live .hero__band-wire i { animation: hero-spark 4.2s cubic-bezier(0.55, 0, 0.35, 1) 0.8s infinite; }
  @keyframes hero-spark { 0% { transform: translate3d(-100px, 0, 0); } 55%, 100% { transform: translate3d(130vw, 0, 0); } }

  @media (min-width: 1024px) {
    .hero__wall { display: block; }
    .hero__band { display: none; }
  }

  /* ---------- scroll cue + marquee ---------- */
  /* scroll cue: in the wall's cell, over its faded bottom edge (never collides with the facts row) */
  .hero__scroll { display: none; position: relative; z-index: 2; min-height: 44px; padding-inline: 10px; align-items: center; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); text-shadow: 0 1px 10px rgba(6, 13, 31, 0.95); }
  .hero__scroll-in { display: inline-flex; align-items: center; gap: 12px; }
  .hero__scroll:hover { color: #fff; }
  .hero__scroll-line { position: relative; width: 44px; height: 1px; background: rgba(255, 255, 255, 0.25); overflow: hidden; }
  .hero__scroll-line::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, var(--glow), transparent); animation: hero-scan 1.8s var(--ease-in-out) infinite; }
  @keyframes hero-scan { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
  @media (min-width: 1024px) {
    .hero__copy { grid-area: 1 / 1; }
    .hero__wall { grid-area: 1 / 2; }
    .hero__scroll { display: inline-flex; grid-area: 1 / 2; align-self: end; justify-self: center; margin-bottom: 2px; }
  }

  .hero__marquee { position: relative; z-index: 1; border-top: 1px solid rgba(255, 255, 255, 0.08); background: rgba(6, 13, 31, 0.6); padding-block: clamp(12px, 1.8vh, 16px); }
  @media (pointer: fine) { .hero__marquee { -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); } }
  :global(.is-lite) .hero__marquee { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(6, 13, 31, 0.88); }
  .hero__mq { display: inline-flex; align-items: center; padding-right: 36px; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em; white-space: nowrap; color: rgba(255, 255, 255, 0.75); }
  .hero__mq i { width: 8px; height: 8px; margin-left: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--orange-500), var(--glow)); box-shadow: 0 0 12px rgba(255, 140, 60, 0.9); }

  /* ---------- desktop-fx only pieces ---------- */
  :global(.is-desktop-fx) .hero__bridge { display: block; }
  @media (max-width: 1023px) { :global(.is-desktop-fx) .hero__bridge { display: none; } }

  /* ---------- phones ---------- */
  @media (max-width: 1023px) {
    .hero__scrim { background: linear-gradient(180deg, rgba(6, 13, 31, 0.6) 0%, rgba(6, 13, 31, 0.45) 50%, rgba(6, 13, 31, 0.1) 78%, rgba(6, 13, 31, 0) 100%); }
  }
  @media (max-width: 559px) {
    .hero__facts { gap: 8px 16px; font-size: 0.75rem; letter-spacing: 0.06em; }
    .hero__band-tilt { gap: 10px; }
    .hero__rtrack { gap: 10px; padding-right: 10px; }
  }

  /* ---------- intro pre-hide (JS only, motion only; a 5 s fallback un-hides if the script never runs; once the
     script is armed its own watchdog takes over, so the CSS never pops things mid-intro) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero.is-intro :is(.hero__title, .hero__in, .hero__col, .hero__row) { opacity: 0; animation: hero-unhide 0.01s 5s forwards; }
    :global(.js) .hero.is-intro.is-armed :is(.hero__title, .hero__in, .hero__col, .hero__row) { animation: none; }
  }
  @keyframes hero-unhide { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .hero__lens, .hero__ring, .hero__pulse, .hero__packets, .hero__sheen, .hero__key::before, .hero__band-wire i { display: none; }
    .hero__glow { animation: none; }
    /* the claims stay one static line (the scoped display would otherwise un-hide the engine's clones) */
    .hero__mq[aria-hidden='true'] { display: none; }
    .hero__marquee :global(.marquee__track) { flex-wrap: nowrap; width: max-content; }
    .hero__marquee { -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); }
  }
</style>

<script>
  import { onPage } from '../../scripts/engine.js';

  onPage(({ gsap, SplitText, env, introGate, markLite, onRefresh, getLenis }) => {
    const root = document.getElementById('inicio');
    if (!root) return;
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const qa = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll(s)] as T[];
    const ctx = gsap.context(() => {}, root);                     // async tweens live here and die with the page
    const off: (() => void)[] = [];
    const listen = (t: EventTarget, ev: string, fn: any, o?: any) => { t.addEventListener(ev, fn, o); off.push(() => t.removeEventListener(ev, fn, o)); };
    let dead = false, split: any = null, gl: any = null, pinST: any = null;
    // async timelines are built inside a ticker tick: the engine runs lagSmoothing(0), so a timeline created right
    // after a long main-thread block would start from a stale clock and finish instantly
    const onTick = (fn: () => void) => gsap.ticker.add(() => { if (!dead) fn(); }, true);
    let introDone!: () => void;
    const intro = new Promise<void>((r) => { introDone = r; });

    const title = q('.hero__title');
    const wrap = q('.hero__title-wrap');
    const ins = qa('.hero__in');
    const cols = qa('.hero__col');
    const rows = qa('.hero__row');
    const streaks = qa('.hero__streaks line');

    /* ---------------- on/off screen: CSS loops and the field only while the hero is visible ---------------- */
    const sync = () => { if (gl) (!document.hidden && !root.classList.contains('is-off') ? gl.start() : gl.stop()); };
    const io = new IntersectionObserver(([e]) => { root.classList.toggle('is-off', !e.isIntersecting); sync(); });
    io.observe(root);
    off.push(() => io.disconnect());
    listen(document, 'visibilitychange', sync);

    /* ---------------- endless drift: one loop unit (taller than its column on tall portrait screens), doubled ---------------- */
    if (!env.reduced) {
      qa('.hero__track, .hero__rtrack').forEach((t) => {
        if (t.dataset.ready) return;
        t.dataset.ready = '1';
        const set = t.innerHTML, need = t.matches('.hero__track') ? t.parentElement!.clientHeight * 1.2 : 0;   // a hidden wall measures 0
        for (let i = 0; i < 3 && t.offsetHeight < need; i++) t.innerHTML += set;
        t.innerHTML += t.innerHTML;
      });
      root.classList.add('is-drift');
    }

    /* ---------------- lens-meter ---------------- */
    const lens = { x: 0, y: 0, r: 0 };
    const R = env.desktop ? 76 : 52;
    wrap.style.setProperty('--rd', `${Math.round(2 * R * 1.12)}px`);   // the ring matches the scaled lens circle
    const paint = () => {
      wrap.style.setProperty('--lx', `${lens.x}px`);
      wrap.style.setProperty('--ly', `${lens.y}px`);
      wrap.style.setProperty('--lr', `${lens.r}px`);
      wrap.style.setProperty('--ls', (lens.r / R).toFixed(3));
      wrap.classList.toggle('is-lens', lens.r > 0.5);
    };
    // the title's box inside the root, measured lazily once per refresh while the pin has not moved the head yet
    let tbox: { x: number; y: number; w: number; h: number } | null = null;
    let lensMove: ((e: PointerEvent, top: number) => void) | null = null;
    let lensClose: (() => void) | null = null;                     // the pin and a pointer leaving the window close it
    const lensOn = () => {
      if (env.reduced || dead) return;
      if (env.desktop) {
        const mx = gsap.quickTo(lens, 'x', { duration: 0.35, ease: 'power3.out', onUpdate: paint });
        const my = gsap.quickTo(lens, 'y', { duration: 0.35, ease: 'power3.out', onUpdate: paint });
        let inside = false;
        const setR = (v: number) => gsap.to(lens, { r: v, duration: 0.3, ease: 'power2.out', overwrite: 'auto', onUpdate: paint });
        lensMove = (e, top) => {
          const on = !pinST || pinST.progress < 0.2;
          if (!on && !inside) return;                              // pinned past the lens: nothing to read or paint
          if (on && !tbox) { const r = root.getBoundingClientRect(), b = wrap.getBoundingClientRect(); tbox = { x: b.left, y: b.top - r.top, w: b.width, h: b.height }; }
          const x = e.clientX - (tbox?.x ?? 0), y = e.clientY - top - (tbox?.y ?? 0);
          const now = on && !!tbox && x > -24 && y > -24 && x < tbox.w + 24 && y < tbox.h + 24;
          if (now && !inside) { lens.x = x; lens.y = y; }
          if (now) { mx(x); my(y); }
          if (now !== inside) { inside = now; setR(now ? R : 0); }
        };
        lensClose = () => { if (inside) { inside = false; setR(0); } };
        listen(document.documentElement, 'mouseleave', lensClose);
      } else {
        // touch: one scripted sweep across "confiable", then the lens closes
        const key = q('.hero__key');
        const b = wrap.getBoundingClientRect(), k = key.getBoundingClientRect();
        const x0 = k.left - b.left, x1 = k.right - b.left;
        lens.x = x0 - R * 0.4; lens.y = k.top - b.top + k.height * 0.5;
        ctx.add(() => gsap.timeline({ delay: 0.35, onUpdate: paint })
          .to(lens, { r: R, duration: 0.4, ease: 'power2.out' }, 0)
          .to(lens, { x: x1 - R * 0.2, duration: 1.9, ease: 'power1.inOut' }, 0)
          .to(lens, { r: 0, duration: 0.45, ease: 'power2.in' }, 1.75));
      }
    };

    /* ---------------- intro ---------------- */
    if (env.reduced) {
      root.classList.remove('is-intro');
      introDone();
    } else {
      root.classList.add('is-armed');                               // from here the JS owns the pre-hide (CSS fallback off)
      gsap.set(ins, { autoAlpha: 0, y: 24 });
      gsap.set(cols, { autoAlpha: 0, y: 120 });
      gsap.set(rows, { autoAlpha: 0, x: (i: number) => (i ? -90 : 90) });
      gsap.set(streaks, { drawSVG: '0%' });
      let started = false;
      const finish = () => { split?.revert(); split = null; root.classList.remove('is-intro'); root.classList.add('is-live'); lensOn(); introDone(); };
      // watchdog: the intro normally starts ≤ 3 s after init (loader gate timeout); if it has not by 4.5 s (a stalled
      // promise, a background tab), show the final state instead of leaving the hero hidden
      const dog = setTimeout(() => {
        if (started || dead) return;
        started = true;
        gsap.set([title, ...ins, ...cols, ...rows], { autoAlpha: 1, x: 0, y: 0 });
        gsap.set(streaks, { drawSVG: '100%' });
        finish();
      }, 4500);
      off.push(() => clearTimeout(dog));
      const fonts = Promise.race([document.fonts?.ready ?? Promise.resolve(), new Promise((r) => setTimeout(r, 900))]);
      Promise.all([fonts, introGate()]).then(() => onTick(() => { if (started) return; started = true; clearTimeout(dog); ctx.add(() => {
        const byChar = env.desktop;
        split = new SplitText(title, { type: byChar ? 'chars,words' : 'words', charsClass: 'hero-ch', wordsClass: 'hero-w' });
        const pieces = byChar ? split.chars : split.words;
        gsap.set(title, { opacity: 1 });
        gsap.timeline({ defaults: { ease: 'expo.out' }, onComplete: finish })
          .fromTo(pieces, byChar ? { yPercent: 115, filter: 'blur(8px)' } : { yPercent: 60, opacity: 0 },
            { yPercent: 0, opacity: 1, filter: 'blur(0px)', duration: 1, stagger: byChar ? 0.022 : 0.07, clearProps: 'filter' }, 0)
          .fromTo(streaks, { drawSVG: '0%' }, { drawSVG: '100%', duration: 1.5, ease: 'power2.inOut', stagger: 0.12 }, 0.05)
          .to(cols, { autoAlpha: 1, y: 0, duration: 1.4, stagger: 0.12, ease: 'power4.out' }, 0.15)
          .to(rows, { autoAlpha: 1, x: 0, duration: 1.3, stagger: 0.1, ease: 'power4.out' }, 0.35)
          .to(ins, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.08 }, 0.3);
      }); }));
    }

    /* ---------------- field hand-off: the loader's ray leaves where the field is first stirred ---------------- */
    let drop: { x: number; y: number } | null = null;
    const splash = (p?: { x: number; y: number } | null) => {
      if (!gl) return;
      const c = q('.hero__gl').getBoundingClientRect();
      const t = title.getBoundingClientRect();
      const at = p || drop || { x: t.left + t.width * 0.55, y: t.top + t.height * 0.5 };
      gl.pulse(at.x - c.left, at.y - c.top);
    };
    listen(document, 'ssds:loader-done', (e: CustomEvent) => { drop = e.detail?.x != null ? e.detail : null; splash(); });

    /* ---------------- desktop: pointer, pin, field ---------------- */
    const depth = { v: 0 };
    const mm = gsap.matchMedia();
    // no layout reads per pointermove: the canvas covers the root, whose viewport top follows from the (cached) Lenis
    // scroll and the pin; the hero is full-width, so its left edge is 0
    let docTop = 0;
    const scrollNow = () => getLenis()?.scroll ?? window.scrollY;
    const rootTop = () => { const s = scrollNow(); return pinST ? Math.max(0, pinST.start - s) + Math.min(0, pinST.end - s) : docTop - s; };
    onRefresh(() => { tbox = null; docTop = root.getBoundingClientRect().top + scrollNow(); });
    if (env.desktop) {
      const inner = q('.hero__wall-inner');
      const rig = q('.hero__rig');
      const xTo = gsap.quickTo(inner, 'x', { duration: 1.4, ease: 'power3.out' });
      const yTo = gsap.quickTo(inner, 'y', { duration: 1.4, ease: 'power3.out' });
      const ryTo = gsap.quickTo(inner, 'rotationY', { duration: 1.4, ease: 'power3.out' });
      const rxTo = gsap.quickTo(inner, 'rotationX', { duration: 1.4, ease: 'power3.out' });
      listen(window, 'pointermove', (e: PointerEvent) => {
        if (root.classList.contains('is-off')) return;
        const top = rootTop();
        gl?.pointer(e.clientX, e.clientY - top);
        lensMove?.(e, top);
        if (pinST && pinST.progress >= 0.2) return;
        const px = e.clientX / innerWidth - 0.5, py = e.clientY / innerHeight - 0.5;
        xTo(px * -26); yTo(py * -20); ryTo(px * -8); rxTo(py * 6);
      }, { passive: true });
      // a click in the empty field sends a shockwave through it
      listen(root, 'pointerdown', (e: PointerEvent) => { if (!(e.target as Element).closest('a, button')) splash({ x: e.clientX, y: e.clientY }); });

      mm.add('(min-width: 1024px)', () => {
        const bw = qa('.hero__bw');
        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: { trigger: root, start: 'top top', end: '+=100%', pin: true, scrub: 0.6, anticipatePin: 1, invalidateOnRefresh: true, onUpdate: (st: any) => { if (st.progress >= 0.2) lensClose?.(); } },
        });
        pinST = tl.scrollTrigger;
        tl.to(depth, { v: 1, duration: 1, onUpdate: () => gl?.setDepth(depth.v) }, 0)
          .fromTo(q('.hero__deep'), { opacity: 0 }, { opacity: 0.85, duration: 1 }, 0)
          .fromTo(rig, { rotationY: -14, rotationX: 5, scale: 1, x: 0, y: 0 }, { rotationY: 0, rotationX: 0, scale: 0.8, x: () => -innerWidth * 0.02, y: () => -innerHeight * 0.05, duration: 1, ease: 'power1.inOut' }, 0)
          .fromTo(q('.hero__wall'), { opacity: 1 }, { opacity: 0.7, duration: 1 }, 0)   // not on the rig: opacity would flatten its 3D
          .fromTo(q('.hero__scroll'), { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.12 }, 0)
          .fromTo(q('.hero__act'), { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -34, duration: 0.3, ease: 'power1.in' }, 0.22)
          .fromTo(q('.hero__head'), { y: 0, filter: 'blur(0px)', opacity: 1 }, { y: () => -innerHeight * 0.08, filter: 'blur(3px)', opacity: 0.55, duration: 0.6, ease: 'power1.in' }, 0.4)
          .fromTo(bw, { opacity: 0, yPercent: 60 }, { opacity: 1, yPercent: 0, duration: 0.14, stagger: 0.05, ease: 'power2.out' }, 0.56)
          .fromTo(q('.hero__bridge-rule'), { scaleX: 0 }, { scaleX: 1, duration: 0.22, ease: 'power2.out' }, 0.76)
          .set({}, {}, 1);
        return () => { pinST = null; };
      });
    }

    if (env.desktop && !env.lite) {
      const canvas = q<HTMLCanvasElement>('.hero__gl');
      const idle = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 300));
      const cancelIdle = (window as any).cancelIdleCallback || clearTimeout;
      let idleId = 0;
      // another scene measured a slow machine: fade the canvas out on its last frame, then release the context
      const drop_ = () => { const g = gl; gl = null; root.classList.remove('is-gl'); if (g) { g.stop(); setTimeout(() => g.destroy(), 1300); } };
      // compile after the intro so it never stutters the title; the poster is the first frame meanwhile
      intro.then(() => { if (!dead) idleId = idle(async () => {
        let mod;
        try { mod = await import('../../scripts/hero/campo.js'); } catch (err) { return; }
        if (dead || env.lite) return;
        // slow = sustained < 22 fps → the whole session goes lite; a lost context only drops GL here
        gl = mod.createCampo(canvas, { onDegrade: (slow: boolean) => { gl = null; root.classList.remove('is-gl'); if (slow) markLite(); } });
        if (!gl) return;
        gl.setDepth(depth.v);
        sync();
        requestAnimationFrame(() => { if (!gl) return; root.classList.add('is-gl'); splash(); });
      }, { timeout: 1500 }); });
      listen(document, 'ssds:lite', drop_);
      off.push(() => cancelIdle(idleId));
    }

    return () => {
      dead = true;
      off.forEach((f) => f());
      split?.revert();
      mm.revert();
      ctx.revert();
      gl?.destroy(); gl = null;
      root.classList.remove('is-gl', 'is-live', 'is-drift', 'is-off', 'is-armed');
      wrap.classList.remove('is-lens');
      root.classList.add('is-intro');
    };
  });
</script>
