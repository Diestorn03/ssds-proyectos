---
/**
 * Loader "El Arranque": first visit per session only, never under reduced motion, never without JS.
 * Pure CSS timeline that runs ONLY on the compositor (transform + opacity), so it stays perfectly smooth while the
 * main thread is busy parsing/booting the page underneath: the two halves of the hexagonal mark swing in, the S
 * strokes slide into place, a spark travels the outline (translate keyframes), the wordmark wipes in behind a
 * sliding cover, the tagline rises, the brand ray crosses and the curtain lifts (translateY). ~1.5 s in total.
 * The engine boots the page UNDERNEATH the loader (engine.js start()); the exit (.is-go) waits until the mark has
 * played (1 s) AND the engine is ready ('ssds:ready' + the refresh it queues), capped at 2.8 s, so the curtain never
 * lifts on a page that is about to freeze while it boots. The inline script removes #loader when it must not run, so
 * introGate() resolves at once; otherwise it dispatches 'ssds:loader-done' (detail {x, y}, also left in
 * window.__ssdsDrop for late listeners).
 */
---
<div id="loader" class="loader" data-theme="dark">
  <div class="loader__stage" aria-hidden="true">
    <div class="loader__markbox">
      <svg class="loader__mark" viewBox="0 0 100 100" width="120" height="120" focusable="false">
        <g class="ld ld-1"><polyline points="14,71 14,29 50,8 86,29" /></g>
        <g class="ld ld-2"><polyline points="86,29 86,71 50,92 14,71" /></g>
        <g class="ld ld-3"><path d="M66 32 H38 a6 6 0 0 0 -6 6 v6 a6 6 0 0 0 6 6 H50" /></g>
        <g class="ld ld-4"><path d="M50 50 H62 a6 6 0 0 1 6 6 v6 a6 6 0 0 1 -6 6 H34" /></g>
      </svg>
      <span class="loader__spark"></span>
    </div>
    <span class="loader__wordbox"><span class="loader__word">SSD<b>&amp;</b>S <small>C.A.</small></span><span class="loader__cover"></span></span>
    <span class="loader__tag">Potencia e Ingeniería Industrial</span>
  </div>
  <span class="loader__ray" aria-hidden="true"></span>
  <button class="loader__skip" type="button">Saltar intro <span aria-hidden="true">→</span></button>
</div>

<script is:inline>
  (function () {
    var l = document.getElementById('loader');
    if (!l) return;
    var root = document.documentElement, show = false;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    try { show = !reduced && !window.__ssdsIntro && !sessionStorage.getItem('ssds-intro'); sessionStorage.setItem('ssds-intro', '1'); }
    catch (e) { show = !reduced && !window.__ssdsIntro; }
    window.__ssdsIntro = 1;
    if (!show) { l.remove(); return; }
    root.classList.add('ssds-intro');
    var finished = false, played = false, ready = false;
    function done() {
      if (finished) return; finished = true;
      l.classList.add('is-done');
      root.classList.remove('ssds-intro');
      document.removeEventListener('keydown', onKey);
      var drop = { x: innerWidth * 0.5, y: innerHeight * 0.45 };
      window.__ssdsDrop = drop;
      document.dispatchEvent(new CustomEvent('ssds:loader-done', { detail: drop }));
      setTimeout(function () { l.remove(); }, 60);
    }
    // exit once the mark has played and the page underneath is booted (its queued ScrollTrigger refresh included)
    // the safety net counts from the exit, not from page start: when a long boot task delays both timers they would
    // otherwise fire together and the curtain would vanish instead of lifting
    function go() { if (l.classList.contains('is-go')) return; l.classList.add('is-go'); setTimeout(done, 1000); }
    function maybeGo() { if (played && ready) go(); }
    // (timed from the first frame: that is when the CSS timeline actually starts)
    requestAnimationFrame(function () { setTimeout(function () { played = true; maybeGo(); }, 1000); });
    document.addEventListener('ssds:ready', function () {
      requestAnimationFrame(function () { requestAnimationFrame(function () { ready = true; maybeGo(); }); });
    }, { once: true });
    setTimeout(go, 2800); // never hold the curtain longer than this
    function skip() { l.classList.add('is-skip'); setTimeout(done, 800); }
    function onKey(e) { if (e.key === 'Escape') skip(); }
    l.addEventListener('animationend', function (e) { if (e.target === l) done(); });
    l.querySelector('.loader__skip').addEventListener('click', skip);
    document.addEventListener('keydown', onKey);
    // safety net: go() and skip() arm done() (animationend normally fires ~0.55 s after .is-go)
  })();
</script>

<style>
  .loader { display: none; }
  :global(html.ssds-intro) .loader {
    position: fixed; inset: 0; z-index: var(--z-loader); display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(70% 55% at 50% 45%, #10244f 0%, var(--navy-950) 70%);
    color: #fff;
    will-change: transform;
  }
  :global(html.ssds-intro) .loader.is-go { animation: loader-exit 0.5s cubic-bezier(0.76, 0, 0.24, 1) 0.05s forwards; }
  :global(html.ssds-intro) .loader.is-skip { animation: loader-exit 0.32s cubic-bezier(0.76, 0, 0.24, 1) forwards; }
  /* the curtain lifts (transform only: never janks, whatever the main thread is doing) */
  @keyframes loader-exit { to { transform: translate3d(0, -100%, 0); } }

  .loader__stage { display: grid; justify-items: center; gap: 14px; will-change: transform, opacity; }
  .loader.is-go .loader__stage, .loader.is-skip .loader__stage { animation: stage-out 0.45s cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  @keyframes stage-out { to { transform: translate3d(0, -8vh, 0) scale(0.96); opacity: 0; } }

  /* ---------- the mark: the two halves swing in, then the S strokes slide into place ---------- */
  .loader__markbox { position: relative; width: clamp(84px, 11vw, 124px); aspect-ratio: 1; }
  .loader__mark { width: 100%; height: 100%; overflow: visible; }
  .ld { transform-box: view-box; transform-origin: 50% 50%; opacity: 0; will-change: transform, opacity; }
  .ld :is(polyline, path) { fill: none; stroke-width: 10; stroke-linejoin: round; stroke-linecap: round; }
  .ld-1 :is(polyline, path), .ld-3 :is(polyline, path) { stroke: var(--orange-500); }
  .ld-2 :is(polyline, path), .ld-4 :is(polyline, path) { stroke: #fff; }
  .ld-1 { animation: ld-swing-a 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s forwards; }
  .ld-2 { animation: ld-swing-b 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.13s forwards; }
  .ld-3 { animation: ld-slide-a 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards; }
  .ld-4 { animation: ld-slide-b 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.38s forwards; }
  @keyframes ld-swing-a { from { opacity: 0; transform: rotate(-70deg) scale(0.6); } 40% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes ld-swing-b { from { opacity: 0; transform: rotate(70deg) scale(0.6); } 40% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes ld-slide-a { from { opacity: 0; transform: translate3d(18%, 0, 0); } to { opacity: 1; transform: none; } }
  @keyframes ld-slide-b { from { opacity: 0; transform: translate3d(-18%, 0, 0); } to { opacity: 1; transform: none; } }

  /* the spark runs the hexagon outline once (translate keyframes on the vertices: composited) */
  .loader__spark {
    position: absolute; left: 0; top: 0; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 6px 2px #ffd79a, 0 0 16px 4px rgba(255, 140, 60, 0.85);
    opacity: 0; will-change: transform, opacity;
    animation: spark-run 0.8s linear 0.12s forwards;
  }
  @keyframes spark-run {
    0% { opacity: 1; transform: translate3d(14cqw, 71cqw, 0); }
    16.6% { transform: translate3d(14cqw, 29cqw, 0); }
    33.3% { transform: translate3d(50cqw, 8cqw, 0); }
    50% { transform: translate3d(86cqw, 29cqw, 0); }
    66.6% { transform: translate3d(86cqw, 71cqw, 0); }
    83.3% { transform: translate3d(50cqw, 92cqw, 0); opacity: 1; }
    100% { transform: translate3d(14cqw, 71cqw, 0); opacity: 0; }
  }
  .loader__markbox { container-type: inline-size; }

  /* ---------- wordmark: a navy cover slides off it (transform), tagline rises ---------- */
  .loader__wordbox { position: relative; display: inline-block; overflow: hidden; line-height: 1; padding: 0.06em 0.12em 0.1em 0.04em; }
  .loader__word { display: inline-block; font-family: var(--font-display); font-weight: 800; font-style: italic; letter-spacing: -0.04em; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1; opacity: 0; transform: translate3d(-12%, 0, 0); will-change: transform, opacity; animation: word-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.42s forwards; }
  .loader__word b { color: var(--orange-500); font-weight: inherit; }
  .loader__word small { font-size: 0.4em; font-weight: 600; font-style: normal; letter-spacing: 0.08em; margin-left: 0.15em; vertical-align: 0.2em; opacity: 0.85; }
  @keyframes word-in { to { opacity: 1; transform: none; } }
  .loader__cover { position: absolute; inset: 0; background: linear-gradient(90deg, var(--orange-500), #ffd79a); transform: translate3d(-101%, 0, 0); will-change: transform; animation: cover-wipe 0.62s cubic-bezier(0.76, 0, 0.24, 1) 0.34s forwards; }
  @keyframes cover-wipe { 0% { transform: translate3d(-101%, 0, 0); } 45% { transform: translate3d(0, 0, 0); } 100% { transform: translate3d(101%, 0, 0); } }
  .loader__tag { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); opacity: 0; transform: translate3d(0, 8px, 0); will-change: transform, opacity; animation: tag-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.62s forwards; }
  @keyframes tag-in { to { opacity: 1; transform: none; } }

  /* the brand ray crosses the curtain just before it lifts */
  .loader__ray { position: absolute; left: -30%; top: 50%; width: 160%; height: 2px; background: var(--grad-streak); box-shadow: 0 0 10px 1px rgba(255, 150, 70, 0.8); transform: rotate(-14deg) translate3d(-110%, 0, 0); will-change: transform; animation: ray-cross 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.6s forwards; pointer-events: none; }
  @keyframes ray-cross { to { transform: rotate(-14deg) translate3d(110%, 0, 0); } }

  .loader__skip {
    position: absolute; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 48px; padding: 0 1.1rem; border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.18); background: transparent; color: var(--muted);
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
  }
  .loader__skip:hover { color: #fff; border-color: var(--orange-500); }
  @media (prefers-reduced-motion: reduce) { :global(html.ssds-intro) .loader { display: none; } }
</style>
