---
/**
 * Loader "El Arranque": first visit per session only, never under reduced motion, never without JS.
 * Pure CSS timeline (starts on first paint, independent of the JS bundle): the hexagonal mark draws itself
 * (4 strokes, 90 ms stagger), a spark runs the outline, the wordmark sweeps in, the tagline spaces out, the brand
 * ray crosses the screen and the curtain leaves upward with clip-path. ~1.25 s in total.
 * The inline script removes #loader when it must not run, so introGate() resolves at once; otherwise it dispatches
 * 'ssds:loader-done' (detail {x, y} = where the ray leaves, used by the hero to stir its field).
 */
---
<div id="loader" class="loader" data-theme="dark">
  <div class="loader__stage" aria-hidden="true">
    <svg class="loader__mark" viewBox="0 0 100 100" width="120" height="120" focusable="false">
      <polyline class="ld ld-1" points="14,71 14,29 50,8 86,29" pathLength="1" />
      <polyline class="ld ld-2" points="86,29 86,71 50,92 14,71" pathLength="1" />
      <path class="ld ld-3" d="M66 32 H38 a6 6 0 0 0 -6 6 v6 a6 6 0 0 0 6 6 H50" pathLength="1" />
      <path class="ld ld-4" d="M50 50 H62 a6 6 0 0 1 6 6 v6 a6 6 0 0 1 -6 6 H34" pathLength="1" />
      <circle class="loader__spark" r="3.5" />
    </svg>
    <span class="loader__word">SSD<b>&amp;</b>S <small>C.A.</small></span>
    <span class="loader__tag">Potencia e Ingeniería Industrial</span>
  </div>
  <span class="loader__ray" aria-hidden="true"></span>
  <button class="loader__skip" type="button">Saltar intro <span aria-hidden="true">→</span></button>
</div>

<script is:inline>
  (function () {
    var l = document.getElementById('loader');
    if (!l) return;
    var root = document.documentElement, show = false;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    try { show = !reduced && !window.__ssdsIntro && !sessionStorage.getItem('ssds-intro'); sessionStorage.setItem('ssds-intro', '1'); }
    catch (e) { show = !reduced && !window.__ssdsIntro; }
    window.__ssdsIntro = 1;
    if (!show) { l.remove(); return; }
    root.classList.add('ssds-intro');
    var finished = false;
    function done() {
      if (finished) return; finished = true;
      l.classList.add('is-done');
      root.classList.remove('ssds-intro');
      document.removeEventListener('keydown', onKey);
      document.dispatchEvent(new CustomEvent('ssds:loader-done', { detail: { x: innerWidth * 0.5, y: innerHeight * 0.45 } }));
      setTimeout(function () { l.remove(); }, 60);
    }
    function skip() { l.classList.add('is-skip'); }
    function onKey(e) { if (e.key === 'Escape') skip(); }
    l.addEventListener('animationend', function (e) { if (e.target === l) done(); });
    l.querySelector('.loader__skip').addEventListener('click', skip);
    document.addEventListener('keydown', onKey);
    setTimeout(done, 2600); // safety net
  })();
</script>

<style>
  .loader { display: none; }
  :global(html.ssds-intro) .loader {
    position: fixed; inset: 0; z-index: var(--z-loader); display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(70% 55% at 50% 45%, #10244f 0%, var(--navy-950) 70%);
    color: #fff;
    clip-path: inset(0 0 0 0);
    animation: loader-exit 0.38s cubic-bezier(0.65, 0, 0.35, 1) 0.95s forwards;
  }
  :global(html.ssds-intro) .loader.is-skip { animation: loader-skip 0.28s cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  @keyframes loader-exit { to { clip-path: inset(0 0 100% 0); } }
  @keyframes loader-skip { from { clip-path: inset(0 0 0 0); } to { clip-path: inset(0 0 100% 0); } }

  .loader__stage { display: grid; justify-items: center; gap: 14px; animation: stage-out 0.36s cubic-bezier(0.65, 0, 0.35, 1) 0.95s forwards; }
  @keyframes stage-out { to { transform: translateY(-6vh); opacity: 0; } }

  .loader__mark { width: clamp(84px, 11vw, 124px); height: auto; overflow: visible; }
  .ld { fill: none; stroke-width: 10; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: ld-draw 0.5s cubic-bezier(0.33, 1, 0.68, 1) forwards; }
  .ld-1, .ld-3 { stroke: var(--orange-500); }
  .ld-2, .ld-4 { stroke: #fff; }
  .ld-2 { animation-delay: 0.09s; }
  .ld-3 { animation-delay: 0.18s; }
  .ld-4 { animation-delay: 0.27s; }
  @keyframes ld-draw { to { stroke-dashoffset: 0; } }
  /* the spark runs the hexagon once while it draws */
  .loader__spark { fill: #fff; filter: drop-shadow(0 0 4px #ffd79a) drop-shadow(0 0 10px rgba(255, 140, 60, 0.9)); offset-path: path('M14 71 L14 29 L50 8 L86 29 L86 71 L50 92 Z'); offset-distance: 0%; opacity: 0; animation: spark-run 0.75s cubic-bezier(0.33, 1, 0.68, 1) 0.05s forwards; }
  @keyframes spark-run { 0% { opacity: 1; offset-distance: 0%; } 90% { opacity: 1; } 100% { opacity: 0; offset-distance: 100%; } }

  .loader__word { font-family: var(--font-display); font-weight: 800; font-style: italic; letter-spacing: -0.04em; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1; clip-path: inset(0 100% 0 0); animation: word-in 0.4s cubic-bezier(0.33, 1, 0.68, 1) 0.42s forwards; }
  .loader__word b { color: var(--orange-500); font-weight: inherit; }
  .loader__word small { font-size: 0.4em; font-weight: 600; font-style: normal; letter-spacing: 0.08em; margin-left: 0.15em; vertical-align: 0.2em; opacity: 0.85; }
  @keyframes word-in { to { clip-path: inset(0 0 0 0); } }
  .loader__tag { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.4em; text-transform: uppercase; color: var(--muted); opacity: 0; animation: tag-in 0.45s cubic-bezier(0.33, 1, 0.68, 1) 0.6s forwards; }
  @keyframes tag-in { from { opacity: 0; letter-spacing: 0.4em; } to { opacity: 1; letter-spacing: 0.2em; } }

  /* the brand ray crosses the curtain just before it leaves */
  .loader__ray { position: absolute; left: -30%; top: 50%; width: 160%; height: 2px; background: var(--grad-streak); filter: drop-shadow(0 0 6px rgba(255, 150, 70, 0.9)) drop-shadow(0 0 22px rgba(255, 110, 30, 0.55)); transform: rotate(-14deg) translateX(-110%); animation: ray-cross 0.55s cubic-bezier(0.65, 0, 0.35, 1) 0.6s forwards; pointer-events: none; }
  @keyframes ray-cross { to { transform: rotate(-14deg) translateX(110%); } }

  .loader__skip {
    position: absolute; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 48px; padding: 0 1.1rem; border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.18); background: transparent; color: var(--muted);
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
  }
  .loader__skip:hover { color: #fff; border-color: var(--orange-500); }
  @media (prefers-reduced-motion: reduce) { :global(html.ssds-intro) .loader { display: none; } }
</style>
