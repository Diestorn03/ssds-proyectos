---
/**
 * Floating WhatsApp (tablets and up) and the mobile action bar "Llamar · WhatsApp" (phones).
 * Both stay hidden until the reader is past the hero and hide again over blocks marked [data-fab-hide]
 * (they carry their own WhatsApp buttons). Visibility is driven by scripts/chrome.js (.is-shown).
 */
import Icon from '../ui/Icon.astro';
import { wa, contact } from '../../data/site.js';
---
<a class="fab" href={wa()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" data-magnetic="0.3" transition:name="ssds-fab">
  <span class="fab__ring" aria-hidden="true"></span>
  <Icon name="whatsapp" size={24} stroke={2} />
  <span class="fab__label">WhatsApp</span>
</a>
<div class="abar" transition:name="ssds-bar">
  <a class="abar__btn" href={`tel:${contact.phoneE164}`}><Icon name="phone" size={18} />Llamar</a>
  <a class="abar__btn abar__btn--wa" href={wa()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
</div>

<style>
  .fab { position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: var(--z-fab); display: none; align-items: center; gap: 10px; padding: 12px 18px 12px 14px; border-radius: var(--r-pill); background: var(--wa); color: #062a16; font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; box-shadow: 0 14px 34px -10px rgba(37, 211, 102, 0.7); transform: translateY(140%); opacity: 0; transition: transform 0.6s var(--ease-out), opacity 0.4s, box-shadow 0.5s var(--ease-out); }
  .fab.is-shown { transform: none; opacity: 1; }
  .fab:hover { box-shadow: 0 20px 40px -10px rgba(37, 211, 102, 0.8); }
  .fab svg { width: 24px; height: 24px; }
  .fab__ring { position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--wa); animation: fab-pulse 2.4s ease-out infinite; pointer-events: none; }
  @keyframes fab-pulse { 0% { transform: scale(1); opacity: 0.8; } 100% { transform: scale(1.35); opacity: 0; } }
  @media (min-width: 600px) { .fab { display: inline-flex; } }

  .abar { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-fab); display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding-bottom: env(safe-area-inset-bottom); background: rgba(6, 13, 31, 0.86); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-top: 1px solid rgba(255, 255, 255, 0.08); transform: translateY(110%); transition: transform 0.5s var(--ease-out); }
  .abar.is-shown { transform: none; }
  .abar__btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: var(--bar-h); font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: #fff; }
  .abar__btn svg { color: var(--glow); }
  .abar__btn--wa { color: #062a16; background: var(--wa); }
  .abar__btn--wa svg { color: #062a16; }
  @media (min-width: 600px) { .abar { display: none; } }
  @media (max-width: 599px) { :global(body) { padding-bottom: 0; } }
</style>
