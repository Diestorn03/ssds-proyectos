---
import Logo from './Logo.astro';
import { nav, wa } from '../../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="header" data-header>
  <div class="header__bar container">
    <a class="header__brand" href={`${base}/`} aria-label="SSD&S C.A. — inicio" data-magnetic="0.2">
      <Logo size={38} />
    </a>

    <nav class="header__nav" id="nav" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={`${base}${item.href}`} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary btn--sm header__cta" href={wa()} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3c.2-.6.2-1.1.2-1.2l-.5-.4Z"/></svg>
        Cotizar por WhatsApp
      </a>
    </nav>

    <button class="header__toggle" type="button" aria-controls="nav" aria-expanded="false" aria-label="Abrir menú">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header { position: fixed; inset: 0 0 auto 0; z-index: 100; height: var(--header-h); color: var(--white); transition: background-color 0.4s, box-shadow 0.4s, backdrop-filter 0.4s; }
  .header::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6, 13, 31, 0.85), rgba(6, 13, 31, 0)); opacity: 1; transition: opacity 0.4s; pointer-events: none; }
  .header.is-scrolled { background: rgba(6, 13, 31, 0.72); backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06); }
  .header.is-scrolled::before { opacity: 0; }
  .header__bar { position: relative; display: flex; align-items: center; justify-content: space-between; height: 100%; }
  .header__brand { display: inline-flex; }
  .header__nav ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .header__nav li a { position: relative; display: inline-block; padding: 10px 14px; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em; color: rgba(255, 255, 255, 0.82); transition: color 0.3s; }
  .header__nav li a::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: 6px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--orange-500), var(--glow)); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease-out); }
  .header__nav li a:hover, .header__nav li a[aria-current='page'] { color: #fff; }
  .header__nav li a:hover::after, .header__nav li a[aria-current='page']::after { transform: scaleX(1); }
  .header__toggle { display: none; }

  @media (min-width: 900px) {
    .header__nav { display: flex; align-items: center; gap: 18px; }
  }
  @media (max-width: 899px) {
    .header__toggle { position: relative; z-index: 3; display: grid; place-items: center; gap: 6px; width: 46px; height: 46px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.05); }
    .header__toggle span { width: 20px; height: 2px; background: #fff; border-radius: 2px; transition: transform 0.4s var(--ease-out), opacity 0.3s; display: block; }
    .header__toggle[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
    .header__toggle[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }
    .header__nav { position: fixed; inset: 0; z-index: 2; display: flex; flex-direction: column; justify-content: center; gap: 28px; padding: calc(var(--header-h) + 24px) var(--gutter) 40px; background: linear-gradient(160deg, var(--navy-950), var(--navy-800)); opacity: 0; visibility: hidden; transform: translateY(-12px); transition: opacity 0.4s, visibility 0.4s, transform 0.5s var(--ease-out); }
    .header__nav.is-open { opacity: 1; visibility: visible; transform: none; }
    .header__nav ul { flex-direction: column; gap: 4px; }
    .header__nav li a { font-size: var(--step-3); padding: 8px 0; color: #fff; }
    .header__nav li a::after { display: none; }
    .header__cta { align-self: flex-start; min-height: 52px; font-size: var(--step-0); padding: 0 24px; }
  }
</style>

<script>
  function initMenu() {
    const btn = document.querySelector('.header__toggle') as HTMLButtonElement | null;
    const nav = document.getElementById('nav');
    if (!btn || !nav) return;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      nav.classList.toggle('is-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>
