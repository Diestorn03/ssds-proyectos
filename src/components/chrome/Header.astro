---
/**
 * Header: fixed, glass once scrolled, hides on scroll down / shows on scroll up, takes the theme (dark|light) of the
 * section under it (chrome.js). Persists across client-side navigations. Mobile menu = <dialog> that opens as a
 * circle from the burger (--mx/--my), closes on Esc, backdrop click, link click or ≥900px.
 */
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { nav, wa, contact, social } from '../../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const items = [{ href: '/', label: 'Inicio', nav: 'home' }, ...nav.map((n) => ({ ...n, nav: n.href.replace(/\//g, '') }))];
---
<header class="hdr" data-header data-theme="dark" transition:persist transition:name="site-header">
  <div class="hdr__bar container">
    <a class="hdr__brand" href={`${base}/`} aria-label="SSD&S C.A. — inicio" data-magnetic="0.2">
      <Logo size={38} />
    </a>

    <nav class="hdr__nav" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li><a href={`${base}${item.href}`} data-nav={item.href.replace(/\//g, '')} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="btn btn--primary btn--sm hdr__cta" href={wa()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />Cotizar por WhatsApp</a>
      <button class="hdr__burger" type="button" data-menu-open aria-controls="ssds-menu" aria-expanded="false" aria-label="Abrir menú">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <dialog id="ssds-menu" class="menu" aria-label="Menú">
    <div class="menu__panel">
      <button class="menu__close" type="button" data-menu-close aria-label="Cerrar menú"><Icon name="close" size={22} /></button>
      <ul class="menu__list">
        {items.map((item, i) => (
          <li style={`--i:${i}`}><a href={`${base}${item.href}`} data-nav={item.nav}><span class="mono">0{i + 1}</span>{item.label}</a></li>
        ))}
        <li style={`--i:${items.length}`}><a href={`${base}/diagnostico/`} data-nav="diagnostico"><span class="mono">0{items.length + 1}</span>Diagnóstico rápido</a></li>
      </ul>
      <div class="menu__foot">
        <a class="btn btn--wa" href={wa()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />Cotizar por WhatsApp</a>
        <a class="menu__line" href={`tel:${contact.phoneE164}`}><Icon name="phone" size={16} />{contact.phoneDisplay}</a>
        <a class="menu__line" href={social.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={16} />@{contact.instagram}</a>
      </div>
      <span class="streak" style="top: 22%; --angle: -14deg; --streak-opacity: .6" aria-hidden="true"></span>
    </div>
  </dialog>
</header>

<script>
  import '../../scripts/chrome.js';
</script>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: var(--z-header); height: var(--header-h); color: #fff; transition: transform 0.55s var(--ease-out), background-color 0.4s, box-shadow 0.4s, color 0.3s; }
  .hdr::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6, 13, 31, 0.85), rgba(6, 13, 31, 0)); opacity: 1; transition: opacity 0.4s; pointer-events: none; }
  .hdr.is-scrolled { background: rgba(6, 13, 31, 0.72); -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06); }
  .hdr.is-scrolled::before { opacity: 0; }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr.is-hidden:focus-within { transform: none; } /* keyboard focus never lands on an off-screen header link */
  :global(html.menu-open) .hdr { transform: none; }
  /* over a light section the header turns to ink (tokens cascade into the logo) */
  .hdr[data-theme='light'] { color: var(--ink); --fg: var(--ink); --muted: var(--ink-2); --logo-b: var(--ink); }
  .hdr[data-theme='light']::before { opacity: 0; }
  .hdr[data-theme='light'].is-scrolled { background: rgba(244, 246, 251, 0.82); box-shadow: 0 1px 0 rgba(11, 26, 58, 0.08); }

  .hdr__bar { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 100%; }
  .hdr__brand { display: inline-flex; align-items: center; min-height: 44px; }
  .hdr__nav ul { display: none; gap: 6px; list-style: none; }
  .hdr__nav li a { position: relative; display: inline-block; padding: 10px 14px; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em; color: currentColor; opacity: 0.82; transition: opacity 0.3s; }
  .hdr__nav li a::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: 6px; height: 2px; border-radius: 2px; background: var(--grad-brand); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease-out); }
  .hdr__nav li a:hover, .hdr__nav li a[aria-current='page'] { opacity: 1; }
  .hdr__nav li a:hover::after, .hdr__nav li a[aria-current='page']::after { transform: scaleX(1); }
  .hdr__actions { display: flex; align-items: center; gap: 10px; }
  .hdr__cta { display: none; }
  .hdr__burger { position: relative; display: grid; place-items: center; gap: 6px; width: 46px; height: 46px; border-radius: 12px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); background: color-mix(in srgb, currentColor 6%, transparent); }
  .hdr__burger span { width: 20px; height: 2px; background: currentColor; border-radius: 2px; display: block; }
  @media (min-width: 600px) { .hdr__cta { display: inline-flex; } }
  @media (min-width: 900px) {
    .hdr__nav ul { display: flex; }
    .hdr__burger { display: none; }
  }

  /* ---------- mobile menu: full-screen dialog opening as a circle from the burger ---------- */
  .menu { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: linear-gradient(160deg, var(--navy-950), var(--navy-800)); color: #fff; overflow: hidden; clip-path: circle(0 at var(--mx, 90%) var(--my, 32px)); transition: clip-path 0.6s var(--ease-in-out); }
  .menu.is-open { clip-path: circle(150vmax at var(--mx, 90%) var(--my, 32px)); }
  .menu::backdrop { background: transparent; }
  .menu__panel { position: relative; display: grid; align-content: center; gap: clamp(28px, 6vh, 48px); min-height: 100%; padding: calc(var(--header-h) + 24px) var(--gutter) max(32px, env(safe-area-inset-bottom)); overflow: hidden; }
  .menu__close { position: absolute; top: calc((var(--header-h) - 46px) / 2); right: var(--gutter); display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.05); }
  .menu__list { list-style: none; display: grid; gap: 4px; }
  .menu__list a { display: flex; align-items: baseline; gap: 14px; padding: 10px 0; font-family: var(--font-display); font-weight: 700; font-size: var(--step-3); letter-spacing: -0.03em; line-height: 1; opacity: 0; transform: translateY(14px); transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out); transition-delay: calc(0.18s + var(--i) * 0.06s); }
  .menu.is-open .menu__list a { opacity: 1; transform: none; }
  .menu__list a[aria-current='page'] { color: var(--glow); }
  .menu__list .mono { font-size: 0.72rem; color: var(--accent); }
  .menu__foot { display: grid; gap: 4px; justify-items: start; padding-top: 24px; border-top: 1px solid var(--line); }
  .menu__line { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--muted); font-family: var(--font-mono); font-size: 0.85rem; }
  .menu__line svg { color: var(--accent); }
</style>
